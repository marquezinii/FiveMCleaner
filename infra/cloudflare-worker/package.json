{
  "name": "fivemcleaner-telemetry-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FiveMCleaner anonymous telemetry + admin dashboard API Cloudflare Worker (D1-backed). Deployed at https://fivemcleaner-telemetry.felipemarquesini10.workers.dev.",
  "scripts": {
    "test": "node --test test/*.test.js test/auth/*.test.js test/stats/*.test.js",
    "hash-admin-password": "node scripts/hash-admin-password.mjs",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 execute fivemcleaner-telemetry --local --file=./schema.sql",
    "deploy": "wrangler deploy",
    "deploy:development": "wrangler deploy --env development",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
