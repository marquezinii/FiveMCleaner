{
  "name": "fivemcleaner-telemetry-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FiveMCleaner anonymous telemetry + admin dashboard API Cloudflare Worker (D1-backed). Deployed at https://fivemcleaner-telemetry.felipemarquesini10.workers.dev.",
  "scripts": {
    "test": "node --test",
    "hash-admin-password": "node scripts/hash-admin-password.mjs",
    "dev": "wrangler dev",
    "db:bootstrap:local": "wrangler d1 execute fivemcleaner-telemetry --local --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply fivemcleaner-telemetry --local",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.121.0"
  }
}
