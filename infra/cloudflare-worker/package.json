{
  "name": "ralven-telemetry-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "description": "Ralven anonymous telemetry + admin dashboard API Cloudflare Worker (D1-backed).",
  "scripts": {
    "test": "node --test",
    "hash-admin-password": "node scripts/hash-admin-password.mjs",
    "dev": "wrangler dev",
    "db:bootstrap:local": "wrangler d1 migrations apply fivemcleaner-telemetry --local",
    "db:migrate:local": "wrangler d1 migrations apply fivemcleaner-telemetry --local",
    "test:migrations": "node --test test/migrations.test.js",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260826.1": true
  }
}
