<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FiveMCleaner.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FiveMCleaner.ico</ApplicationIcon>
    <!--
      ApplicationHighDpiMode (a alternativa sugerida pelo aviso WFO0003) não
      tem efeito aqui: ela só é aplicada pelo Program.Main gerado pelo
      designer do WinForms (ApplicationConfiguration.Initialize()), e este
      projeto usa WinForms só para a bandeja do sistema — quem inicia é o
      App.xaml do WPF. A leitura efetiva de DPI da janela principal vem do
      HwndSource do WPF, que só respeita o dpiAwareness declarado no
      manifesto abaixo. Suprimido intencionalmente, não ignorado por engano.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>FiveMCleaner</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="Sentry" Version="6.8.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="../FiveMCleaner.Contracts/FiveMCleaner.Contracts.csproj" />
    <ProjectReference Include="../FiveMCleaner.Core/FiveMCleaner.Core.csproj" />
    <ProjectReference Include="../FiveMCleaner.Windows/FiveMCleaner.Windows.csproj" />
    <ProjectReference Include="../FiveMCleaner.UpdateRuntime/FiveMCleaner.UpdateRuntime.csproj" />
    <ProjectReference Include="../FiveMCleaner.Broker/FiveMCleaner.Broker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/FiveMCleaner.png" />
    <EmbeddedResource Include="Assets/release-public-key.pem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Config/appsettings.json;Config/appsettings.Development.json;Config/appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Machine-local, git-ignored overlay (see RemoteServicesOptionsLoader) for
      values GitHub's push protection would otherwise reject in a commit, like
      the Google OAuth client secret. The glob matches nothing on a normal
      checkout, so it never fails the build when absent.
    -->
    <Content Include="Config/appsettings.*.local.json" Condition="Exists('Config')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyBroker" AfterTargets="Build">
    <ItemGroup>
      <BrokerFiles Include="$(MSBuildThisFileDirectory)..\FiveMCleaner.Broker\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerFiles)" DestinationFiles="@(BrokerFiles->'$(OutDir)broker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
