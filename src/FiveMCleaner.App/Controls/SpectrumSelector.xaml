<UserControl x:Class="FiveMCleaner.App.Controls.SpectrumSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420">
    <UserControl.Resources>
        <Style x:Key="SpectrumOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Option0Button" Grid.Column="0" Style="{StaticResource SpectrumOptionButtonStyle}" Click="OnOptionClick">
                <TextBlock x:Name="Option0Text" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
            </Button>
            <Button x:Name="Option1Button" Grid.Column="1" Style="{StaticResource SpectrumOptionButtonStyle}" Click="OnOptionClick">
                <TextBlock x:Name="Option1Text" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
            </Button>
            <Button x:Name="Option2Button" Grid.Column="2" Style="{StaticResource SpectrumOptionButtonStyle}" Click="OnOptionClick">
                <TextBlock x:Name="Option2Text" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
            </Button>
        </Grid>

        <Grid x:Name="TrackHost" Grid.Row="1" Height="24" SizeChanged="OnTrackHostSizeChanged"
              Focusable="True" Cursor="Hand"
              MouseLeftButtonDown="OnTrackClick"
              MouseEnter="OnTrackMouseEnter" MouseLeave="OnTrackMouseLeave"
              GotKeyboardFocus="OnTrackGotFocus" LostKeyboardFocus="OnTrackLostFocus"
              KeyDown="OnTrackKeyDown">
            <Border Height="4" CornerRadius="{StaticResource RadiusPill}" Background="{DynamicResource CanvasSunkenBrush}" VerticalAlignment="Center" />

            <Grid IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource BorderStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="ThumbFocusRing"
                    Width="30" Height="30"
                    CornerRadius="{StaticResource RadiusPill}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    Opacity="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="-15,0,0,0"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbFocusRingTransform" X="0" />
                </Border.RenderTransform>
            </Border>

            <Border x:Name="Thumb"
                    Width="18" Height="18"
                    CornerRadius="{StaticResource RadiusPill}"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource EdgeLightBrush}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="-9,0,0,0"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Recommended0" Grid.Column="0" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                <Rectangle Width="8" Height="2" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RecommendedText0" Style="{StaticResource OverlineText}" Foreground="{DynamicResource AccentTextBrush}" />
            </StackPanel>
            <StackPanel x:Name="Recommended1" Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                <Rectangle Width="8" Height="2" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RecommendedText1" Style="{StaticResource OverlineText}" Foreground="{DynamicResource AccentTextBrush}" />
            </StackPanel>
            <StackPanel x:Name="Recommended2" Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                <Rectangle Width="8" Height="2" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RecommendedText2" Style="{StaticResource OverlineText}" Foreground="{DynamicResource AccentTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
