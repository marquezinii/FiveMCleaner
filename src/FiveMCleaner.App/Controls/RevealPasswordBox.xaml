<UserControl x:Class="FiveMCleaner.App.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <!--
        WPF não expõe nenhuma forma de ler o texto de um PasswordBox em claro
        sem trocar o controle: por isso este campo mantém um PasswordBox e um
        TextBox irmãos e alterna qual deles está visível. Só um dos dois está
        na árvore visual por vez, então nunca há dois cursores nem dois alvos
        de foco competindo.
    -->
    <UserControl.Resources>
        <!--
            Sem isto, PasswordBox/TextBox herdam o estilo implícito global de
            ui:ControlsDictionary (App.xaml), que desenha um sublinhado no
            rodapé ao focar — diferente de todo o resto do formulário, que
            usa FormTextBoxStyle com um Border próprio ("flutuando"). Um
            estilo implícito aqui, escopado só a este UserControl, vence a
            busca de recurso do WPF por estar mais perto na árvore, e troca o
            ControlTemplate inteiro por um sem nenhum verniz próprio — quem
            desenha borda e fundo é o Border FieldRoot logo abaixo.
        -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="{TemplateBinding Background}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="{TemplateBinding Background}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="FieldRoot" MinHeight="42">
        <!--
            Background/BorderBrush ficam no Style, e não como atributos: um
            valor local venceria o gatilho de foco e a borda nunca acenderia
            em laranja.
        -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PlaceholderText"
                       Margin="13,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       Text="{Binding Placeholder, ElementName=Root}" />

            <PasswordBox x:Name="Masked"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="12.5"
                         Foreground="{DynamicResource TextBrush}"
                         CaretBrush="{DynamicResource OrangeBrush}"
                         SelectionBrush="{DynamicResource OrangeBrush}"
                         PasswordChanged="Masked_PasswordChanged" />

            <TextBox x:Name="Revealed"
                     Visibility="Collapsed"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="12.5"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource OrangeBrush}"
                     SelectionBrush="{DynamicResource OrangeBrush}"
                     TextChanged="Revealed_TextChanged" />

            <ToggleButton x:Name="RevealToggle"
                          Grid.Column="1"
                          Width="38"
                          Height="38"
                          Margin="0,0,2,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Focusable="True"
                          IsTabStop="True"
                          Checked="RevealToggle_Changed"
                          Unchecked="RevealToggle_Changed"
                          AutomationProperties.Name="Mostrar ou ocultar a senha"
                          ToolTip="Mostrar a senha">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverSurface"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="7"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HoverSurface" Property="BorderBrush" Value="{DynamicResource OrangeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <Path x:Name="RevealIcon"
                      Style="{StaticResource VectorIconStyle}"
                      Data="{StaticResource IconEye}" />
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
