<ui:FluentWindow x:Class="FiveMCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
        mc:Ignorable="d"
        Title="FiveMCleaner"
        Icon="Assets/FiveMCleaner.png"
        Width="1160"
        Height="680"
        MinWidth="960"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}">

    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="ActionTemplate">
            <ui:CardControl Margin="0,0,0,9" Padding="14">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#20FF7A18" VerticalAlignment="Top">
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource OrangeLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Padding="7,3" Background="{DynamicResource ChipBrush}" CornerRadius="6">
                                    <TextBlock Text="{Binding RiskLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                                <Border Margin="6,0,0,0" Padding="7,3" Background="{DynamicResource ChipBrush}" CornerRadius="6">
                                    <TextBlock Text="{Binding PrivilegeLabel}" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" VerticalAlignment="Center" />
                <Ellipse Grid.Column="1" Width="5" Height="5" Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StepLedgerTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="1" Padding="7,2" Background="{DynamicResource ChipBrush}" CornerRadius="6" Margin="8,0,0,0">
                    <TextBlock Text="{Binding OutcomeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReportLineTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ActionName}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Reason}" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Visibility="{Binding Reason, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="7,2" Background="{DynamicResource ChipBrush}" CornerRadius="6" Margin="8,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding OutcomeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryTemplate">
            <ui:CardControl Margin="0,0,0,10" Padding="17">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#1C37C889" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GreenBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5">
                                <Run Text="{Binding DateLabel, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <Button Content="{Binding [History.Undo], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="16,0" Tag="{Binding}" Click="RollbackHistory_Click" IsEnabled="{Binding CanRollback}" />
            </ui:CardControl>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Height="54" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/FiveMCleaner.png" Width="32" Height="32" Stretch="Uniform" />
                        <TextBlock Margin="10,0,0,0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="FiveM" /><Run Text="Cleaner" Foreground="{DynamicResource OrangeBrush}" />
                        </TextBlock>
                        <Border Margin="12,0,0,0" MinHeight="26" Padding="9,0" Background="{DynamicResource ChipBrush}" CornerRadius="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditionBadgeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DiscordButton"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            Click="Discord_Click"
                            ToolTip="{Binding [Discord.TitleBarTooltip], Source={StaticResource LocalizedStrings}}"
                            AutomationProperties.Name="{Binding [Discord.TitleBarTooltip], Source={StaticResource LocalizedStrings}}">
                        <Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconDiscord}" Fill="{DynamicResource TextBrush}" />
                    </Button>
                    <Button x:Name="AccountButton" Padding="10,0" MinHeight="40" VerticalAlignment="Center" Click="Account_Click" ToolTip="Entrar ou criar conta" AutomationProperties.Name="Entrar ou cadastrar-se" Background="Transparent" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="8" />
                                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ChipBrush}" />
                                                    <Setter TargetName="HoverSurface" Property="Opacity" Value="0.82" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OrangeLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ChipBrush}" />
                                                    <Setter TargetName="HoverSurface" Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OrangeLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HoverSurface" Property="BorderBrush" Value="{DynamicResource OrangeLightBrush}" />
                                                    <Setter TargetName="HoverSurface" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="25" Height="25" CornerRadius="13" Background="{DynamicResource ChipBrush}" Margin="0,0,7,0">
                                <Grid>
                                    <TextBlock x:Name="AccountInitials" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}" />
                                    <!-- Substitui as iniciais quando há uma foto de perfil salva; ver AccountAvatarStore. -->
                                    <Ellipse x:Name="AccountAvatarEllipse" Width="25" Height="25" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AccountLabel" Text="Entrar / Cadastre-se" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <ui:NavigationView x:Name="RootNavigationView"
                                Grid.Row="1"
                                IsBackButtonVisible="Collapsed"
                                PaneDisplayMode="Left"
                                OpenPaneLength="210"
                                CompactPaneLength="52"
                                Background="{DynamicResource SidebarBrush}">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="DashboardNav" Content="{Binding [Navigation.Overview], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Home24}" Tag="Dashboard" Click="NavItem_Click" />
                    <ui:NavigationViewItem x:Name="OptimizerNav" Content="{Binding [Navigation.Optimizer], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon FlashSettings24}" Tag="Optimizer" Click="NavItem_Click" />
                    <ui:NavigationViewItem x:Name="HistoryNav" Content="{Binding [Navigation.History], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon History24}" Tag="History" Click="NavItem_Click" />
                    <ui:NavigationViewItem x:Name="SettingsNav" Content="{Binding [Navigation.Settings], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Settings24}" Tag="Settings" Click="NavItem_Click" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem IsEnabled="False"
                                           Icon="{ui:SymbolIcon Shield24}"
                                           ToolTip="{Binding [Safety.SnapshotRollback], Source={StaticResource LocalizedStrings}}">
                        <ui:NavigationViewItem.Content>
                            <StackPanel Margin="0,4,0,4" Visibility="{Binding IsPaneOpen, ElementName=RootNavigationView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding [Safety.Active], Source={StaticResource LocalizedStrings}}" FontSize="11.5" FontWeight="SemiBold" />
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding [Sidebar.Version], Source={StaticResource LocalizedStrings}}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               FontFamily="Segoe UI Variable Text"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="Segoe UI Variable Text"
                                               FontSize="9.5"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </ui:NavigationViewItem.Content>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>

                <ui:NavigationView.ContentOverlay>
                <Grid Margin="26,22,0,24">
                    <!-- Dashboard -->
                    <ScrollViewer x:Name="DashboardPage" Padding="0,0,26,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!--
                                Cabeçalho: identidade da página à esquerda e, à direita, a
                                única ação de manutenção da Visão geral (varrer de novo),
                                acompanhada do horário da última varredura para que o número
                                exibido tenha uma idade explícita.
                            -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{Binding GreetingTitle}" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding [Dashboard.Title], Source={StaticResource LocalizedStrings}}" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="31" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Rectangle Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource OrangeGradientBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [Dashboard.Eyebrow], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource OrangeLightBrush}" />
                                        <Ellipse Width="3" Height="3" Margin="9,0,0,0" Fill="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastScanLabel}" Style="{StaticResource CaptionStyle}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="38" Padding="15,0" Click="RefreshDiagnostic_Click" IsEnabled="{Binding CanRefresh}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding [Dashboard.Refresh], Source={StaticResource LocalizedStrings}}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Margin="0,0,0,16"
                                    Padding="16,14"
                                    Background="#16FF7A18"
                                    BorderBrush="#56FF7A18"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconPillStyle}" Background="#25FF7A18">
                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource OrangeLightBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,18,0">
                                        <TextBlock Text="{Binding UpdateBannerTitle}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UpdateBannerDetail}" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="{Binding UpdateActionLabel}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="36"
                                                MinWidth="132"
                                                Padding="15,0"
                                                IsEnabled="{Binding CanDownloadUpdate}"
                                                ToolTip="{Binding [Update.BlockedWhileBusy], Source={StaticResource LocalizedStrings}}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="DownloadUpdate_Click" />
                                        <Button Content="{Binding UpdateReleaseNotesLabel}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                FontSize="10.5"
                                                Padding="4,7,4,0"
                                                HorizontalAlignment="Center"
                                                IsEnabled="{Binding CanOpenReleaseNotes}"
                                                Click="OpenReleaseNotes_Click" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Opacity="0.72"
                                            ToolTip="{Binding [Window.Close], Source={StaticResource LocalizedStrings}}"
                                            Visibility="{Binding IsUpdateCompletedBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="DismissCompletedUpdate_Click">
                                        <Path Width="10" Height="10" Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMutedBrush}" />
                                    </Button>
                                    <ProgressBar Grid.Row="1"
                                                 Grid.Column="1"
                                                 Grid.ColumnSpan="2"
                                                 Height="3"
                                                 Margin="7,10,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <!--
                                Bloco principal: o que foi detectado e a recomendação à
                                esquerda, medidor de prontidão à direita. As duas ações
                                daqui apenas navegam — a Visão geral nunca executa uma
                                otimização por conta própria.
                            -->
                            <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,14">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="22" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding [Dashboard.Detection.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,9" />
                                        <WrapPanel>
                                            <Border Margin="0,0,8,8">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2D5E4C" />
                                                                <Setter Property="Background" Value="#15231C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path>
                                                        <Path.Style>
                                                            <Style TargetType="Path" BasedOn="{StaticResource VectorIconSmallStyle}">
                                                                <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource RedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                                        <Setter Property="Stroke" Value="#5BCF98" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding EditionLabel}" Margin="8,0,2,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,8,8">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2D5E4C" />
                                                                <Setter Property="Background" Value="#15231C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path>
                                                        <Path.Style>
                                                            <Style TargetType="Path" BasedOn="{StaticResource VectorIconSmallStyle}">
                                                                <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource RedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                                        <Setter Property="Stroke" Value="#5BCF98" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding GtaStatusLabel}" Margin="8,0,2,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding RecommendationTitle}" Margin="0,12,0,0" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RecommendationText}" Margin="0,9,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" LineHeight="19" />
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="22,0" Click="OpenOptimizer_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconBolt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="{Binding [Dashboard.OpenOptimizer], Source={StaticResource LocalizedStrings}}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="18,0" Margin="9,0,0,0" Click="OpenHistory_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Column="1" Width="196" Height="196" Margin="30,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ReadinessScoreExplanation}">
                                        <controls:HoloCore3D Width="196" Height="196" IsLive="{Binding IsLiveMetricsActive}" />
                                        <Ellipse Width="192" Height="192" Style="{StaticResource OrbitRingStyle}">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <controls:ArcProgress Width="166"
                                                              Height="166"
                                                              Value="{Binding ReadinessScore, Mode=OneWay}"
                                                              Maximum="100"
                                                              StrokeThickness="7"
                                                              StartAngle="0"
                                                              SweepAngle="360"
                                                              TrackBrush="{DynamicResource RingBrush}"
                                                              ProgressBrush="{DynamicResource OrangeGradientBrush}" />
                                        <Border Width="118" Height="118" CornerRadius="59" Background="#E60E1014" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!--
                                                    Pontuação e escala vivem em um único TextBlock: como
                                                    dois blocos irmãos dentro do núcleo de largura fixa,
                                                    o número era medido curto e perdia o último dígito
                                                    em escalas fracionárias de DPI (97 aparecia como 9).
                                                -->
                                                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextOptions.TextFormattingMode="Ideal">
                                                    <Run Text="{Binding ReadinessScore, Mode=OneWay}" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource OrangeLightBrush}" /><Run Text=" /100" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" BaselineAlignment="TextTop" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="0,1,0,0" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding ReadinessLevelLabel}" Margin="0,5,0,0" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--
                                Faixa de indicadores: quatro números que explicam a
                                recomendação acima e continuam legíveis sem rolar a página.
                                Todos vêm da varredura local; nenhum é estimado.
                            -->
                            <primitives:UniformGrid Columns="4" Margin="0,0,0,14">
                                <Border Style="{StaticResource KpiTileStyle}" Margin="0,0,7,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconPillStyle}" Background="#1AFF7A18">
                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPulse}" Stroke="{Binding PerformancePressureBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding [Dashboard.Kpi.Pressure.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding PerformancePressureLabel}" Style="{StaticResource KpiValueStyle}" Margin="0,3,0,0" Foreground="{Binding PerformancePressureBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                                            <TextBlock Text="{Binding [Dashboard.Readiness.LocalAnalysis], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource KpiTileStyle}" Margin="7,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconPillStyle}" Background="#1A62A8FF">
                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconCores}" Stroke="{DynamicResource BlueBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding [Dashboard.Kpi.Cores.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding LogicalProcessorLabel}" Style="{StaticResource KpiValueStyle}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding LogicalProcessorDetail}" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource KpiTileStyle}" Margin="7,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconPillStyle}" Background="#1A37C889">
                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconMemory}" Stroke="{DynamicResource GreenBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding [Dashboard.Kpi.Memory.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding AvailableMemoryLabel}" Style="{StaticResource KpiValueStyle}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding AvailableMemoryDetail}" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource KpiTileStyle}" Margin="7,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconPillStyle}" Background="#1AEAB64D">
                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconBroom}" Stroke="{DynamicResource YellowBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding [Dashboard.Kpi.Cache.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding LegacyCacheLabel}" Style="{StaticResource KpiValueStyle}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding LegacyCacheDetail}" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </primitives:UniformGrid>

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>

                                    <!-- Desempenho ao vivo: cinco leituras instantâneas e o histórico do último minuto. -->
                                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" VerticalAlignment="Stretch">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="22" />
                                        </Border.RenderTransform>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Title], Source={StaticResource LocalizedStrings}}" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
                                                    <Border Padding="9,5" Background="#1537C889" BorderBrush="#3A37C889" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource LivePulseStyle}" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Live], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding LiveMetricsUpdatedLabel}" Margin="0,6,0,0" FontSize="8.5" Foreground="{DynamicResource TextSubtleBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel>
                                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                            <controls:ArcProgress Value="{Binding CpuUsagePercent, Mode=OneWay}" StartAngle="140" SweepAngle="280" StrokeThickness="5" TrackBrush="{DynamicResource StrongBorderBrush}" ProgressBrush="{DynamicResource OrangeBrush}" />
                                                            <TextBlock Text="{Binding CpuUsageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                                            <Path Style="{StaticResource VectorIconCaptionStyle}" Data="{StaticResource IconCpu}" Stroke="{DynamicResource OrangeBrush}" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel>
                                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                            <controls:ArcProgress Value="{Binding GpuUsagePercent, Mode=OneWay}" StartAngle="140" SweepAngle="280" StrokeThickness="5" TrackBrush="{DynamicResource StrongBorderBrush}" ProgressBrush="{DynamicResource BlueBrush}" />
                                                            <TextBlock Text="{Binding GpuUsageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                                            <Path Style="{StaticResource VectorIconCaptionStyle}" Data="{StaticResource IconGpu}" Stroke="{DynamicResource BlueBrush}" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="4" Style="{StaticResource MetricTileStyle}" ToolTip="{Binding MemoryUsageDetailLabel}">
                                                    <StackPanel>
                                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                            <controls:ArcProgress Value="{Binding MemoryUsagePercent, Mode=OneWay}" StartAngle="140" SweepAngle="280" StrokeThickness="5" TrackBrush="{DynamicResource StrongBorderBrush}" ProgressBrush="{DynamicResource GreenBrush}" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MemoryUsageLabel}" HorizontalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding MemoryUsageDetailLabel}" HorizontalAlignment="Center" Margin="0,1,0,0" FontSize="8" Foreground="{DynamicResource TextSubtleBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                                            <Path Style="{StaticResource VectorIconCaptionStyle}" Data="{StaticResource IconMemory}" Stroke="{DynamicResource GreenBrush}" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="6" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel>
                                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                            <controls:ArcProgress Value="{Binding DiskUsagePercent, Mode=OneWay}" StartAngle="140" SweepAngle="280" StrokeThickness="5" TrackBrush="{DynamicResource StrongBorderBrush}" ProgressBrush="{DynamicResource YellowBrush}" />
                                                            <TextBlock Text="{Binding DiskUsageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                                            <Path Style="{StaticResource VectorIconCaptionStyle}" Data="{StaticResource IconDisk}" Stroke="{DynamicResource YellowBrush}" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Disk], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="8" Style="{StaticResource MetricTileStyle}">
                                                    <StackPanel>
                                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                            <Ellipse Stroke="{DynamicResource StrongBorderBrush}" StrokeThickness="1" StrokeDashArray="1 4" Width="76" Height="76" />
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Path Style="{StaticResource VectorIconLargeStyle}" Data="{StaticResource IconNetwork}" Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding NetworkUsageLabel}" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                                            <Path Style="{StaticResource VectorIconCaptionStyle}" Data="{StaticResource IconPulse}" Stroke="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Network], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Margin="0,15,0,0" Style="{StaticResource SceneFrameStyle}">
                                                <Grid>
                                                    <controls:LivePerformanceChart Height="228"
                                                                                   Capacity="60"
                                                                                   SampleIntervalSeconds="1"
                                                                                   CpuValues="{Binding CpuUsageSeries}"
                                                                                   GpuValues="{Binding GpuUsageSeries}"
                                                                                   CpuBrush="{DynamicResource OrangeBrush}"
                                                                                   GpuBrush="{DynamicResource BlueBrush}"
                                                                                   GridBrush="{DynamicResource StrongBorderBrush}"
                                                                                   LabelBrush="{DynamicResource TextSubtleBrush}"
                                                                                   TooltipBackground="{DynamicResource SurfaceRaisedBrush}"
                                                                                   TooltipBorderBrush="{DynamicResource StrongBorderBrush}"
                                                                                   CpuLabel="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}"
                                                                                   GpuLabel="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}"
                                                                                   NowLabel="{Binding [Dashboard.LivePerformance.Now], Source={StaticResource LocalizedStrings}}"
                                                                                   AutomationProperties.Name="{Binding [Dashboard.LivePerformance.ChartDescription], Source={StaticResource LocalizedStrings}}" />
                                                    <Grid Margin="15,13" VerticalAlignment="Top" IsHitTestVisible="False">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Background="#B00A0B0E" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Margin="7,0,16,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BlueBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="1" Background="#B00A0B0E" CornerRadius="8" Padding="10,6">
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Window], Source={StaticResource LocalizedStrings}}" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!--
                                                Média e pico das mesmas amostras desenhadas acima:
                                                a linha responde "esteve alto?" sem depender de o
                                                usuário ter olhado o gráfico no momento certo.
                                            -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Trend], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Border Style="{StaticResource ChipBadgeStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CpuTrendLabel}" Margin="7,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource ChipBadgeStyle}" Margin="8,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource BlueBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding GpuTrendLabel}" Margin="7,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Resumo do computador. -->
                                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" VerticalAlignment="Stretch">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="22" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding [Dashboard.SystemOverview], Source={StaticResource LocalizedStrings}}" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Text="{Binding [Dashboard.SystemOverview.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconPillStyle}" Width="27" Height="27" Background="#1AFF7A18">
                                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconCpu}" Stroke="{DynamicResource OrangeLightBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding [Dashboard.Processor], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                                        <TextBlock Text="{Binding CpuName}" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconPillStyle}" Width="27" Height="27" Background="#1A62A8FF">
                                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconGpu}" Stroke="{DynamicResource BlueBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding [Dashboard.GraphicsCard], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                                        <TextBlock Text="{Binding GpuDetail}" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconPillStyle}" Width="27" Height="27" Background="#1A37C889">
                                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconMemory}" Stroke="{DynamicResource GreenBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding [Dashboard.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                                        <TextBlock Text="{Binding RamLabel}" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconPillStyle}" Width="27" Height="27" Background="#1AEAB64D">
                                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconDisk}" Stroke="{DynamicResource YellowBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding [Dashboard.Storage], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                                        <TextBlock Text="{Binding DiskLabel}" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconPillStyle}" Width="27" Height="27">
                                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconMonitor}" Stroke="{DynamicResource TextMutedBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding [Dashboard.Windows], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" />
                                                        <TextBlock Text="{Binding WindowsLabel}" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding WindowsLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                                <Border Margin="0,20,0,0" Padding="14" Background="{DynamicResource TileSurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="11">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Style="{StaticResource VectorIconCaptionStyle}" Data="{StaticResource IconGauge}" Stroke="{DynamicResource OrangeLightBrush}" />
                                                            <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ReadinessLevelLabel}" Margin="8,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ReadinessScoreExplanation}" Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource TileSurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="11">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconShield}" Stroke="{DynamicResource GreenBrush}" VerticalAlignment="Top" />
                                                        <TextBlock Text="{Binding [Dashboard.LivePerformance.LocalOnly], Source={StaticResource LocalizedStrings}}" Margin="9,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="22" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource VectorIconLargeStyle}" Data="{StaticResource IconStream}" Stroke="{DynamicResource OrangeLightBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StreamingReadinessTitle}" Margin="10,0,0,0" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StreamingReadinessDetail}" Margin="0,7,0,0" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding StreamingReadinessItems}" Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,9,0" Padding="14" Style="{StaticResource KpiTileStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource IconPillStyle}" Width="28" Height="28">
                                                                <Path Style="{StaticResource VectorIconSmallStyle}" Data="{Binding IconKey, Converter={StaticResource GeometryKeyConverter}}" Stroke="{Binding ToneBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!--
                                    Última otimização: fecha a página com o estado do que já
                                    foi feito nesta máquina. Sem histórico, o cartão explica
                                    esse estado em vez de sumir e deixar um vazio no fim.
                                -->
                                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="20">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="22" />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconPillStyle}" Width="38" Height="38" CornerRadius="11" VerticalAlignment="Center">
                                            <Path Style="{StaticResource VectorIconLargeStyle}" Data="{StaticResource IconHistory}" Stroke="{DynamicResource GreenBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [Dashboard.LastRun.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LastOptimizationDateLabel}" Margin="8,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center" Visibility="{Binding LastOptimizationDateLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastOptimizationTitle}" Margin="0,4,0,0" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LastOptimizationSummary}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="38"
                                                Padding="16,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasLastOptimization, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="OpenHistory_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource VectorIconSmallStyle}" Data="{StaticResource IconTrend}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Optimizer -->
                    <Grid x:Name="OptimizerPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,26,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,22,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding [Optimizer.Title], Source={StaticResource LocalizedStrings}}" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="Bold" />
                                <TextBlock Text="{Binding [Optimizer.Subtitle], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="13.5" TextWrapping="Wrap" MaxWidth="760" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="10,5" Background="#1837C889" CornerRadius="8" Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding [Optimizer.SystemReady], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" Foreground="{DynamicResource GreenBrush}" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="10,5" Background="{DynamicResource ChipBrush}" CornerRadius="8">
                                    <TextBlock Text="{Binding [Optimizer.NoRemoteScripts], Source={StaticResource LocalizedStrings}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="0,0,26,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsOptimizerIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <ui:Card Grid.Column="0" Padding="22">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [Optimizer.Recommended], Source={StaticResource LocalizedStrings}}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OrangeLightBrush}" />
                                                        <TextBlock Text="{Binding SelectedProfileLabel}" Margin="0,7,0,0" FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="42" Height="42" Background="#20FF7A18" CornerRadius="12"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource OrangeLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding ProfilePresentationBenefits}" Margin="0,13,0,0" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                <primitives:UniformGrid Grid.Row="2" Columns="3" Margin="0,18,0,0">
                                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding SelectedActionCount}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding [Plan.VerifiedActions.Label], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" /></StackPanel>
                                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ProfilePresentationImpact}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding [Optimizer.Impact], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" /></StackPanel>
                                                    <StackPanel><TextBlock Text="{Binding ElevationLabel}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding [Optimizer.Execution], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" /></StackPanel>
                                                </primitives:UniformGrid>
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0">
                                                    <Button Content="{Binding [Plan.OptimizeNow], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="24,0" Click="StartOptimization_Click" IsEnabled="{Binding CanStart}" />
                                                    <Button Content="{Binding [Plan.Review], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="18,0" Margin="9,0,0,0" Click="ReviewPlan_Click" />
                                                    <Button Content="{Binding [Optimizer.ChangeMode], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" Margin="12,0,0,0" Click="ChangeMode_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>

                                        <ui:Card Grid.Column="2" Padding="20">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding [Optimizer.Computer], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSubtleBrush}" /></Grid>
                                                <StackPanel Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding CpuName}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                                                    <TextBlock Text="{Binding GpuDetail}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                                                    <TextBlock Text="{Binding RamLabel}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding DiskLabel}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding WindowsLabel}" Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Separator Margin="0,14" Background="{DynamicResource BorderSoftBrush}" />
                                                <WrapPanel>
                                                    <Border Margin="0,0,8,8">
                                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="BorderBrush" Value="#2D5E4C" /><Setter Property="Background" Value="#15231C" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="{Binding EditionLabel}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                    <Border Margin="0,0,0,8">
                                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="BorderBrush" Value="#2D5E4C" /><Setter Property="Background" Value="#15231C" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="{Binding GtaStatusLabel}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ui:Card>
                                    </Grid>

                                    <StackPanel x:Name="ProfileSelectorSection" Margin="0,18,0,0">
                                        <TextBlock Text="{Binding [Profiles.Choose], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0" GroupName="OptimizerProfile" Style="{StaticResource ModeRadioStyle}" IsChecked="{Binding IsLightSelected}" Checked="LightProfile_Checked"><StackPanel><Grid><TextBlock Text="{Binding [Profiles.Light.Name], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" /><Border Padding="8,3" Background="#24FF7A18" CornerRadius="6" HorizontalAlignment="Right" Visibility="{Binding IsLightRecommended, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" /></Border></Grid><TextBlock Text="{Binding [Profiles.Light.Description], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding LightImpactLabel}" Margin="0,10,0,0" FontSize="9.5" Foreground="{DynamicResource GreenBrush}" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                            <RadioButton Grid.Column="2" GroupName="OptimizerProfile" Style="{StaticResource ModeRadioStyle}" IsChecked="{Binding IsBalancedSelected}" Checked="BalancedProfile_Checked"><StackPanel><Grid><TextBlock Text="{Binding [Profiles.Balanced.Name], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" /><Border Padding="8,3" Background="#24FF7A18" CornerRadius="6" HorizontalAlignment="Right" Visibility="{Binding IsBalancedRecommended, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" /></Border></Grid><TextBlock Text="{Binding [Profiles.Balanced.Description], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding BalancedImpactLabel}" Margin="0,10,0,0" FontSize="9.5" Foreground="{DynamicResource OrangeLightBrush}" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                            <RadioButton Grid.Column="4" GroupName="OptimizerProfile" Style="{StaticResource ModeRadioStyle}" IsChecked="{Binding IsAggressiveSelected}" Checked="AggressiveProfile_Checked"><StackPanel><Grid><TextBlock Text="{Binding [Profiles.Aggressive.Name], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" /><Border Padding="8,3" Background="#24FF7A18" CornerRadius="6" HorizontalAlignment="Right" Visibility="{Binding IsAggressiveRecommended, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" /></Border></Grid><TextBlock Text="{Binding [Profiles.Aggressive.Description], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding AggressiveImpactLabel}" Margin="0,10,0,0" FontSize="9.5" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <ui:Card Padding="26" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [Optimizer.RunningTitle], Source={StaticResource LocalizedStrings}}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding ProgressHeadline, Mode=OneWay}" Margin="0,7,0,0" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}%}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OrangeLightBrush}" /></Grid>
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,24,0,0" Foreground="{DynamicResource OrangeBrush}" />
                                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ElapsedTimeLabel}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding RemainingTimeLabel}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                                        <TextBlock Text="{Binding PreviousProgressHeadline}" Margin="0,12,0,0" Visibility="{Binding HasPreviousProgressHeadline, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right"><Button Content="{Binding [Optimizer.ShowDetails], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="ReviewPlan_Click" /><Button Content="{Binding [Progress.CancelAfterStep], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="9,0,0,0" Click="CancelOptimization_Click" IsEnabled="{Binding CanCancel}" /></StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="24" Visibility="{Binding IsReportAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="19" Background="#2037C889"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GreenBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="{Binding [Optimizer.CompletedTitle], Source={StaticResource LocalizedStrings}}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding ReportSummaryLabel}" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                        <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource PanelBrush}" CornerRadius="10"><StackPanel><TextBlock Text="{Binding [Optimizer.NextStep], Source={StaticResource LocalizedStrings}}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding ReportRestartLabel}" Margin="0,5,0,0" FontSize="11.5" TextWrapping="Wrap" /></StackPanel></Border>
                                        <ScrollViewer MaxHeight="240" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReportLines}" ItemTemplate="{StaticResource ReportLineTemplate}" /></ScrollViewer>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Right"><Button Content="{Binding [Report.CopyButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="CopyTechnicalReport_Click" /><Button Content="{Binding [Report.SaveButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="9,0,0,0" Click="SaveTechnicalReport_Click" /></StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <Expander x:Name="PlanDetailsExpander" Margin="0,16,0,0">
                                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [Optimizer.PlanTitle], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding ProfilePresentationCategories}" Margin="0,4,20,0" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding PlanHeader}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Expander.Header>
                                    <StackPanel Margin="0,12,0,0"><Border Padding="13" Background="{DynamicResource PanelBrush}" CornerRadius="9"><StackPanel><TextBlock Text="{Binding PlanSummary}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding SafetySummary}" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" /></StackPanel></Border><ItemsControl ItemsSource="{Binding PlannedActions}" ItemTemplate="{StaticResource ActionTemplate}" Margin="0,12,0,0" /></StackPanel>
                                </Expander>

                                <Border Margin="0,13,0,0" Padding="13" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsComparisonAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel><TextBlock Text="{Binding [Comparison.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{Binding ComparisonSummaryLabel}" Margin="0,6,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding ComparisonHardwareProfileLabel}" Margin="0,4,0,0" FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSubtleBrush}" /><Button Content="{Binding [Comparison.RevertButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="RevertLastOptimization_Click" Visibility="{Binding ComparisonRegressionSuspected, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanRevertLastOptimization}" /></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- History -->
                    <Grid x:Name="HistoryPage" Margin="0,0,26,0" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding [History.Title], Source={StaticResource LocalizedStrings}}" FontSize="25" FontWeight="Bold" /><TextBlock Text="{Binding [History.Subtitle], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="{Binding [History.OpenLogs], Source={StaticResource LocalizedStrings}}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Height="38" Click="OpenLogs_Click" /></Grid>
                        <ui:Card Grid.Row="1" Padding="18">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14"><TextBlock Text="{Binding [History.LocalRuns], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" /></Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource HistoryTemplate}" /></ScrollViewer>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Padding="0,0,26,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings.Title], Source={StaticResource LocalizedStrings}}" Margin="0,0,0,18" FontSize="25" FontWeight="Bold" />

                            <!--
                                Sua conta: perfil (com foto), senha, e-mail e
                                exclusão. Vive aqui — e não mais num popup à
                                parte — para reunir tudo que é "conta" num só
                                lugar organizado, com o mesmo tratamento
                                visual do resto das Configurações.
                            -->
                            <ui:Card x:Name="AccountSettingsCard" Margin="0,0,0,13" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Sua conta" FontSize="15" FontWeight="SemiBold" />

                                    <StackPanel x:Name="AccountSettingsUnavailablePanel" Margin="0,12,0,0" Visibility="Collapsed">
                                        <TextBlock Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" Text="O acesso à conta não está disponível nesta instalação." />
                                    </StackPanel>

                                    <StackPanel x:Name="AccountSettingsSignedOutPanel" Margin="0,12,0,0">
                                        <TextBlock Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap"
                                                   Text="Entre com sua conta para sincronizar preferências entre instalações, adicionar uma foto de perfil e gerenciar sua senha e e-mail." />
                                        <Button Content="Entrar ou criar conta" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenAccountFromSettings_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="AccountSettingsSignedInPanel" Margin="0,12,0,0" Visibility="Collapsed">

                                        <!-- Foto de perfil -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource ChipBrush}">
                                                <Grid>
                                                    <TextBlock x:Name="AccountSettingsInitials" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse x:Name="AccountSettingsAvatarEllipse" Width="72" Height="72" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="ChangePhotoButton" Content="Alterar foto" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" Click="ChangePhoto_Click" />
                                                    <Button x:Name="RemovePhotoButton" Content="Remover foto" Style="{StaticResource LinkButtonStyle}" Margin="10,0,0,0" Visibility="Collapsed" Click="RemovePhoto_Click" />
                                                </StackPanel>
                                                <TextBlock Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap"
                                                           Text="Recomendado: imagem quadrada, no mínimo 256×256px (ideal 512×512px), em JPG ou PNG, até 8 MB. A foto fica salva apenas neste computador por enquanto." />
                                            </StackPanel>
                                        </Grid>

                                        <Separator Margin="0,16,0,13" Background="{DynamicResource BorderSoftBrush}" />

                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="CONECTADO COMO" />
                                        <TextBlock x:Name="AccountSettingsEmailText" Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="AccountSettingsUsernameText" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" />

                                        <Separator Margin="0,16,0,13" Background="{DynamicResource BorderSoftBrush}" />

                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="CONFIRMAÇÃO DE IDENTIDADE" />
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Margin="0,10,0,6" Text="Senha atual" />
                                        <controls:RevealPasswordBox x:Name="AccountSettingsCurrentPasswordField"
                                                                    MaxLength="128"
                                                                    Placeholder="Obrigatória para qualquer alteração abaixo"
                                                                    AutomationProperties.Name="Senha atual" />

                                        <Separator Margin="0,16,0,13" Background="{DynamicResource BorderSoftBrush}" />

                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ALTERAR SENHA" />
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Margin="0,10,0,6" Text="Nova senha" />
                                        <controls:RevealPasswordBox x:Name="AccountSettingsNewPasswordField"
                                                                    MaxLength="128"
                                                                    Placeholder="Mínimo de 12 caracteres"
                                                                    AutomationProperties.Name="Nova senha" />
                                        <Button x:Name="AccountSettingsChangePasswordButton" Margin="0,12,0,0" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Content="Salvar nova senha" Click="AccountSettingsChangePassword_Click" />

                                        <Separator Margin="0,16,0,13" Background="{DynamicResource BorderSoftBrush}" />

                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ALTERAR E-MAIL" />
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Margin="0,10,0,6" Text="Novo e-mail" />
                                        <TextBox x:Name="AccountSettingsNewEmailBox"
                                                 Style="{StaticResource AccountFieldStyle}"
                                                 MaxLength="254"
                                                 AutomationProperties.Name="Novo e-mail" />
                                        <Button x:Name="AccountSettingsChangeEmailButton" Margin="0,12,0,0" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Content="Salvar novo e-mail" Click="AccountSettingsChangeEmail_Click" />

                                        <Separator Margin="0,16,0,13" Background="{DynamicResource BorderSoftBrush}" />

                                        <TextBlock Style="{StaticResource FormHintStyle}" Margin="0,0,0,10" Text="Excluir a conta é permanente e remove seu nome de usuário, que volta a ficar disponível para outra pessoa." />
                                        <Button x:Name="AccountSettingsDeleteAccountButton" HorizontalAlignment="Left" Style="{StaticResource LinkButtonStyle}" Foreground="{DynamicResource RedBrush}" Content="Excluir minha conta" Click="AccountSettingsDeleteAccount_Click" />

                                        <Border x:Name="AccountSettingsStatusPanel"
                                                Visibility="Collapsed"
                                                Margin="0,16,0,0"
                                                Padding="13,11"
                                                CornerRadius="9"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="AccountSettingsStatusIcon" Style="{StaticResource VectorIconStyle}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0" StrokeThickness="1.8" />
                                                <TextBlock x:Name="AccountSettingsStatusText" Margin="9,0,0,0" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                                            </StackPanel>
                                        </Border>

                                        <Button x:Name="AccountSettingsLogoutButton" Margin="0,16,0,0" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Content="Sair da conta" Click="AccountSettingsLogout_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,13" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource LocalizedStrings}}" Margin="0,10,0,0" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.Language.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,6" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <ComboBox x:Name="LanguageSelector" Style="{StaticResource SettingsComboBoxStyle}" SelectedValuePath="Content" SelectionChanged="LanguageSelector_SelectionChanged">
                                        <ComboBoxItem Tag="pt-BR" Content="{Binding [Settings.Language.PortugueseBrazil], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="en" Content="{Binding [Settings.Language.English], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="es" Content="{Binding [Settings.Language.Spanish], Source={StaticResource LocalizedStrings}}" />
                                    </ComboBox>
                                    <Separator Margin="0,8" Background="{DynamicResource BorderSoftBrush}" />
                                    <TextBlock Text="{Binding [Settings.Appearance.Title], Source={StaticResource LocalizedStrings}}" Margin="0,0,0,4" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.Appearance.Description], Source={StaticResource LocalizedStrings}}" Margin="0,0,0,6" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <ComboBox x:Name="ThemeSelector" Style="{StaticResource SettingsComboBoxStyle}" SelectedValuePath="Content" SelectionChanged="ThemeSelector_SelectionChanged">
                                        <ComboBoxItem Tag="system" Content="{Binding [Settings.Appearance.System], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="dark" Content="{Binding [Settings.Appearance.Dark], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="light" Content="{Binding [Settings.Appearance.Light], Source={StaticResource LocalizedStrings}}" />
                                    </ComboBox>
                                    <Separator Margin="0,8" Background="{DynamicResource BorderSoftBrush}" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.CloseBehavior.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.CloseBehavior.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="0,13" Background="{DynamicResource BorderSoftBrush}" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LaunchAtStartup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.StartWithWindows.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.StartWithWindows.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.Privacy.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShareAnonymousTelemetry}" Margin="0,15,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.Telemetry.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="0,13" Background="{DynamicResource BorderSoftBrush}" />
                                    <TextBlock Text="{Binding [Privacy.Collects.Title], Source={StaticResource LocalizedStrings}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                    <TextBlock Text="{Binding [Privacy.Collects.Items], Source={StaticResource LocalizedStrings}}" Margin="0,4,0,11" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Title], Source={StaticResource LocalizedStrings}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}" />
                                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Items], Source={StaticResource LocalizedStrings}}" Margin="0,4,0,0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.CheckForUpdates.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.CheckForUpdates.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,13" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <Button Content="{Binding [Settings.CheckForUpdates.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="CheckForUpdatesManually_Click" IsEnabled="{Binding CanCheckForUpdatesManually}" />
                                    <TextBlock Text="{Binding ManualUpdateCheckMessage}" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Visibility="{Binding ManualUpdateCheckMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [GtaVBenchmark.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [GtaVBenchmark.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,13" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <Button Content="{Binding [GtaVBenchmark.RunButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="RunGtaVBenchmark_Click" IsEnabled="{Binding CanRunGtaVBenchmark}" />
                                    <TextBlock Text="{Binding GtaVBenchmarkStatusLabel}" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>

                            <!-- Sobre: identidade do app, versão, link do repositório e Discord oficial. -->
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.About.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.About.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,15" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="Assets/FiveMCleaner.png" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [Settings.About.AppName], Source={StaticResource LocalizedStrings}}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.About.Tagline], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AboutVersionDeveloper}" Margin="0,7,0,0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="9.5" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="{Binding [Settings.About.Repository], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" Margin="0,13,0,0" Padding="0" HorizontalAlignment="Left" Click="OpenRepository_Click" />

                                    <Separator Margin="0,15,0,13" Background="{DynamicResource BorderSoftBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconPillStyle}" Width="36" Height="36" CornerRadius="10">
                                            <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconDiscord}" Fill="{DynamicResource TextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Settings.About.Discord.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding [Settings.About.Discord.Detail], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding [Settings.About.Discord.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Height="36" Padding="15,0" Click="Discord_Click" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>

            <Border Grid.Row="2"
                    Padding="16,8"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButtonStyle}"
                            Padding="4,2"
                            Click="ReportBug_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource OrangeLightBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding [BugReport.Link], Source={StaticResource LocalizedStrings}}" FontSize="10.5" TextDecorations="Underline" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="12,0" Fill="{DynamicResource BorderSoftBrush}" />
                    <TextBlock Text="{Binding [Brand.FooterCopyright], Source={StaticResource LocalizedStrings}}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="8.5" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
    </Grid>
</ui:FluentWindow>
