<ui:FluentWindow x:Class="FiveMCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
        xmlns:pages="clr-namespace:FiveMCleaner.App.Views.Pages"
        mc:Ignorable="d"
        Title="FiveMCleaner"
        Icon="Assets/FiveMCleaner.png"
        Width="1160"
        Height="680"
        MinWidth="1100"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFontBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CanvasBaseBrush}">

    <Grid Background="{DynamicResource CanvasBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <ui:TitleBar Grid.Row="0" Height="48" Background="{DynamicResource SurfaceRailBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/FiveMCleaner.png" Width="22" Height="22" Stretch="Uniform" />
                    <TextBlock Margin="9,0,0,0" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center">
                        <Run Text="FiveM" /><Run Text="Cleaner" Foreground="{DynamicResource AccentTextBrush}" />
                    </TextBlock>
                    <Border Margin="10,0,0,0" Padding="8,3" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EditionBadgeLabel}" Style="{StaticResource OverlineText}" />
                    </Border>

                    <!-- Cluster de status global: substitui banners espalhados pelas páginas. -->
                    <Border Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding [Optimizer.Stage.Run], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text="&#xB7;" /><Run Text="{Binding ProgressPercentLabel, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource InfoBaseBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource InfoBaseBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DiscordButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Discord_Click"
                            ToolTip="{Binding [Discord.TitleBarTooltip], Source={StaticResource LocalizedStrings}}"
                            AutomationProperties.Name="{Binding [Discord.TitleBarTooltip], Source={StaticResource LocalizedStrings}}">
                        <Path Style="{StaticResource Icon20}" Data="{StaticResource IconDiscord}" Stroke="{x:Null}" Fill="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Border Style="{StaticResource VerticalHairlineDivider}" Height="20" Margin="4,0" VerticalAlignment="Center" />
                    <Button x:Name="AccountButton" Style="{StaticResource IconButtonStyle}" Width="Auto" Padding="8,0,12,0" Click="Account_Click"
                            ToolTip="{Binding [Account.TitleBar.SignInPrompt], Source={StaticResource LocalizedStrings}}"
                            AutomationProperties.Name="{Binding [Account.TitleBar.SignInPrompt], Source={StaticResource LocalizedStrings}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusPill}" Background="{DynamicResource Surface2Brush}">
                                <Grid>
                                    <TextBlock x:Name="AccountInitials" Style="{StaticResource CaptionText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse x:Name="AccountAvatarEllipse" Width="22" Height="22" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AccountLabel" Text="{Binding [Account.TitleBar.SignInPrompt], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ===================== Navegação + conteúdo ===================== -->
        <ui:NavigationView x:Name="RootNavigationView"
                            Grid.Row="1"
                            IsBackButtonVisible="Collapsed"
                            PaneDisplayMode="Left"
                            OpenPaneLength="216"
                            CompactPaneLength="56"
                            Background="{DynamicResource SurfaceRailBrush}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="DashboardNav" Content="{Binding [Navigation.Overview], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Home24}" Tag="Dashboard" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="OptimizerNav" Content="{Binding [Navigation.Optimizer], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon FlashSettings24}" Tag="Optimizer" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="HistoryNav" Content="{Binding [Navigation.History], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon History24}" Tag="History" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="SettingsNav" Content="{Binding [Navigation.Settings], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Settings24}" Tag="Settings" Click="NavItem_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem IsEnabled="False" Icon="{ui:SymbolIcon Shield24}" ToolTip="{Binding [Safety.SnapshotRollback], Source={StaticResource LocalizedStrings}}">
                    <ui:NavigationViewItem.Content>
                        <StackPanel Margin="0,4,0,4" Visibility="{Binding IsPaneOpen, ElementName=RootNavigationView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding [Safety.Active], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                <Run Text="{Binding [Sidebar.Version], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding AppVersion, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" />
                            </TextBlock>
                        </StackPanel>
                    </ui:NavigationViewItem.Content>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="PageContentHost">
                    <pages:OverviewPage x:Name="DashboardPage" />

                    <!-- ===================== Configurações ===================== -->
                    <!--
                        Duas regiões: categorias fixas à esquerda, conteúdo rolando à
                        direita. A seção "Conta" permanece aqui (não em um arquivo de
                        página separado) porque MainWindow.Account.xaml.cs já é o dono
                        de accountService/profileService/avatarStore — mover a marcação
                        para outro x:Class quebraria esses nomes de elemento.
                    -->
                    <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="32,24,32,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="172" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Text="{Binding [Settings.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" Margin="0,0,0,24" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,32,0">
                            <RadioButton x:Name="CategoryAccount" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Checked="SettingsCategory_Changed">
                                <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                            </RadioButton>
                            <RadioButton x:Name="CategoryGeneral" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,2,0,0" Checked="SettingsCategory_Changed">
                                <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                            </RadioButton>
                            <RadioButton x:Name="CategoryPrivacy" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,2,0,0" Checked="SettingsCategory_Changed">
                                <TextBlock Text="{Binding [Settings.Privacy.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                            </RadioButton>
                            <RadioButton x:Name="CategoryTools" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,2,0,0" Checked="SettingsCategory_Changed">
                                <TextBlock Text="{Binding [Settings.Tools.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                            </RadioButton>
                            <RadioButton x:Name="CategoryAbout" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,2,0,0" Checked="SettingsCategory_Changed">
                                <TextBlock Text="{Binding [Settings.About.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                            </RadioButton>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource VerticalHairlineDivider}" Margin="0,0,24,0" />

                        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                                <!-- ===== Conta ===== -->
                                <StackPanel x:Name="AccountSettingsCard" Visibility="Collapsed">
                                    <StackPanel x:Name="AccountSettingsUnavailablePanel">
                                        <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{Binding [Settings.Account.Unavailable], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <StackPanel x:Name="AccountSettingsSignedOutPanel">
                                        <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{Binding [Settings.Account.SignedOutDescription], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,16" TextWrapping="Wrap" />
                                        <Button Content="{Binding [Settings.Account.SignInButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="OpenAccountFromSettings_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="AccountSettingsSignedInPanel" Visibility="Collapsed">
                                        <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,16" />

                                        <Border x:Name="AccountSettingsStatusPanel" Style="{StaticResource AlertRowStyle}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="AccountSettingsStatusIcon" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" VerticalAlignment="Top" />
                                                <TextBlock x:Name="AccountSettingsStatusText" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusPill}" Background="{DynamicResource Surface2Brush}">
                                                    <Grid>
                                                        <TextBlock x:Name="AccountSettingsInitials" Style="{StaticResource BodyStrongText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse x:Name="AccountSettingsAvatarEllipse" Width="48" Height="48" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AccountSettingsEmailText" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock x:Name="AccountSettingsUsernameText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="ChangePhotoButton" Content="{Binding [Settings.Account.ChangePhoto], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="12,0" Click="ChangePhoto_Click" />
                                                    <Button x:Name="RemovePhotoButton" Content="{Binding [Settings.Account.RemovePhoto], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" Margin="8,0,0,0" Visibility="Collapsed" Click="RemovePhoto_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Settings.Account.CurrentPasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                                                <controls:RevealPasswordBox x:Name="AccountSettingsCurrentPasswordField" Placeholder="{Binding [Settings.Account.CurrentPasswordPlaceholder], Source={StaticResource LocalizedStrings}}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Settings.Account.NewPasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                                                    <controls:RevealPasswordBox x:Name="AccountSettingsNewPasswordField" Placeholder="{Binding [Settings.Account.NewPasswordPlaceholder], Source={StaticResource LocalizedStrings}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="AccountSettingsChangePasswordButton" Content="{Binding [Settings.Account.ChangePassword], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,20,0,0" Click="AccountSettingsChangePassword_Click" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Settings.Account.NewEmailLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="AccountSettingsNewEmailBox" Style="{StaticResource FormTextBoxStyle}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="AccountSettingsChangeEmailButton" Content="{Binding [Settings.Account.ChangeEmail], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,20,0,0" Click="AccountSettingsChangeEmail_Click" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Button x:Name="AccountSettingsLogoutButton" Content="{Binding [Settings.Account.SignOut], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="AccountSettingsLogout_Click" />
                                                <Button Grid.Column="1" x:Name="AccountSettingsDeleteAccountButton" Content="{Binding [Settings.Account.Delete], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DangerGhostButtonStyle}" Click="AccountSettingsDeleteAccount_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== Geral ===== -->
                                <StackPanel x:Name="GeneralSettingsPanel">
                                    <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />

                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.Language.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="LanguageSelector" Grid.Column="1" Style="{StaticResource SettingsComboBoxStyle}" SelectedValuePath="Content" SelectionChanged="LanguageSelector_SelectionChanged">
                                                <ComboBoxItem Tag="pt-BR" Content="{Binding [Settings.Language.PortugueseBrazil], Source={StaticResource LocalizedStrings}}" />
                                                <ComboBoxItem Tag="en" Content="{Binding [Settings.Language.English], Source={StaticResource LocalizedStrings}}" />
                                                <ComboBoxItem Tag="es" Content="{Binding [Settings.Language.Spanish], Source={StaticResource LocalizedStrings}}" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.Appearance.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                            <TextBlock Text="{Binding [Settings.Appearance.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,10" />
                                            <Border Style="{StaticResource SegmentedHostStyle}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ThemeSystemOption" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="{Binding [Settings.Appearance.System], Source={StaticResource LocalizedStrings}}" Checked="SystemTheme_Checked" />
                                                    <RadioButton x:Name="ThemeDarkOption" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="{Binding [Settings.Appearance.Dark], Source={StaticResource LocalizedStrings}}" Checked="DarkTheme_Checked" />
                                                    <RadioButton x:Name="ThemeLightOption" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="{Binding [Settings.Appearance.Light], Source={StaticResource LocalizedStrings}}" Checked="LightTheme_Checked" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Settings.CloseBehavior.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.CloseBehavior.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}" AutomationProperties.Name="{Binding [Settings.CloseBehavior.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.CloseBehavior.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Settings.StartWithWindows.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.StartWithWindows.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LaunchAtStartup}" AutomationProperties.Name="{Binding [Settings.StartWithWindows.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.StartWithWindows.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Privacidade ===== -->
                                <StackPanel x:Name="PrivacySettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Settings.Privacy.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Settings.Telemetry.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShareAnonymousTelemetry}" AutomationProperties.Name="{Binding [Settings.Telemetry.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.Telemetry.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>
                                    <Expander Header="Ver o que é enviado" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Privacy.Collects.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Foreground="{DynamicResource SuccessBaseBrush}" />
                                                <TextBlock Text="{Binding [Privacy.Collects.Items], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding [Privacy.DoesNotCollect.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Foreground="{DynamicResource DangerBaseBrush}" />
                                                <TextBlock Text="{Binding [Privacy.DoesNotCollect.Items], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander>
                                </StackPanel>

                                <!-- ===== Ferramentas ===== -->
                                <StackPanel x:Name="ToolsSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Settings.Tools.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Settings.CheckForUpdates.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.CheckForUpdates.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ManualUpdateCheckMessage}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Visibility="{Binding ManualUpdateCheckMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding [Settings.CheckForUpdates.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanCheckForUpdatesManually}" Click="CheckForUpdatesManually_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [GtaVBenchmark.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [GtaVBenchmark.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding GtaVBenchmarkStatusLabel}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" Visibility="{Binding GtaVBenchmarkStatusLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding [GtaVBenchmark.RunButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanRunGtaVBenchmark}" Click="RunGtaVBenchmark_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.Tools.ReportIssue.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{Binding [Settings.Tools.ReportIssue.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="ReportBug_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Sobre ===== -->
                                <StackPanel x:Name="AboutSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Settings.About.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding [Settings.About.AppName], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding AboutVersionDeveloper}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding [Settings.About.Tagline], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{Binding [Settings.About.Repository], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenRepository_Click" />
                                        <Button Content="{Binding [Settings.About.Discord.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="Discord_Click" />
                                    </StackPanel>
