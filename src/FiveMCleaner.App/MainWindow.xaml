<ui:FluentWindow x:Class="FiveMCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="FiveMCleaner"
        Icon="Assets/FiveMCleaner.png"
        Width="1160"
        Height="680"
        MinWidth="960"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}">

    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="ActionTemplate">
            <ui:CardControl Margin="0,0,0,9" Padding="14">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#20FF7A18" VerticalAlignment="Top">
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource OrangeLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Padding="7,3" Background="{DynamicResource ChipBrush}" CornerRadius="6">
                                    <TextBlock Text="{Binding RiskLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                                <Border Margin="6,0,0,0" Padding="7,3" Background="{DynamicResource ChipBrush}" CornerRadius="6">
                                    <TextBlock Text="{Binding PrivilegeLabel}" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" VerticalAlignment="Center" />
                <Ellipse Grid.Column="1" Width="5" Height="5" Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StepLedgerTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="1" Padding="7,2" Background="{DynamicResource ChipBrush}" CornerRadius="6" Margin="8,0,0,0">
                    <TextBlock Text="{Binding OutcomeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReportLineTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ActionName}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Reason}" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Visibility="{Binding Reason, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="7,2" Background="{DynamicResource ChipBrush}" CornerRadius="6" Margin="8,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding OutcomeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryTemplate">
            <ui:CardControl Margin="0,0,0,10" Padding="17">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#1C37C889" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GreenBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5">
                                <Run Text="{Binding DateLabel, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <Button Content="{Binding [History.Undo], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="16,0" Tag="{Binding}" Click="RollbackHistory_Click" IsEnabled="{Binding CanRollback}" />
            </ui:CardControl>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Height="54" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="Assets/FiveMCleaner.png" Width="32" Height="32" Stretch="Uniform" />
                        <TextBlock Margin="10,0,0,0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="FiveM" /><Run Text="Cleaner" Foreground="{DynamicResource OrangeBrush}" />
                        </TextBlock>
                        <Border Margin="12,0,0,0" MinHeight="26" Padding="9,0" Background="{DynamicResource ChipBrush}" CornerRadius="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditionBadgeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <Button x:Name="AccountButton" Padding="10,0" MinHeight="40" VerticalAlignment="Center" Click="Account_Click" ToolTip="Entrar ou criar conta" AutomationProperties.Name="Entrar ou cadastrar-se" Background="Transparent" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="8" />
                                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ChipBrush}" />
                                                    <Setter TargetName="HoverSurface" Property="Opacity" Value="0.82" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OrangeLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ChipBrush}" />
                                                    <Setter TargetName="HoverSurface" Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OrangeLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HoverSurface" Property="BorderBrush" Value="{DynamicResource OrangeLightBrush}" />
                                                    <Setter TargetName="HoverSurface" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="25" Height="25" CornerRadius="13" Background="{DynamicResource ChipBrush}" Margin="0,0,7,0">
                                <TextBlock x:Name="AccountInitials" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubtleBrush}" />
                            </Border>
                            <TextBlock x:Name="AccountLabel" Text="Entrar / Cadastre-se" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <ui:NavigationView x:Name="RootNavigationView"
                                Grid.Row="1"
                                IsBackButtonVisible="Collapsed"
                                PaneDisplayMode="Left"
                                OpenPaneLength="210"
                                CompactPaneLength="52"
                                Background="{DynamicResource SidebarBrush}">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="DashboardNav" Content="{Binding [Navigation.Overview], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Home24}" Tag="Dashboard" Click="NavItem_Click" />
                    <ui:NavigationViewItem x:Name="OptimizerNav" Content="{Binding [Navigation.Optimizer], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon FlashSettings24}" Tag="Optimizer" Click="NavItem_Click" />
                    <ui:NavigationViewItem x:Name="HistoryNav" Content="{Binding [Navigation.History], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon History24}" Tag="History" Click="NavItem_Click" />
                    <ui:NavigationViewItem x:Name="SettingsNav" Content="{Binding [Navigation.Settings], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Settings24}" Tag="Settings" Click="NavItem_Click" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem IsEnabled="False"
                                           Icon="{ui:SymbolIcon Shield24}"
                                           ToolTip="{Binding [Safety.SnapshotRollback], Source={StaticResource LocalizedStrings}}">
                        <ui:NavigationViewItem.Content>
                            <StackPanel Margin="0,4,0,4" Visibility="{Binding IsPaneOpen, ElementName=RootNavigationView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding [Safety.Active], Source={StaticResource LocalizedStrings}}" FontSize="11.5" FontWeight="SemiBold" />
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding [Sidebar.Version], Source={StaticResource LocalizedStrings}}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               FontFamily="Segoe UI Variable Text"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="Segoe UI Variable Text"
                                               FontSize="9.5"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </ui:NavigationViewItem.Content>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>

                <ui:NavigationView.ContentOverlay>
                <Grid Margin="26,22,0,24">
                    <!-- Dashboard -->
                    <ScrollViewer x:Name="DashboardPage" Padding="0,0,26,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{Binding [Dashboard.Title], Source={StaticResource LocalizedStrings}}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="Bold" />
                                    <TextBlock Text="{Binding [Dashboard.Subtitle], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="13.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding [Dashboard.Refresh], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Height="38" Padding="15,0" Click="RefreshDiagnostic_Click" IsEnabled="{Binding CanRefresh}" />
                            </Grid>

                            <Border Margin="0,0,0,16"
                                    Padding="16,14"
                                    Background="#16FF7A18"
                                    BorderBrush="#56FF7A18"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="27" Height="27" CornerRadius="8" Background="#25FF7A18" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource OrangeLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,18,0">
                                        <TextBlock Text="{Binding UpdateBannerTitle}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UpdateBannerDetail}" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="{Binding UpdateActionLabel}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="36"
                                                MinWidth="132"
                                                Padding="15,0"
                                                IsEnabled="{Binding CanDownloadUpdate}"
                                                ToolTip="{Binding [Update.BlockedWhileBusy], Source={StaticResource LocalizedStrings}}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="DownloadUpdate_Click" />
                                        <Button Content="{Binding UpdateReleaseNotesLabel}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                FontSize="10.5"
                                                Padding="4,7,4,0"
                                                HorizontalAlignment="Center"
                                                IsEnabled="{Binding CanOpenReleaseNotes}"
                                                Click="OpenReleaseNotes_Click" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Opacity="0.72"
                                            ToolTip="{Binding [Window.Close], Source={StaticResource LocalizedStrings}}"
                                            Visibility="{Binding IsUpdateCompletedBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="DismissCompletedUpdate_Click">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                    </Button>
                                    <ProgressBar Grid.Row="1"
                                                 Grid.Column="1"
                                                 Grid.ColumnSpan="2"
                                                 Height="3"
                                                 Margin="7,10,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <ui:Card Padding="24" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2D5E4C" />
                                                                <Setter Property="Background" Value="#15231C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center">
                                                        <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 3,3 L 11,11 M 11,3 L 3,11" /><Setter Property="Stroke" Value="{DynamicResource RedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="Data" Value="M 2.5,7 L 5.5,10 L 11.5,4.5" /><Setter Property="Stroke" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding EditionLabel}" Margin="8,0,2,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2D5E4C" />
                                                                <Setter Property="Background" Value="#15231C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center">
                                                        <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 3,3 L 11,11 M 11,3 L 3,11" /><Setter Property="Stroke" Value="{DynamicResource RedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="Data" Value="M 2.5,7 L 5.5,10 L 11.5,4.5" /><Setter Property="Stroke" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                                    </Path>
                                                    <TextBlock Text="{Binding GtaStatusLabel}" Margin="8,0,2,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RecommendationTitle}" Margin="0,14,0,0" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="{Binding RecommendationText}" Margin="0,7,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="720" />
                                        <Button Content="{Binding [Dashboard.OpenOptimizer], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" Margin="0,18,0,0" HorizontalAlignment="Left" Click="OpenOptimizer_Click" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="132" Height="132" Margin="30,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ReadinessScoreExplanation}">
                                        <Ellipse Width="126" Height="126" Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource RingBrush}" StrokeThickness="5" />
                                        <Ellipse Width="114" Height="114" Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" />
                                        <Border Width="96" Height="96" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="48">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ReadinessScore}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OrangeLightBrush}" />
                                                    <TextBlock Text="/100" Margin="3,12,0,0" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding ReadinessLevelLabel}" Margin="0,4,0,0" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </ui:Card>

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                    <ui:Card Grid.Column="0" Padding="20" VerticalAlignment="Stretch">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Title], Source={StaticResource LocalizedStrings}}" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Description], Source={StaticResource LocalizedStrings}}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
                                                    <Border Padding="8,4" Background="#1537C889" BorderBrush="#3A37C889" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding [Dashboard.LivePerformance.Live], Source={StaticResource LocalizedStrings}}" Margin="6,0,0,0" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}" /></StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding LiveMetricsUpdatedLabel}" Margin="0,5,0,0" FontSize="8.5" Foreground="{DynamicResource TextSubtleBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,17,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Padding="12,10" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
                                                    <StackPanel><TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding CpuUsageLabel}" Margin="0,5,0,8" FontSize="18" FontWeight="SemiBold" /><ProgressBar Value="{Binding CpuUsagePercent, Mode=OneWay}" Height="4" /></StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Padding="12,10" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
                                                    <StackPanel><TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding GpuUsageLabel}" Margin="0,5,0,8" FontSize="18" FontWeight="SemiBold" /><ProgressBar Value="{Binding GpuUsagePercent, Mode=OneWay}" Height="4" Foreground="{DynamicResource BlueBrush}" /></StackPanel>
                                                </Border>
                                                <Border Grid.Column="4" Padding="12,10" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
                                                    <StackPanel><TextBlock Text="{Binding [Dashboard.LivePerformance.Memory], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding MemoryUsageLabel}" Margin="0,5,0,8" FontSize="18" FontWeight="SemiBold" /><ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}" Height="4" Foreground="{DynamicResource GreenBrush}" /></StackPanel>
                                                </Border>
                                                <Border Grid.Column="6" Padding="12,10" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
                                                    <StackPanel><TextBlock Text="{Binding [Dashboard.LivePerformance.Disk], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding DiskUsageLabel}" Margin="0,5,0,8" FontSize="18" FontWeight="SemiBold" /><ProgressBar Value="{Binding DiskUsagePercent, Mode=OneWay}" Height="4" Foreground="{DynamicResource YellowBrush}" /></StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Margin="0,14,0,0" Padding="14,12" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="11">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Margin="6,0,14,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" /><Ellipse Width="6" Height="6" Fill="{DynamicResource BlueBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Margin="6,0,0,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding [Dashboard.LivePerformance.Network], Source={StaticResource LocalizedStrings}}" FontSize="9" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding NetworkUsageLabel}" Margin="6,0,0,0" FontSize="9" FontWeight="SemiBold" /></StackPanel>
                                                    </Grid>
                                                    <Viewbox Height="138" Stretch="Fill" AutomationProperties.Name="{Binding [Dashboard.LivePerformance.ChartDescription], Source={StaticResource LocalizedStrings}}">
                                                        <Canvas Width="640" Height="110" ClipToBounds="True" IsHitTestVisible="False">
                                                            <Line X1="0" X2="640" Y1="0" Y2="0" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="1" />
                                                            <Line X1="0" X2="640" Y1="36.5" Y2="36.5" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="1" />
                                                            <Line X1="0" X2="640" Y1="73" Y2="73" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="1" />
                                                            <Line X1="0" X2="640" Y1="109" Y2="109" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="1" />
                                                            <Polyline Points="{Binding CpuUsagePoints}" Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                                            <Polyline Points="{Binding GpuUsagePoints}" Stroke="{DynamicResource BlueBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ui:Card>

                                    <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Dashboard.SystemOverview], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Dashboard.SystemOverview.Description], Source={StaticResource LocalizedStrings}}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                            <StackPanel Margin="0,18,0,0">
                                                <TextBlock Text="{Binding [Dashboard.Processor], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding CpuName}" Margin="0,4,0,14" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                                                <TextBlock Text="{Binding [Dashboard.GraphicsCard], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding GpuDetail}" Margin="0,4,0,14" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                                                <TextBlock Text="{Binding [Dashboard.Memory], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding RamLabel}" Margin="0,4,0,14" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding [Dashboard.Storage], Source={StaticResource LocalizedStrings}}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding DiskLabel}" Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Margin="0,22,0,0" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding [Dashboard.LivePerformance.LocalOnly], Source={StaticResource LocalizedStrings}}" Margin="9,0,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ui:Card>
                                </Grid>

                                <ui:Card Grid.Row="2" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StreamingReadinessTitle}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StreamingReadinessDetail}" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding StreamingReadinessItems}" Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,0" Padding="13" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource OrangeLightBrush}" VerticalAlignment="Top" />
                                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" /></StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:Card>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Optimizer -->
                    <Grid x:Name="OptimizerPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,26,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,22,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding [Optimizer.Title], Source={StaticResource LocalizedStrings}}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="Bold" />
                                <TextBlock Text="{Binding [Optimizer.Subtitle], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="13.5" TextWrapping="Wrap" MaxWidth="760" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="10,5" Background="#1837C889" CornerRadius="8" Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding [Optimizer.SystemReady], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" Foreground="{DynamicResource GreenBrush}" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="10,5" Background="{DynamicResource ChipBrush}" CornerRadius="8">
                                    <TextBlock Text="{Binding [Optimizer.NoRemoteScripts], Source={StaticResource LocalizedStrings}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="0,0,26,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsOptimizerIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <ui:Card Grid.Column="0" Padding="22">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [Optimizer.Recommended], Source={StaticResource LocalizedStrings}}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OrangeLightBrush}" />
                                                        <TextBlock Text="{Binding SelectedProfileLabel}" Margin="0,7,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="42" Height="42" Background="#20FF7A18" CornerRadius="12"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource OrangeLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding ProfilePresentationBenefits}" Margin="0,13,0,0" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                <primitives:UniformGrid Grid.Row="2" Columns="3" Margin="0,18,0,0">
                                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding SelectedActionCount}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding [Plan.VerifiedActions.Label], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" /></StackPanel>
                                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ProfilePresentationImpact}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding [Optimizer.Impact], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" /></StackPanel>
                                                    <StackPanel><TextBlock Text="{Binding ElevationLabel}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding [Optimizer.Execution], Source={StaticResource LocalizedStrings}}" Margin="0,2,0,0" FontSize="9.5" Foreground="{DynamicResource TextSubtleBrush}" /></StackPanel>
                                                </primitives:UniformGrid>
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0">
                                                    <Button Content="{Binding [Plan.OptimizeNow], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="24,0" Click="StartOptimization_Click" IsEnabled="{Binding CanStart}" />
                                                    <Button Content="{Binding [Plan.Review], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="18,0" Margin="9,0,0,0" Click="ReviewPlan_Click" />
                                                    <Button Content="{Binding [Optimizer.ChangeMode], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" Margin="12,0,0,0" Click="ChangeMode_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>

                                        <ui:Card Grid.Column="2" Padding="20">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding [Optimizer.Computer], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSubtleBrush}" /></Grid>
                                                <StackPanel Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding CpuName}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                                                    <TextBlock Text="{Binding GpuDetail}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                                                    <TextBlock Text="{Binding RamLabel}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding DiskLabel}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding WindowsLabel}" Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Separator Margin="0,14" Background="{DynamicResource BorderSoftBrush}" />
                                                <WrapPanel>
                                                    <Border Margin="0,0,8,8">
                                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="BorderBrush" Value="#2D5E4C" /><Setter Property="Background" Value="#15231C" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="{Binding EditionLabel}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                    <Border Margin="0,0,0,8">
                                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource DetectionBadgeStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="BorderBrush" Value="#2D5E4C" /><Setter Property="Background" Value="#15231C" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="{Binding GtaStatusLabel}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetectionBadgeLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True"><Setter Property="Foreground" Value="#5BCF98" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ui:Card>
                                    </Grid>

                                    <StackPanel x:Name="ProfileSelectorSection" Margin="0,18,0,0">
                                        <TextBlock Text="{Binding [Profiles.Choose], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0" GroupName="OptimizerProfile" Style="{StaticResource ModeRadioStyle}" IsChecked="{Binding IsLightSelected}" Checked="LightProfile_Checked"><StackPanel><Grid><TextBlock Text="{Binding [Profiles.Light.Name], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" /><Border Padding="8,3" Background="#24FF7A18" CornerRadius="6" HorizontalAlignment="Right" Visibility="{Binding IsLightRecommended, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" /></Border></Grid><TextBlock Text="{Binding [Profiles.Light.Description], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding LightImpactLabel}" Margin="0,10,0,0" FontSize="9.5" Foreground="{DynamicResource GreenBrush}" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                            <RadioButton Grid.Column="2" GroupName="OptimizerProfile" Style="{StaticResource ModeRadioStyle}" IsChecked="{Binding IsBalancedSelected}" Checked="BalancedProfile_Checked"><StackPanel><Grid><TextBlock Text="{Binding [Profiles.Balanced.Name], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" /><Border Padding="8,3" Background="#24FF7A18" CornerRadius="6" HorizontalAlignment="Right" Visibility="{Binding IsBalancedRecommended, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" /></Border></Grid><TextBlock Text="{Binding [Profiles.Balanced.Description], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding BalancedImpactLabel}" Margin="0,10,0,0" FontSize="9.5" Foreground="{DynamicResource OrangeLightBrush}" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                            <RadioButton Grid.Column="4" GroupName="OptimizerProfile" Style="{StaticResource ModeRadioStyle}" IsChecked="{Binding IsAggressiveSelected}" Checked="AggressiveProfile_Checked"><StackPanel><Grid><TextBlock Text="{Binding [Profiles.Aggressive.Name], Source={StaticResource LocalizedStrings}}" FontSize="16" FontWeight="SemiBold" /><Border Padding="8,3" Background="#24FF7A18" CornerRadius="6" HorizontalAlignment="Right" Visibility="{Binding IsAggressiveRecommended, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OrangeLightBrush}" /></Border></Grid><TextBlock Text="{Binding [Profiles.Aggressive.Description], Source={StaticResource LocalizedStrings}}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding AggressiveImpactLabel}" Margin="0,10,0,0" FontSize="9.5" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" /></StackPanel></RadioButton>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <ui:Card Padding="26" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [Optimizer.RunningTitle], Source={StaticResource LocalizedStrings}}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding ProgressHeadline, Mode=OneWay}" Margin="0,7,0,0" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}%}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OrangeLightBrush}" /></Grid>
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,24,0,0" Foreground="{DynamicResource OrangeBrush}" />
                                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ElapsedTimeLabel}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding RemainingTimeLabel}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                                        <TextBlock Text="{Binding PreviousProgressHeadline}" Margin="0,12,0,0" Visibility="{Binding HasPreviousProgressHeadline, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right"><Button Content="{Binding [Optimizer.ShowDetails], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="ReviewPlan_Click" /><Button Content="{Binding [Progress.CancelAfterStep], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="9,0,0,0" Click="CancelOptimization_Click" IsEnabled="{Binding CanCancel}" /></StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="24" Visibility="{Binding IsReportAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="19" Background="#2037C889"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GreenBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="{Binding [Optimizer.CompletedTitle], Source={StaticResource LocalizedStrings}}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding ReportSummaryLabel}" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                        <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource PanelBrush}" CornerRadius="10"><StackPanel><TextBlock Text="{Binding [Optimizer.NextStep], Source={StaticResource LocalizedStrings}}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtleBrush}" /><TextBlock Text="{Binding ReportRestartLabel}" Margin="0,5,0,0" FontSize="11.5" TextWrapping="Wrap" /></StackPanel></Border>
                                        <ScrollViewer MaxHeight="240" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReportLines}" ItemTemplate="{StaticResource ReportLineTemplate}" /></ScrollViewer>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Right"><Button Content="{Binding [Report.CopyButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="CopyTechnicalReport_Click" /><Button Content="{Binding [Report.SaveButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="9,0,0,0" Click="SaveTechnicalReport_Click" /></StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <Expander x:Name="PlanDetailsExpander" Margin="0,16,0,0">
                                    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [Optimizer.PlanTitle], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding ProfilePresentationCategories}" Margin="0,4,20,0" FontSize="10.5" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding PlanHeader}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Expander.Header>
                                    <StackPanel Margin="0,12,0,0"><Border Padding="13" Background="{DynamicResource PanelBrush}" CornerRadius="9"><StackPanel><TextBlock Text="{Binding PlanSummary}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding SafetySummary}" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" /></StackPanel></Border><ItemsControl ItemsSource="{Binding PlannedActions}" ItemTemplate="{StaticResource ActionTemplate}" Margin="0,12,0,0" /></StackPanel>
                                </Expander>

                                <Border Margin="0,13,0,0" Padding="13" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsComparisonAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel><TextBlock Text="{Binding [Comparison.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" /><TextBlock Text="{Binding ComparisonSummaryLabel}" Margin="0,6,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding ComparisonHardwareProfileLabel}" Margin="0,4,0,0" FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSubtleBrush}" /><Button Content="{Binding [Comparison.RevertButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="RevertLastOptimization_Click" Visibility="{Binding ComparisonRegressionSuspected, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanRevertLastOptimization}" /></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- History -->
                    <Grid x:Name="HistoryPage" Margin="0,0,26,0" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding [History.Title], Source={StaticResource LocalizedStrings}}" FontSize="25" FontWeight="Bold" /><TextBlock Text="{Binding [History.Subtitle], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="{Binding [History.OpenLogs], Source={StaticResource LocalizedStrings}}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Height="38" Click="OpenLogs_Click" /></Grid>
                        <ui:Card Grid.Row="1" Padding="18">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14"><TextBlock Text="{Binding [History.LocalRuns], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" /></Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource HistoryTemplate}" /></ScrollViewer>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Padding="0,0,26,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings.Title], Source={StaticResource LocalizedStrings}}" Margin="0,0,0,18" FontSize="25" FontWeight="Bold" />
                            <ui:Card Margin="0,0,0,13" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource LocalizedStrings}}" Margin="0,10,0,0" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.Language.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,6" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <ComboBox x:Name="LanguageSelector" Style="{StaticResource SettingsComboBoxStyle}" SelectedValuePath="Content" SelectionChanged="LanguageSelector_SelectionChanged">
                                        <ComboBoxItem Tag="pt-BR" Content="{Binding [Settings.Language.PortugueseBrazil], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="en" Content="{Binding [Settings.Language.English], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="es" Content="{Binding [Settings.Language.Spanish], Source={StaticResource LocalizedStrings}}" />
                                    </ComboBox>
                                    <Separator Margin="0,8" Background="{DynamicResource BorderSoftBrush}" />
                                    <TextBlock Text="{Binding [Settings.Appearance.Title], Source={StaticResource LocalizedStrings}}" Margin="0,0,0,4" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.Appearance.Description], Source={StaticResource LocalizedStrings}}" Margin="0,0,0,6" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <ComboBox x:Name="ThemeSelector" Style="{StaticResource SettingsComboBoxStyle}" SelectedValuePath="Content" SelectionChanged="ThemeSelector_SelectionChanged">
                                        <ComboBoxItem Tag="system" Content="{Binding [Settings.Appearance.System], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="dark" Content="{Binding [Settings.Appearance.Dark], Source={StaticResource LocalizedStrings}}" />
                                        <ComboBoxItem Tag="light" Content="{Binding [Settings.Appearance.Light], Source={StaticResource LocalizedStrings}}" />
                                    </ComboBox>
                                    <Separator Margin="0,8" Background="{DynamicResource BorderSoftBrush}" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.CloseBehavior.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.CloseBehavior.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="0,13" Background="{DynamicResource BorderSoftBrush}" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LaunchAtStartup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.StartWithWindows.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.StartWithWindows.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.Privacy.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShareAnonymousTelemetry}" Margin="0,15,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Settings.Telemetry.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [Settings.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Separator Margin="0,13" Background="{DynamicResource BorderSoftBrush}" />
                                    <TextBlock Text="{Binding [Privacy.Collects.Title], Source={StaticResource LocalizedStrings}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                                    <TextBlock Text="{Binding [Privacy.Collects.Items], Source={StaticResource LocalizedStrings}}" Margin="0,4,0,11" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Title], Source={StaticResource LocalizedStrings}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}" />
                                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Items], Source={StaticResource LocalizedStrings}}" Margin="0,4,0,0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Settings.CheckForUpdates.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [Settings.CheckForUpdates.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,13" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <Button Content="{Binding [Settings.CheckForUpdates.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="CheckForUpdatesManually_Click" IsEnabled="{Binding CanCheckForUpdatesManually}" />
                                    <TextBlock Text="{Binding ManualUpdateCheckMessage}" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Visibility="{Binding ManualUpdateCheckMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,0,0,13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [GtaVBenchmark.Title], Source={StaticResource LocalizedStrings}}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [GtaVBenchmark.Description], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,13" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                    <Button Content="{Binding [GtaVBenchmark.RunButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="RunGtaVBenchmark_Click" IsEnabled="{Binding CanRunGtaVBenchmark}" />
                                    <TextBlock Text="{Binding GtaVBenchmarkStatusLabel}" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>

            <Border Grid.Row="2"
                    Padding="16,8"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButtonStyle}"
                            Padding="4,2"
                            Click="ReportBug_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource OrangeLightBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding [BugReport.Link], Source={StaticResource LocalizedStrings}}" FontSize="10.5" TextDecorations="Underline" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="12,0" Fill="{DynamicResource BorderSoftBrush}" />
                    <TextBlock Text="{Binding [Brand.FooterCopyright], Source={StaticResource LocalizedStrings}}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="8.5" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
    </Grid>
</ui:FluentWindow>
