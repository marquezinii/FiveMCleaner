<UserControl x:Class="FiveMCleaner.App.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <!--
        VISÃO GERAL — direção "Câmara Âmbar".

        A página não é mais uma folha emoldurada contendo cabeçalho
        emoldurado contendo cartões. São TRÊS painéis irmãos sobre o chão da
        câmara, e o cabeçalho fica direto sobre esse chão:

          diagnóstico  — a conclusão e a prontidão, com a faixa de
                         instrumentos que sustenta a recomendação;
          ao vivo      — as cinco leituras e o gráfico, em linha "*", então
                         o painel termina exatamente na borda da janela em
                         qualquer resolução;
          notas        — máquina, última execução, prontidão para transmitir.

        O que saiu daqui por ser redundante para um usuário comum: a linha
        "eyebrow" acima/abaixo do próprio título; a legenda "análise local"
        repetida sob um indicador; o parágrafo que descrevia o que é uma
        lista de especificações; a segunda cópia da explicação da nota
        (permanece como tooltip da própria escala); o parágrafo que explicava
        o que é um gráfico ao vivo; e o aviso de privacidade, que agora existe
        uma vez, em Configurações › Privacidade.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="StreamingRowTemplate">
            <Border Style="{StaticResource LedgerRowStyle}" Padding="0,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon16}" Data="{Binding IconKey, Converter={StaticResource GeometryKeyConverter}}"
                          Stroke="{Binding ToneBrushKey, Converter={StaticResource BrushKeyConverter}}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Uma leitura ao vivo: rótulo, número tabular, trilho. -->
        <Style x:Key="LiveReadoutColumn" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Cabeçalho ===================== -->
        <!-- Direto sobre o chão da câmara: sem faixa, sem borda, sem moldura. -->
        <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Dashboard.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{Binding GreetingTitle}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="14,0,0,4" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CaptionText, não TickLabel: "Última varredura às
                         21:48" é uma frase, e mono numa frase quebra o ritmo
                         da linha sem medir nada. -->
                    <TextBlock Text="{Binding LastScanLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="RefreshDiagnostic_Click" IsEnabled="{Binding CanRefresh}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding [Dashboard.Refresh], Source={StaticResource LocalizedStrings}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Slot de alerta condicional: só existe quando há algo real a dizer. -->
        <Border Grid.Row="1" Style="{StaticResource AlertRowInfoStyle}" Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource InfoBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                    <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UpdateBannerDetail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    <ProgressBar Height="4" Margin="0,10,0,0" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Visibility="{Binding IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="{Binding UpdateActionLabel}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="16,0"
                            IsEnabled="{Binding CanDownloadUpdate}" Click="DownloadUpdate_Click" />
                    <Button Content="{Binding UpdateReleaseNotesLabel}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            IsEnabled="{Binding CanOpenReleaseNotes}" Click="OpenReleaseNotes_Click" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Visibility="{Binding IsUpdateCompletedBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="DismissCompletedUpdate_Click">
                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconClose}" />
                </Button>
            </Grid>
        </Border>

        <!-- ===================== Corpo ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" MinHeight="240" />
                </Grid.RowDefinitions>

                <!-- ============ Painel de diagnóstico ============ -->
                <Border Grid.Row="0" Style="{StaticResource PanelSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="28,26,28,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- A linha de luz: marca de onde a leitura começa. -->
                            <Rectangle Style="{StaticResource HeroAccentRule}" />

                            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                <!-- Selos de detecção: forma do ícone E cor,
                                     nunca só cor — quem não distingue verde de
                                     vermelho ainda lê o check contra o X. -->
                                <StackPanel Orientation="Horizontal">
                                    <Path Margin="0,0,7,0">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource Icon16}">
                                                <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding EditionLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    <Rectangle Width="1" Height="12" Margin="14,0" Fill="{DynamicResource TickMarkBrush}" VerticalAlignment="Center" />
                                    <Path Margin="0,0,7,0">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource Icon16}">
                                                <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding GtaStatusLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding RecommendationTitle}" Style="{StaticResource DisplayText}" Margin="0,16,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="660" HorizontalAlignment="Left" />

                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="OpenOptimizer_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconBolt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding [Dashboard.OpenOptimizer], Source={StaticResource LocalizedStrings}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Click="OpenHistory_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Escala de prontidão: leitura tabular grande +
                                 régua graduada. A explicação da nota vive aqui,
                                 como tooltip da própria escala, e em nenhum
                                 outro lugar da página. -->
                            <!--
                                A explicação vive como TEXTO VISÍVEL
                                (CaptionText abaixo), não só como ToolTip: um
                                StackPanel sem foco não expõe hover a teclado,
                                toque ou leitor de tela, e o WPF não abre
                                ToolTip por foco de teclado como o WinUI abre.
                                O ToolTip continua aqui só como atalho extra
                                para quem usa mouse.
                            -->
                            <StackPanel Grid.Column="2" Width="300" Margin="40,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ReadinessScoreExplanation}">
                                <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ReadinessScore, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" FontSize="52" FontWeight="SemiBold" LineHeight="58" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="/100" Style="{StaticResource TickLabelText}" VerticalAlignment="Bottom" Margin="8,0,0,11" />
                                </StackPanel>
                                <TextBlock Text="{Binding ReadinessLevelLabel}" Style="{StaticResource BodyStrongText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,14" />
                                <ProgressBar Style="{StaticResource ProgressRailStyle}" Height="8" Value="{Binding ReadinessScore, Mode=OneWay}"
                                             AutomationProperties.Name="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="0" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="1" Text="25" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="2" Text="50" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="3" Text="75" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="4" Text="100" Style="{StaticResource TickLabelText}" />
                                </Grid>
                                <TextBlock Text="{Binding ReadinessScoreExplanation}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Faixa de instrumentos: os quatro fatos da varredura
                             que sustentam a recomendação acima. Fica DENTRO do
                             mesmo painel, separada por traço — não é um segundo
                             cartão. -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,18,24,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Pressure.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding PerformancePressureLabel}" Style="{StaticResource MetricSmallText}" Margin="0,6,0,0"
                                               Foreground="{Binding PerformancePressureBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource VerticalHairlineDivider}" Margin="0,18" />
                                <StackPanel Grid.Column="2" Margin="24,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Cores.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding LogicalProcessorLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LogicalProcessorDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="3" Style="{StaticResource VerticalHairlineDivider}" Margin="0,18" />
                                <StackPanel Grid.Column="4" Margin="24,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Memory.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding AvailableMemoryLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding AvailableMemoryDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="5" Style="{StaticResource VerticalHairlineDivider}" Margin="0,18" />
                                <StackPanel Grid.Column="6" Margin="24,18,0,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Cache.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding LegacyCacheLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LegacyCacheDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ Painel ao vivo ============ -->
                <!-- Linha "*": o gráfico consome a altura restante, então o
                     painel termina na borda da janela em qualquer resolução. -->
                <Border Grid.Row="2" Style="{StaticResource PanelSurface}">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="10,4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TagChipStyle}">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LiveDot" Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBaseBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource DangerBaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource OverlineText}">
                                                <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Live], Source={StaticResource LocalizedStrings}}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBaseBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Unavailable], Source={StaticResource LocalizedStrings}}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Cinco leituras, uma por recurso. -->
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource LiveReadoutColumn}">
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding CpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,8" />
                                <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding CpuUsagePercent, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Style="{StaticResource LiveReadoutColumn}">
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding GpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,8" />
                                <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding GpuUsagePercent, Mode=OneWay}" Foreground="{DynamicResource InfoBaseBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource LiveReadoutColumn}" ToolTip="{Binding MemoryUsageDetailLabel}">
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding MemoryUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,8" />
                                <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding MemoryUsagePercent, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Style="{StaticResource LiveReadoutColumn}">
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Disk], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding DiskUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,8" />
                                <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding DiskUsagePercent, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Network], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding NetworkUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <!--
                            O poço do gráfico ocupa a altura restante — é o
                            certo, porque com amostras reais o traçado usa
                            toda ela. O que o tornava um retângulo morto no
                            visual anterior era ser um chapado preto: o wash
                            vertical logo abaixo dá material ao poço mesmo
                            enquanto a primeira amostra não chegou.
                        -->
                        <Border Grid.Row="2" Style="{StaticResource InsetSurface}" Margin="0,20,0,0" ClipToBounds="True">
                            <Grid>
                                <Rectangle Fill="{DynamicResource SheetGridBrush}" />
                                <Grid Visibility="{Binding HasLiveMetricsSample, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:LivePerformanceChart Capacity="60"
                                                                   SampleIntervalSeconds="1"
                                                                   CpuValues="{Binding CpuUsageSeries}"
                                                                   GpuValues="{Binding GpuUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}"
                                                                   GpuBrush="{DynamicResource InfoBaseBrush}"
                                                                   GridBrush="{DynamicResource BorderSubtleBrush}"
                                                                   LabelBrush="{DynamicResource TextTertiaryBrush}"
                                                                   TooltipBackground="{DynamicResource Surface3Brush}"
                                                                   TooltipBorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                   CpuLabel="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}"
                                                                   GpuLabel="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}"
                                                                   NowLabel="{Binding [Dashboard.LivePerformance.Now], Source={StaticResource LocalizedStrings}}"
                                                                   AutomationProperties.Name="{Binding [Dashboard.LivePerformance.ChartDescription], Source={StaticResource LocalizedStrings}}" />
                                    <TextBlock Text="{Binding LiveMetricsUpdatedLabel}" Style="{StaticResource TickLabelText}" Margin="16,14" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsLivePerformanceWaiting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Média e pico, das mesmas amostras desenhadas acima. -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Trend], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                                    <Run Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CpuTrendLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontMono}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Run Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding GpuTrendLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontMono}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Painel de notas ============ -->
            <Border Grid.Column="2" Style="{StaticResource NotesColumnSurface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding [Dashboard.SystemOverview], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 140px: "ARMAZENAMENTO" é o rótulo mais
                                     longo dos cinco; em 106 era truncado e em
                                     120 quebrava no meio da palavra. -->
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Dashboard.Processor], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Dashboard.GraphicsCard], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuDetail}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Dashboard.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Dashboard.Storage], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiskLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Dashboard.Windows], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,0" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WindowsLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" ToolTip="{Binding WindowsLabel}" />
                        </Grid>

                        <Border Style="{StaticResource HairlineDivider}" Margin="0,22" />

                        <!-- Última otimização registrada. -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding [Dashboard.LastRun.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastOptimizationDateLabel}" Style="{StaticResource TickLabelText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding LastOptimizationDateLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastOptimizationTitle}" Style="{StaticResource BodyStrongText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastOptimizationSummary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="-6,10,0,0"
                                    Visibility="{Binding HasLastOptimization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OpenHistory_Click"
                                    Content="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>

                        <Border Style="{StaticResource HairlineDivider}" Margin="0,22" />

                        <!-- Espaço seguro para criadores. -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconStream}" Stroke="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StreamingReadinessTitle}" Style="{StaticResource SubsectionText}" Margin="11,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StreamingReadinessDetail}" Style="{StaticResource CaptionText}" Margin="0,6,0,2" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding StreamingReadinessItems}" ItemTemplate="{StaticResource StreamingRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
