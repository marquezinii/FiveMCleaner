<UserControl x:Class="FiveMCleaner.App.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900">
    <UserControl.Resources>
        <DataTemplate x:Key="StreamingRowTemplate">
            <Border Style="{StaticResource LedgerRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon20}" Data="{Binding IconKey, Converter={StaticResource GeometryKeyConverter}}"
                          Stroke="{Binding ToneBrushKey, Converter={StaticResource BrushKeyConverter}}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel MaxWidth="1240" HorizontalAlignment="Stretch" Margin="32,24,32,40">

            <!-- Cabeçalho: sem card, a página fala primeiro pela tipografia. Sem
                 kicker acima do título — a saudação vira o subtítulo funcional
                 (status + hora do último diagnóstico), não um rótulo decorativo. -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{Binding [Dashboard.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding GreetingTitle}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextBrush}" />
                        <Ellipse Width="3" Height="3" Margin="8,0" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Dashboard.Eyebrow], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" />
                        <Ellipse Width="3" Height="3" Margin="8,0" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastScanLabel}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshDiagnostic_Click" IsEnabled="{Binding CanRefresh}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding [Dashboard.Refresh], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Slot de alerta condicional: só existe quando há algo real a dizer. -->
            <Border Style="{StaticResource AlertRowInfoStyle}" Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource Icon20}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource InfoBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdateBannerDetail}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                        <ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                     Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Visibility="{Binding IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="{Binding UpdateActionLabel}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0"
                                IsEnabled="{Binding CanDownloadUpdate}" Click="DownloadUpdate_Click" />
                        <Button Content="{Binding UpdateReleaseNotesLabel}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                IsEnabled="{Binding CanOpenReleaseNotes}" Click="OpenReleaseNotes_Click" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right"
                            Visibility="{Binding IsUpdateCompletedBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="DismissCompletedUpdate_Click">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Banda de estado: único hero da página. Detecção + recomendação
                 + prontidão, com o mesmo núcleo 3D usado no Otimizador. -->
            <Border Style="{StaticResource HeroSurface}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="640">
                        <StackPanel Orientation="Horizontal">
                            <Path Margin="0,0,6,0">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon16}">
                                        <Setter Property="Data" Value="{StaticResource IconClose}" />
                                        <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding EditionLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <Ellipse Width="3" Height="3" Margin="8,0" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Path Margin="0,0,6,0">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon16}">
                                        <Setter Property="Data" Value="{StaticResource IconClose}" />
                                        <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding GtaStatusLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecommendationTitle}" Style="{StaticResource DisplayText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="OpenOptimizer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconBolt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding [Dashboard.OpenOptimizer], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="OpenHistory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="180" Height="180" ToolTip="{Binding ReadinessScoreExplanation}">
                            <controls:CoreVisual Width="132" Height="132" Mode="Readiness" IsLive="{Binding IsLiveMetricsActive}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <controls:ArcProgress Width="170" Height="170"
                                                  Value="{Binding ReadinessScore, Mode=OneWay}" Maximum="100"
                                                  StrokeThickness="5" StartAngle="0" SweepAngle="360"
                                                  TrackBrush="{DynamicResource InstrumentBezelBrush}"
                                                  ProgressBrush="{DynamicResource AccentGradientBrush}" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0">
                            <Run Text="{Binding ReadinessScore, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" /100" FontFamily="{StaticResource AppFontMono}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" BaselineAlignment="TextTop" />
                        </TextBlock>
                        <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ReadinessLevelLabel}" Style="{StaticResource BodyStrongText}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource HairlineDivider}" Margin="0,0,0,20" />

            <!-- Última otimização: mais acionável que métricas ao vivo, então
                 fica logo após a banda de estado, como uma linha só. Sem
                 superfície própria: é parte do fluxo da página, não um cartão. -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconHistory}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Dashboard.LastRun.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastOptimizationDateLabel}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding LastOptimizationDateLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastOptimizationTitle}" Style="{StaticResource BodyStrongText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastOptimizationSummary}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" VerticalAlignment="Center"
                        Visibility="{Binding HasLastOptimization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OpenHistory_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconTrend}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource HairlineDivider}" Margin="0,0,0,20" />

            <!-- Faixa de instrumentos: quatro fatos, uma linha, sem cards repetidos nem superfície própria. -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Style="{StaticResource InstrumentCellStyle}">
                    <TextBlock Text="{Binding [Dashboard.Kpi.Pressure.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding PerformancePressureLabel}" Style="{StaticResource MetricSmallText}" Margin="0,4,0,0"
                               Foreground="{Binding PerformancePressureBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                    <TextBlock Text="{Binding [Dashboard.Readiness.LocalAnalysis], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource VerticalHairlineDivider}" Margin="0,4" />
                <StackPanel Grid.Column="2" Style="{StaticResource InstrumentCellStyle}">
                    <TextBlock Text="{Binding [Dashboard.Kpi.Cores.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding LogicalProcessorLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LogicalProcessorDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource VerticalHairlineDivider}" Margin="0,4" />
                <StackPanel Grid.Column="4" Style="{StaticResource InstrumentCellStyle}">
                    <TextBlock Text="{Binding [Dashboard.Kpi.Memory.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding AvailableMemoryLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding AvailableMemoryDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="5" Style="{StaticResource VerticalHairlineDivider}" Margin="0,4" />
                <StackPanel Grid.Column="6" Style="{StaticResource InstrumentCellStyle}">
                        <TextBlock Text="{Binding [Dashboard.Kpi.Cache.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                        <TextBlock Text="{Binding LegacyCacheLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LegacyCacheDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
            </Grid>

            <Border Style="{StaticResource HairlineDivider}" Margin="0,0,0,20" />

            <!-- Desempenho ao vivo. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Dashboard.LivePerformance.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Padding="8,4" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBaseBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBaseBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverlineText}">
                                        <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Live], Source={StaticResource LocalizedStrings}}" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBaseBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Unavailable], Source={StaticResource LocalizedStrings}}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBaseBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding [Dashboard.LivePerformance.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding CpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding CpuUsagePercent, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding GpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding GpuUsagePercent, Mode=OneWay}" Foreground="{DynamicResource InfoBaseBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" ToolTip="{Binding MemoryUsageDetailLabel}">
                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding MemoryUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding MemoryUsagePercent, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Disk], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding DiskUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding DiskUsagePercent, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Network], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="{Binding NetworkUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource InsetSurface}" Margin="0,0,0,10">
                <Grid Height="200">
                    <Grid Visibility="{Binding HasLiveMetricsSample, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:LivePerformanceChart Height="200"
                                                       Capacity="60"
                                                       SampleIntervalSeconds="1"
                                                       CpuValues="{Binding CpuUsageSeries}"
                                                       GpuValues="{Binding GpuUsageSeries}"
                                                       CpuBrush="{DynamicResource AccentBrush}"
                                                       GpuBrush="{DynamicResource InfoBaseBrush}"
                                                       GridBrush="{DynamicResource BorderSubtleBrush}"
                                                       LabelBrush="{DynamicResource TextTertiaryBrush}"
                                                       TooltipBackground="{DynamicResource Surface3Brush}"
                                                       TooltipBorderBrush="{DynamicResource BorderDefaultBrush}"
                                                       CpuLabel="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}"
                                                       GpuLabel="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}"
                                                       NowLabel="{Binding [Dashboard.LivePerformance.Now], Source={StaticResource LocalizedStrings}}"
                                                       AutomationProperties.Name="{Binding [Dashboard.LivePerformance.ChartDescription], Source={StaticResource LocalizedStrings}}" />
                        <TextBlock Text="{Binding LiveMetricsUpdatedLabel}" Style="{StaticResource CaptionText}" Margin="14,12" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLivePerformanceWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Dashboard.LivePerformance.Trend], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                        <Run Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CpuTrendLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Run Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding GpuTrendLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Seu computador: lista de definição, não painel paralelo. -->
            <TextBlock Text="{Binding [Dashboard.SystemOverview], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding [Dashboard.SystemOverview.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,0,0,16" TextWrapping="Wrap" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Dashboard.Processor], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,0,0,12" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource BodyText}" Margin="0,0,0,12" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Dashboard.GraphicsCard], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,0,0,12" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuDetail}" Style="{StaticResource BodyText}" Margin="0,0,0,12" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Dashboard.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,0,0,12" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Dashboard.Storage], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,0,0,12" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiskLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Dashboard.Windows], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WindowsLabel}" Style="{StaticResource BodyText}" TextWrapping="Wrap" ToolTip="{Binding WindowsLabel}" />
            </Grid>
            <TextBlock Text="{Binding ReadinessScoreExplanation}" Style="{StaticResource SecondaryText}" Margin="0,4,0,10" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Text="{Binding [Dashboard.LivePerformance.LocalOnly], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Espaço seguro para criadores: linhas, não sub-cards. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconStream}" Stroke="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="{Binding StreamingReadinessTitle}" Style="{StaticResource SectionText}" Margin="10,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding StreamingReadinessDetail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,4" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding StreamingReadinessItems}" ItemTemplate="{StaticResource StreamingRowTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
