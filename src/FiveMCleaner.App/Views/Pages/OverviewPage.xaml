<UserControl x:Class="FiveMCleaner.App.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <!--
        Folha de diagnóstico do redesign "prancheta técnica".

        A página inteira é uma folha que ocupa toda a área de conteúdo: bloco
        de legenda no topo, vista principal à esquerda e coluna de notas à
        direita. Não existe mais MaxWidth travando o conteúdo numa faixa de
        1100px no meio de uma janela de 3800px — era daí que vinha o vazio
        preto que ocupava metade da tela.

        O gráfico ao vivo fica numa linha "*": ele cresce para consumir a
        altura que sobrar, então a folha termina exatamente na borda da janela
        em qualquer resolução, sem faixa morta embaixo.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="StreamingRowTemplate">
            <Border Style="{StaticResource LedgerRowStyle}" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon16}" Data="{Binding IconKey, Converter={StaticResource GeometryKeyConverter}}"
                          Stroke="{Binding ToneBrushKey, Converter={StaticResource BrushKeyConverter}}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Slot de alerta condicional: só existe quando há algo real a dizer. -->
        <Border Grid.Row="0" Style="{StaticResource AlertRowInfoStyle}" Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource InfoBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UpdateBannerDetail}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    <ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Visibility="{Binding IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="{Binding UpdateActionLabel}" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="14,0"
                            IsEnabled="{Binding CanDownloadUpdate}" Click="DownloadUpdate_Click" />
                    <Button Content="{Binding UpdateReleaseNotesLabel}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"
                            IsEnabled="{Binding CanOpenReleaseNotes}" Click="OpenReleaseNotes_Click" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Visibility="{Binding IsUpdateCompletedBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="DismissCompletedUpdate_Click">
                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconClose}" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================= A folha ======================= -->
        <Border Grid.Row="1" Style="{StaticResource SheetSurface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Bloco de legenda: identifica a folha e carrega a ação de
                     recarga. Ocupa a largura inteira por construção. -->
                <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Dashboard.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding GreetingTitle}" Style="{StaticResource CaptionText}" />
                                <Rectangle Width="1" Height="10" Margin="10,0" Fill="{DynamicResource TickMarkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Dashboard.Eyebrow], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" />
                                <Rectangle Width="1" Height="10" Margin="10,0" Fill="{DynamicResource TickMarkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastScanLabel}" Style="{StaticResource TickLabelText}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="RefreshDiagnostic_Click" IsEnabled="{Binding CanRefresh}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding [Dashboard.Refresh], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Corpo da folha: vista principal + coluna de notas. -->
                <Grid Grid.Row="1" Background="{DynamicResource SheetGridBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="520" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ Vista principal ============ -->
                    <Grid Grid.Column="0" Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="176" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.7*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Prontidão: leitura de escala graduada. Substitui o
                             anel sobre o núcleo 3D do visual anterior — mesma
                             informação, custo gráfico zero, e lê como escala
                             de prancha em vez de medidor decorativo. -->
                        <Border Grid.Row="0" Style="{StaticResource HeroSurface}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Style="{StaticResource HeroAccentRule}" Margin="-12,4,0,4" />
                                <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Margin="0,0,6,0">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource Icon16}">
                                                    <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFiveMLegacyDetected}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding EditionLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        <Rectangle Width="1" Height="10" Margin="10,0" Fill="{DynamicResource TickMarkBrush}" VerticalAlignment="Center" />
                                        <Path Margin="0,0,6,0">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource Icon16}">
                                                    <Setter Property="Data" Value="{StaticResource IconClose}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGtaVLegacyDetected}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding GtaStatusLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding RecommendationTitle}" Style="{StaticResource DisplayText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="OpenOptimizer_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconBolt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding [Dashboard.OpenOptimizer], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="OpenHistory_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Escala de prontidão: readout tabular + régua
                                     graduada de 0 a 100 com marcação nos quartos. -->
                                <StackPanel Grid.Column="1" Width="320" Margin="48,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ReadinessScoreExplanation}">
                                    <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ReadinessScore, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" FontSize="46" FontWeight="SemiBold" LineHeight="52" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="/100" Style="{StaticResource TickLabelText}" VerticalAlignment="Bottom" Margin="6,0,0,9" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReadinessLevelLabel}" Style="{StaticResource BodyStrongText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,12" />
                                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Height="8" Value="{Binding ReadinessScore, Mode=OneWay}"
                                                 AutomationProperties.Name="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="0" Style="{StaticResource TickLabelText}" />
                                        <TextBlock Grid.Column="1" Text="25" Style="{StaticResource TickLabelText}" />
                                        <TextBlock Grid.Column="2" Text="50" Style="{StaticResource TickLabelText}" />
                                        <TextBlock Grid.Column="3" Text="75" Style="{StaticResource TickLabelText}" />
                                        <TextBlock Grid.Column="4" Text="100" Style="{StaticResource TickLabelText}" />
                                    </Grid>
                                </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Faixa de instrumentos: quatro fatos da varredura local. -->
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource InstrumentCellStyle}" Margin="0,0,20,0">
                                <TextBlock Text="{Binding [Dashboard.Kpi.Pressure.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding PerformancePressureLabel}" Style="{StaticResource MetricSmallText}" Margin="0,4,0,0"
                                           Foreground="{Binding PerformancePressureBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                                <TextBlock Text="{Binding [Dashboard.Readiness.LocalAnalysis], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource VerticalHairlineDivider}" Margin="0,2" />
                            <StackPanel Grid.Column="2" Style="{StaticResource InstrumentCellStyle}" Margin="20,0">
                                <TextBlock Text="{Binding [Dashboard.Kpi.Cores.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding LogicalProcessorLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LogicalProcessorDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource VerticalHairlineDivider}" Margin="0,2" />
                            <StackPanel Grid.Column="4" Style="{StaticResource InstrumentCellStyle}" Margin="20,0">
                                <TextBlock Text="{Binding [Dashboard.Kpi.Memory.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding AvailableMemoryLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AvailableMemoryDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="5" Style="{StaticResource VerticalHairlineDivider}" Margin="0,2" />
                            <StackPanel Grid.Column="6" Style="{StaticResource InstrumentCellStyle}" Margin="20,0,0,0">
                                <TextBlock Text="{Binding [Dashboard.Kpi.Cache.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding LegacyCacheLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LegacyCacheDetail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource HairlineDivider}" Margin="0,16,0,16" />

                        <!-- Desempenho ao vivo: cabeçalho + estado de coleta. -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="8,3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagChipStyle}">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LiveDot" Width="6" Height="6" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBaseBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBaseBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource OverlineText}">
                                                    <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Live], Source={StaticResource LocalizedStrings}}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBaseBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                            <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                            <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Unavailable], Source={StaticResource LocalizedStrings}}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBaseBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Cinco leituras ao vivo, uma por recurso. -->
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding CpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding CpuUsagePercent, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding GpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding GpuUsagePercent, Mode=OneWay}" Foreground="{DynamicResource InfoBaseBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,18,0" ToolTip="{Binding MemoryUsageDetailLabel}">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding MemoryUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding MemoryUsagePercent, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Disk], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding DiskUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,6" />
                                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Value="{Binding DiskUsagePercent, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Network], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding NetworkUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- O gráfico ocupa toda a altura restante da folha. -->
                        <Border Grid.Row="4" Style="{StaticResource InsetSurface}" Margin="0,14,0,0" ClipToBounds="True">
                            <Grid>
                                <Rectangle Fill="{DynamicResource SheetGridBrush}" />
                                <Grid Visibility="{Binding HasLiveMetricsSample, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:LivePerformanceChart Capacity="60"
                                                                   SampleIntervalSeconds="1"
                                                                   CpuValues="{Binding CpuUsageSeries}"
                                                                   GpuValues="{Binding GpuUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}"
                                                                   GpuBrush="{DynamicResource InfoBaseBrush}"
                                                                   GridBrush="{DynamicResource BorderSubtleBrush}"
                                                                   LabelBrush="{DynamicResource TextTertiaryBrush}"
                                                                   TooltipBackground="{DynamicResource Surface3Brush}"
                                                                   TooltipBorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                   CpuLabel="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}"
                                                                   GpuLabel="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}"
                                                                   NowLabel="{Binding [Dashboard.LivePerformance.Now], Source={StaticResource LocalizedStrings}}"
                                                                   AutomationProperties.Name="{Binding [Dashboard.LivePerformance.ChartDescription], Source={StaticResource LocalizedStrings}}" />
                                    <TextBlock Text="{Binding LiveMetricsUpdatedLabel}" Style="{StaticResource TickLabelText}" Margin="14,12" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsLivePerformanceWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Rodapé da vista: média e pico das mesmas amostras. -->
                        <Grid Grid.Row="5" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Trend], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                                    <Run Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CpuTrendLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontMono}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Run Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding GpuTrendLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource AppFontMono}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ============ Coluna de notas ============ -->
                    <!--
                        A lateral direita deixou de ser vazio: recebe a
                        especificação da máquina, a última execução registrada
                        e a leitura de risco para transmissão. Todo o conteúdo
                        já existia na página — só estava empilhado embaixo,
                        exigindo rolagem, enquanto meia tela sobrava ao lado.
                    -->
                    <Border Grid.Column="1" Style="{StaticResource NotesColumnSurface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding [Dashboard.SystemOverview], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" />
                                <TextBlock Text="{Binding [Dashboard.SystemOverview.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,12" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Dashboard.Processor], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,1,14,10" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Dashboard.GraphicsCard], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,1,14,10" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuDetail}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Dashboard.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,1,14,10" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Dashboard.Storage], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,1,14,10" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiskLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Dashboard.Windows], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WindowsLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" ToolTip="{Binding WindowsLabel}" />
                                </Grid>

                                <TextBlock Text="{Binding ReadinessScoreExplanation}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" TextWrapping="Wrap" />

                                <Border Style="{StaticResource HairlineDivider}" Margin="0,16" />

                                <!-- Última otimização registrada. -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Dashboard.LastRun.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastOptimizationDateLabel}" Style="{StaticResource TickLabelText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding LastOptimizationDateLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastOptimizationTitle}" Style="{StaticResource BodyStrongText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastOptimizationSummary}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0,2"
                                            Visibility="{Binding HasLastOptimization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OpenHistory_Click"
                                            Content="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" />
                                </StackPanel>

                                <Border Style="{StaticResource HairlineDivider}" Margin="0,16" />

                                <!-- Espaço seguro para criadores. -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconStream}" Stroke="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StreamingReadinessTitle}" Style="{StaticResource SubsectionText}" Margin="9,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StreamingReadinessDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,2" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding StreamingReadinessItems}" ItemTemplate="{StaticResource StreamingRowTemplate}" />
                                </StackPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding [Dashboard.LivePerformance.LocalOnly], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
