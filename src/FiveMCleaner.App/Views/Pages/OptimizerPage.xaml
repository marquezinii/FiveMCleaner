<UserControl x:Class="FiveMCleaner.App.Views.Pages.OptimizerPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <!--
        Folha de execução do redesign "prancheta técnica".

        Três faixas verticais que dividem a folha inteira:

          controle  — perfil, execução ou resultado (fase corrente);
          plano     — a TABELA de ações, sempre presente, ocupando a largura
                      que sobrar. É o "quadro de ações" da prancha: cada linha
                      tem ação, descrição, risco e privilégio em colunas
                      alinhadas;
          registro  — passo a passo ao vivo ou relatório final; a faixa só
                      existe quando há execução ou resultado, e some quando
                      não há (a coluna colapsa e o plano ocupa o lugar).

        No visual anterior tudo isso era uma única coluna de 1100px encostada
        à esquerda, com o restante da janela preto. Aqui não existe MaxWidth:
        a folha é a janela.
    -->
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedPlanActions" Source="{Binding DataContext.PlannedActions, ElementName=Root}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CategoryLabel" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="StageTickStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0.38" />
        </Style>

        <!--
            Linha da tabela de plano. As larguras são idênticas às do cabeçalho
            logo acima, então as colunas alinham sem SharedSizeScope: toda
            linha recebe a mesma largura disponível e resolve as mesmas
            proporções.
            Risco é lido por cor do texto + rótulo, nunca por faixa lateral.
        -->
        <DataTemplate x:Key="PlanActionTemplate">
            <Border Style="{StaticResource TableRowStyle}" Padding="0,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="3*" MinWidth="200" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="172" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,1,16,0" />
                    <TextBlock Grid.Column="2" Text="{Binding RiskLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Top" Margin="0,1,12,0"
                               Foreground="{Binding RiskBrushKey, Converter={StaticResource BrushKeyConverter}}" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.4" Margin="0,1,5,0" VerticalAlignment="Top"
                              Data="{StaticResource IconShield}" Stroke="{DynamicResource TextTertiaryBrush}"
                              Visibility="{Binding RequiresElevation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding PrivilegeLabel}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StepLedgerRowTemplate">
            <Border Style="{StaticResource TableRowStyle}" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.25"
                          Data="{Binding OutcomeGlyph, Converter={StaticResource GeometryKeyConverter}}"
                          Stroke="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyText}" Margin="10,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding OutcomeLabel}" Style="{StaticResource CaptionText}"
                               Foreground="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportLineRowTemplate">
            <Border Style="{StaticResource TableRowStyle}" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.25" VerticalAlignment="Top" Margin="0,2,0,0"
                          Data="{Binding OutcomeGlyph, Converter={StaticResource GeometryKeyConverter}}"
                          Stroke="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                    <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding ActionName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Reason, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding OutcomeLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Top"
                               Foreground="{Binding OutcomeBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,14,20,20">
        <Border Style="{StaticResource SheetSurface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Bloco de legenda: identificação da folha + trilha de fase. -->
                <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{Binding [Optimizer.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding PlanHeader}" Style="{StaticResource TickLabelText}" />
                                <Rectangle Width="1" Height="10" Margin="10,0" Fill="{DynamicResource TickMarkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Optimizer.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,22,0" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource StageTickStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOptimizerIdle}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Rectangle Width="28" Height="2" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Optimizer.Stage.Prepare], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,0,22,0" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource StageTickStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Rectangle Width="28" Height="2" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Optimizer.Stage.Run], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource StageTickStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReportAvailable}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Rectangle Width="28" Height="2" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [Optimizer.Stage.Result], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Corpo: controle | plano | registro -->
                <Grid Grid.Row="1" Background="{DynamicResource SheetGridBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ================ Faixa de controle ================ -->
                    <Border Grid.Column="0" Width="440" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,20,18,20">
                            <StackPanel>

                                <!-- Fase: Preparar -->
                                <StackPanel Visibility="{Binding IsOptimizerIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [Optimizer.Stage.Prepare], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,0,0,10" />
                                    <controls:SpectrumSelector x:Name="ProfileSpectrum"
                                                                Option0Label="{Binding [Profiles.Light.Name], Source={StaticResource LocalizedStrings}}"
                                                                Option1Label="{Binding [Profiles.Balanced.Name], Source={StaticResource LocalizedStrings}}"
                                                                Option2Label="{Binding [Profiles.Aggressive.Name], Source={StaticResource LocalizedStrings}}"
                                                                RecommendedLabel="{Binding [Profiles.RecommendedBadge], Source={StaticResource LocalizedStrings}}"
                                                                SelectionChanged="ProfileSpectrum_SelectionChanged" />
                                    <TextBlock Text="{Binding SelectedProfileName}" Style="{StaticResource PageTitleText}" Margin="0,20,0,0" />
                                    <TextBlock Text="{Binding ProfilePresentationBenefits}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />

                                    <Border Style="{StaticResource HairlineDivider}" Margin="0,18" />

                                    <StackPanel>
                                        <TextBlock Text="{Binding [Plan.VerifiedActions.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                        <TextBlock Text="{Binding SelectedActionCount}" Style="{StaticResource ReadoutSmallText}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding ProfilePresentationCategories}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding [Optimizer.Impact], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,18,0,0" />
                                        <TextBlock Text="{Binding ProfilePresentationImpact}" Style="{StaticResource BodyStrongText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding [Optimizer.Execution], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,18,0,0" />
                                        <TextBlock Text="{Binding ElevationLabel}" Style="{StaticResource BodyStrongText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SafetySummary}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding [Plan.OptimizeNow], Source={StaticResource LocalizedStrings}}"
                                            Margin="0,22,0,0" HorizontalAlignment="Stretch"
                                            Click="StartOptimization_Click" IsEnabled="{Binding CanStart}" />

                                    <Border Style="{StaticResource HairlineDivider}" Margin="0,22" />
                                    <TextBlock Text="{Binding [Safety.Limits.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding [Safety.Limits.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding [Safety.SnapshotRollback], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <!-- Fase: Executar -->
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [Optimizer.Stage.Run], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding SelectedProfileLabel}" Style="{StaticResource SubsectionText}" Margin="0,8,0,0" TextWrapping="Wrap" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ProgressPercentLabel}" Style="{StaticResource ReadoutText}" />
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding ElapsedTimeLabel}" Style="{StaticResource TickLabelText}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding RemainingTimeLabel}" Style="{StaticResource TickLabelText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource ProgressRailStyle}" Height="8" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,10,0,0" AutomationProperties.Name="{Binding ProgressPercentLabel}" />

                                    <StackPanel Margin="0,18,0,0">
                                        <TextBlock Text="{Binding [Progress.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                        <TextBlock Text="{Binding ProgressHeadline, Mode=OneWay}" Style="{StaticResource BodyStrongText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PreviousProgressHeadline, Mode=OneWay}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasPreviousProgressHeadline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>

                                    <Button Style="{StaticResource DangerGhostButtonStyle}" Content="{Binding [Progress.CancelAfterStep], Source={StaticResource LocalizedStrings}}"
                                            Margin="0,20,0,0" HorizontalAlignment="Stretch"
                                            Click="CancelOptimization_Click" IsEnabled="{Binding CanCancel}"
                                            AutomationProperties.Name="{Binding [Progress.CancelAfterStep], Source={StaticResource LocalizedStrings}}"
                                            AutomationProperties.HelpText="{Binding [Progress.CancelHelp], Source={StaticResource LocalizedStrings}}" />
                                    <TextBlock Text="{Binding [Progress.CancelHelp], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Fase: Resultado -->
                                <StackPanel Visibility="{Binding IsReportAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [Optimizer.Stage.Result], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,0,0,12" />
                                    <Border Padding="16" CornerRadius="{StaticResource RadiusMd}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReportSucceeded}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReportHasIsolatedFailures}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReportHasRollbackFailures}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.5" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconMarkFailed}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource DangerBaseBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReportSucceeded}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconMarkApplied}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource SuccessBaseBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReportHasIsolatedFailures}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconMarkWarning}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBaseBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionText}">
                                                            <Setter Property="Text" Value="{Binding [Optimizer.Result.Failed], Source={StaticResource LocalizedStrings}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReportSucceeded}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding [Optimizer.CompletedTitle], Source={StaticResource LocalizedStrings}}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReportHasIsolatedFailures}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding [Optimizer.Result.PartialTitle], Source={StaticResource LocalizedStrings}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReportSummaryLabel}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding ReportRestartLabel}" Style="{StaticResource SecondaryText}" Margin="0,14,0,0" TextWrapping="Wrap" />

                                    <StackPanel Margin="0,16,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding [Report.CopyButton], Source={StaticResource LocalizedStrings}}" HorizontalAlignment="Stretch" Click="CopyTechnicalReport_Click" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding [Report.SaveButton], Source={StaticResource LocalizedStrings}}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="SaveTechnicalReport_Click" IsEnabled="{Binding CanShareReport}" />
                                        <Button Style="{StaticResource LinkButtonStyle}" Content="{Binding [Report.ViewHistoryButton], Source={StaticResource LocalizedStrings}}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenHistory_Click" />
                                    </StackPanel>

                                    <!-- Comparação antes/depois. -->
                                    <StackPanel Visibility="{Binding IsComparisonAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Style="{StaticResource HairlineDivider}" Margin="0,18" />
                                        <TextBlock Text="{Binding [Comparison.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" />
                                        <TextBlock Text="{Binding ComparisonSummaryLabel}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ComparisonHardwareProfileLabel}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding [Comparison.RevertButton], Source={StaticResource LocalizedStrings}}" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                                Visibility="{Binding ComparisonRegressionSuspected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                IsEnabled="{Binding CanRevertLastOptimization}" Click="RevertLastOptimization_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ================ Faixa do plano ================ -->
                    <Grid Grid.Column="1" Margin="22,20,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Optimizer.PlanTitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ProfilePresentationCategories}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PlanNoticesText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding PlanNoticesText, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Cabeçalho da tabela: mesmas larguras do PlanActionTemplate. -->
                        <Border Grid.Row="1" Style="{StaticResource TableHeaderRowStyle}" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                    <ColumnDefinition Width="3*" MinWidth="200" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="172" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [Optimizer.Table.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding [Optimizer.Table.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Text="{Binding [Optimizer.Table.Risk], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3" Text="{Binding [Optimizer.Table.Privilege], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedPlanActions}}" ItemTemplate="{StaticResource PlanActionTemplate}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CanvasSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,7" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource OverlineText}" Foreground="{DynamicResource AccentTextBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================ Faixa de registro ================ -->
                    <!-- Existe só quando há execução ou resultado; caso contrário
                         a coluna colapsa e o plano ocupa toda a largura. -->
                    <Border Grid.Column="2" Width="420" Padding="20,20,18,18">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource NotesColumnSurface}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsReportAvailable}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubsectionText}">
                                        <Setter Property="Text" Value="{Binding [Progress.Title], Source={StaticResource LocalizedStrings}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReportAvailable}" Value="True">
                                                <Setter Property="Text" Value="{Binding [Optimizer.Stage.Result], Source={StaticResource LocalizedStrings}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl x:Name="StepLedgerList" ItemsSource="{Binding StepLedger}" ItemTemplate="{StaticResource StepLedgerRowTemplate}"
                                                  Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <!-- Falhas primeiro, sempre — nunca ler como sucesso quando há falha real. -->
                                    <ItemsControl ItemsSource="{Binding ReportLines}" ItemTemplate="{StaticResource ReportLineRowTemplate}"
                                                  Visibility="{Binding IsReportAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
