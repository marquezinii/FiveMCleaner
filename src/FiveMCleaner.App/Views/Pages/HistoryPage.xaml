<UserControl x:Class="FiveMCleaner.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <!--
        Folha de revisões do redesign "prancheta técnica".

        O histórico é literalmente a tabela de revisões de uma prancha: cada
        execução é uma revisão datada, com o que foi feito, o resultado e a
        possibilidade de voltar ao estado anterior.

        Esta era a aba com mais espaço morto do visual anterior: uma ilha de
        texto centralizada no meio de uma tela preta. Agora o cabeçalho da
        tabela e a coluna de notas existem mesmo sem nenhuma execução, então a
        folha está completa desde a primeira abertura — e a coluna de notas
        não é enchimento: explica exatamente o que o rollback preserva, que é
        a promessa central do produto.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border Style="{StaticResource TableRowStyle}" Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="188" />
                        <ColumnDefinition Width="2*" MinWidth="200" />
                        <ColumnDefinition Width="3*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DateLabel}" Style="{StaticResource TickLabelText}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                    <Button Grid.Column="3"
                            Content="{Binding [History.Undo], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="14,0" VerticalAlignment="Center"
                            Tag="{Binding}" Click="RollbackHistory_Click"
                            IsEnabled="{Binding CanRollback}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,14,20,20">
        <Border Style="{StaticResource SheetSurface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{Binding [History.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="{Binding [History.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [History.OpenLogs], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenLogs_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{DynamicResource SheetGridBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="520" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ Tabela de revisões ============ -->
                    <Grid Grid.Column="0" Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding [History.LocalRuns], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,12" />

                        <!-- Cabeçalho da tabela: mesmas larguras do HistoryRowTemplate.
                             Permanece visível mesmo sem execuções, para que a folha
                             mostre desde o início o que será registrado. -->
                        <Border Grid.Row="1" Style="{StaticResource TableHeaderRowStyle}" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="188" />
                                    <ColumnDefinition Width="2*" MinWidth="200" />
                                    <ColumnDefinition Width="3*" MinWidth="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [History.Table.Date], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding [History.Table.Run], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Text="{Binding [History.Table.Summary], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="3" Text="{Binding [History.Table.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" MinWidth="86" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HistoryItems.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=invert}">
                                <ItemsControl ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource HistoryRowTemplate}" HorizontalAlignment="Stretch">
                                    <!-- Sem isto, cada item usa só a largura intrínseca do
                                         conteúdo (o ContentPresenter padrão do ItemsControl
                                         não estica) — as colunas não alinhariam com o
                                         cabeçalho. -->
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Estado vazio: fica logo abaixo do cabeçalho da tabela,
                                 alinhado à esquerda como a primeira linha ausente —
                                 não uma ilha flutuando no centro da tela. -->
                            <Border Style="{StaticResource FieldSurface}" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="620" Margin="0,24,0,0"
                                    Visibility="{Binding HistoryItems.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                                <StackPanel>
                                <TextBlock Text="{Binding [History.Empty.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [History.Empty.Summary], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [History.Empty.Detail], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <Button Content="{Binding [History.Empty.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenOptimizer_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============ Coluna de notas ============ -->
                    <Border Grid.Column="1" Style="{StaticResource NotesColumnSurface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding [History.Notes.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" TextWrapping="Wrap" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconHistory}" Stroke="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding [History.Notes.Recorded], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}" Stroke="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding [History.Notes.Rollback], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding [History.Notes.Local], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" TextWrapping="Wrap" />
                                </Grid>

                                <Border Style="{StaticResource HairlineDivider}" Margin="0,18" />

                                <TextBlock Text="{Binding [Safety.Limits.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding [Safety.Limits.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
