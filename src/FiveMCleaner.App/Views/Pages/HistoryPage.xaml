<UserControl x:Class="FiveMCleaner.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900">
    <UserControl.Resources>
        <DataTemplate x:Key="HistoryLedgerRowTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Rail da timeline: linha vertical + nó por entrada. -->
                <Grid Grid.Column="0">
                    <Border Width="1" Background="{DynamicResource BorderSubtleBrush}" HorizontalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource CanvasBaseBrush}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,20,0,0" />
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource LedgerRowStyle}" Margin="16,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource OverlineText}" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding [History.Undo], Source={StaticResource LocalizedStrings}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34" Padding="14,0" VerticalAlignment="Center"
                                Tag="{Binding}" Click="RollbackHistory_Click"
                                IsEnabled="{Binding CanRollback}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [History.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding [History.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding [History.OpenLogs], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Click="OpenLogs_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HistoryItems.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=invert}">
                <ItemsControl ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource HistoryLedgerRowTemplate}" HorizontalAlignment="Stretch">
                    <!-- Sem isto, cada item usa só a largura intrínseca do
                         conteúdo (o ContentPresenter padrão do ItemsControl
                         não estica) — a linha e o hairline ficam curtos
                         mesmo com o ItemsControl largo. -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                        Visibility="{Binding HistoryItems.Count, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                <Path Width="48" Height="48" Data="{StaticResource IconCoreSilhouette}" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                      HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock Text="{Binding [History.Empty.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" />
                <TextBlock Text="{Binding [History.Empty.Summary], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding [History.Empty.Detail], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="{Binding [History.Empty.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="OpenOptimizer_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
