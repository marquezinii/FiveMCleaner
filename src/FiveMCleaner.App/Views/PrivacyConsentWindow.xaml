<Window x:Class="FiveMCleaner.App.Views.PrivacyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding [PrivacyConsent.WindowTitle], Source={StaticResource LocalizedStrings}}"
        Icon="/FiveMCleaner;component/Assets/FiveMCleaner.png"
        Width="540"
        Height="680"
        MinWidth="460"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Background="{DynamicResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#1837C889">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GreenBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [PrivacyConsent.WindowTitle], Source={StaticResource LocalizedStrings}}" Margin="10,0,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource WindowButtonStyle}" Click="Close_Click" ToolTip="{Binding [Window.Close], Source={StaticResource LocalizedStrings}}">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,22,28,20">
                    <TextBlock Text="{Binding HeadingText}"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IntroText}"
                               Margin="0,8,0,20"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               LineHeight="17"
                               TextWrapping="Wrap" />

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,11">
                        <CheckBox x:Name="TelemetryCheckBox"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="{Binding [PrivacyConsent.Telemetry.Title], Source={StaticResource LocalizedStrings}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [PrivacyConsent.Telemetry.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [PrivacyConsent.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,18">
                        <CheckBox x:Name="CrashReportsCheckBox"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="{Binding [PrivacyConsent.CrashReports.Title], Source={StaticResource LocalizedStrings}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [PrivacyConsent.CrashReports.Title], Source={StaticResource LocalizedStrings}}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [PrivacyConsent.CrashReports.Description], Source={StaticResource LocalizedStrings}}" Margin="0,3,0,0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="{Binding [Privacy.Collects.Title], Source={StaticResource LocalizedStrings}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
                    <TextBlock Text="{Binding [Privacy.Collects.Items], Source={StaticResource LocalizedStrings}}" Margin="0,5,0,14" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Title], Source={StaticResource LocalizedStrings}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}" />
                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Items], Source={StaticResource LocalizedStrings}}" Margin="0,5,0,0" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <Grid Margin="20,0">
                    <Button x:Name="ContinueButton"
                            Content="{Binding [PrivacyConsent.Continue], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Height="40"
                            Padding="24,0"
                            IsDefault="True"
                            Click="Continue_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
