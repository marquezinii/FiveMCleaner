<ui:FluentWindow x:Class="FiveMCleaner.App.Views.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sua conta" Width="440" Height="560" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowBackdropType="Mica">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Entre na sua conta" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="Acesse sua experiência FiveMCleaner em segurança." Margin="0,8,0,22" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                <TextBlock Text="Nome"/><TextBox x:Name="FirstNameBox" Margin="0,5,0,12" />
                <TextBlock Text="Sobrenome"/><TextBox x:Name="LastNameBox" Margin="0,5,0,12" />
            </StackPanel>
            <TextBlock Text="E-mail"/><TextBox x:Name="EmailBox" Margin="0,5,0,12" />
            <TextBlock Text="Senha"/><PasswordBox x:Name="PasswordBox" Margin="0,5,0,12" />
            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock Text="Confirmar senha"/><PasswordBox x:Name="ConfirmPasswordBox" Margin="0,5,0,12" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#E85C4A" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button x:Name="SubmitButton" Content="Entrar" Height="40" Click="Submit_Click" />
            <Button x:Name="SwitchButton" Content="Ainda não tem conta? Criar conta" Margin="0,10,0,0" Click="Switch_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
