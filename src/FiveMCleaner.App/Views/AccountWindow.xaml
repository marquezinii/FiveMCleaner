<ui:FluentWindow x:Class="FiveMCleaner.App.Views.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sua conta"
    Icon="/FiveMCleaner;component/Assets/FiveMCleaner.png"
    Width="500"
    Height="570"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    KeyboardNavigation.TabNavigation="Cycle"
    Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,18">
            <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource ChipBrush}" HorizontalAlignment="Left">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Text="Entre na sua conta" Margin="0,16,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="Acesse sua experiência FiveMCleaner com segurança." Margin="0,7,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,22">
                <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock FontWeight="SemiBold"><Run Text="Nome" /><Run Text=" *" Foreground="{DynamicResource RedBrush}" /></TextBlock>
                    <TextBox x:Name="FirstNameBox" Height="38" Margin="0,6,0,13" MaxLength="80" AutomationProperties.Name="Nome obrigatório" />

                    <TextBlock FontWeight="SemiBold"><Run Text="Sobrenome" /><Run Text=" *" Foreground="{DynamicResource RedBrush}" /></TextBlock>
                    <TextBox x:Name="LastNameBox" Height="38" Margin="0,6,0,13" MaxLength="80" AutomationProperties.Name="Sobrenome obrigatório" />

                    <TextBlock FontWeight="SemiBold"><Run Text="Nome de usuário" /><Run Text=" *" Foreground="{DynamicResource RedBrush}" /></TextBlock>
                    <TextBox x:Name="UsernameBox" Height="38" Margin="0,6,0,0" MaxLength="30" CharacterCasing="Lower" AutomationProperties.Name="Nome de usuário obrigatório" />
                    <TextBlock Text="Use de 3 a 30 letras, números, ponto ou sublinhado." Margin="0,4,0,13" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock FontWeight="SemiBold"><Run Text="E-mail" /><Run Text=" *" Foreground="{DynamicResource RedBrush}" /></TextBlock>
                <TextBox x:Name="EmailBox" Height="38" Margin="0,6,0,13" MaxLength="254" AutomationProperties.Name="E-mail obrigatório" />

                <TextBlock FontWeight="SemiBold"><Run Text="Senha" /><Run Text=" *" Foreground="{DynamicResource RedBrush}" /></TextBlock>
                <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,6,0,0" MaxLength="1024" AutomationProperties.Name="Senha obrigatória" />
                <TextBlock x:Name="PasswordHelpText" Text="Use sua senha cadastrada." Margin="0,4,0,13" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10.5" />

                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock FontWeight="SemiBold"><Run Text="Repetir senha" /><Run Text=" *" Foreground="{DynamicResource RedBrush}" /></TextBlock>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="38" Margin="0,6,0,15" MaxLength="1024" AutomationProperties.Name="Confirmação de senha obrigatória" />
                </StackPanel>

                <Grid x:Name="TermsPanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="TermsCheckBox" Width="24" Height="24" VerticalAlignment="Top" AutomationProperties.Name="Concordo com os Termos de Uso obrigatórios" />
                    <TextBlock Grid.Column="1" Margin="8,1,0,0" TextWrapping="Wrap" LineHeight="18">
                        <Run Text="Li e concordo com os " />
                        <Hyperlink Click="Terms_Click" Foreground="{DynamicResource BlueBrush}" TextDecorations="Underline">Termos de Uso</Hyperlink>
                        <Run Text=" e com o tratamento dos dados da conta descrito neles." />
                        <Run Text=" *" Foreground="{DynamicResource RedBrush}" FontWeight="Bold" />
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource RedBrush}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="32,18">
            <StackPanel>
                <Button x:Name="SubmitButton" Content="Entrar" Style="{StaticResource PrimaryButtonStyle}" Height="42" IsDefault="True" Click="Submit_Click" />
                <Button x:Name="SwitchButton" Content="Ainda não tem conta? Criar conta" Margin="0,10,0,0" Height="36" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" Cursor="Hand" Click="Switch_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
