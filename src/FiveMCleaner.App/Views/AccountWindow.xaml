<ui:FluentWindow x:Class="FiveMCleaner.App.Views.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sua conta" Icon="/FiveMCleaner;component/Assets/FiveMCleaner.png"
    Width="540" Height="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
    FontFamily="Segoe UI Variable Text, Segoe UI" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" Text="Entre na sua conta" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Acesse o FiveMCleaner com segurança." Margin="0,6,0,18" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <StackPanel x:Name="AuthenticationPanel">
                <StackPanel x:Name="RegistrationOnlyPanel" Visibility="Collapsed"><TextBlock Text="Crie sua conta com nome, nome de usuário, e-mail e senha. A verificação do e-mail é obrigatória." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
                <StackPanel x:Name="ProfileFieldsPanel" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock FontWeight="SemiBold">Nome</TextBlock><TextBox x:Name="FirstNameBox" Height="38" Margin="0,6,0,13" MaxLength="60" AutomationProperties.Name="Nome"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock FontWeight="SemiBold">Sobrenome</TextBlock><TextBox x:Name="LastNameBox" Height="38" Margin="0,6,0,13" MaxLength="60" AutomationProperties.Name="Sobrenome"/></StackPanel>
                    </Grid>
                    <TextBlock FontWeight="SemiBold">Nome de usuário</TextBlock>
                    <TextBox x:Name="UsernameBox" Height="38" Margin="0,6,0,4" MaxLength="24" AutomationProperties.Name="Nome de usuário"/>
                    <TextBlock Text="3 a 24 caracteres: comece com uma letra; use apenas letras, números e &quot;_&quot;." Margin="0,0,0,13" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel x:Name="CredentialFieldsPanel">
                    <TextBlock FontWeight="SemiBold">E-mail</TextBlock><TextBox x:Name="EmailBox" Height="38" Margin="0,6,0,13" MaxLength="254" AutomationProperties.Name="E-mail"/>
                    <TextBlock FontWeight="SemiBold">Senha</TextBlock><PasswordBox x:Name="PasswordBox" Height="38" Margin="0,6,0,4" MaxLength="128" AutomationProperties.Name="Senha" PasswordChanged="PasswordChanged"/>
                    <TextBlock x:Name="PasswordPolicyText" Visibility="Collapsed" Text="A senha deve possuir pelo menos 12 caracteres." Margin="0,0,0,13" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed"><TextBlock FontWeight="SemiBold">Repetir senha</TextBlock><PasswordBox x:Name="ConfirmPasswordBox" Height="38" Margin="0,6,0,13" MaxLength="128" AutomationProperties.Name="Confirmação de senha"/></StackPanel>
                    <CheckBox x:Name="KeepSignedInBox" Content="Manter conectado neste computador" IsChecked="True" Margin="0,0,0,12"/>
                </StackPanel>
                <StackPanel x:Name="TermsPanel" Visibility="Collapsed" Margin="0,0,0,12"><CheckBox x:Name="TermsCheckBox" Content="Li e concordo com os Termos de Uso"/><TextBlock Margin="24,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"><Hyperlink Click="Terms_Click">Ler os Termos de Uso</Hyperlink></TextBlock></StackPanel>
                <Button x:Name="ResetPasswordButton" Content="Esqueci minha senha" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="{DynamicResource BlueBrush}" Click="ResetPassword_Click"/>
            </StackPanel>
            <StackPanel x:Name="VerificationPanel" Visibility="Collapsed"><TextBlock Text="Verifique seu e-mail para continuar" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="VerificationDetailText" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/><Button Content="Reenviar e-mail de verificação" Click="ResendVerification_Click"/><Button Content="Já verifiquei meu e-mail" Margin="0,10,0,0" Click="RefreshVerification_Click"/></StackPanel>
            <StackPanel x:Name="ManagementPanel" Visibility="Collapsed"><TextBlock x:Name="SignedInEmailText" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Nova senha" FontWeight="SemiBold"/><PasswordBox x:Name="NewPasswordBox" Height="38" Margin="0,6,0,10" MaxLength="128"/><TextBlock Text="Confirme sua senha atual para alterações sensíveis" FontWeight="SemiBold"/><PasswordBox x:Name="CurrentPasswordBox" Height="38" Margin="0,6,0,10" MaxLength="128"/><Button Content="Alterar senha" Click="ChangePassword_Click"/><Separator Margin="0,18"/><TextBlock Text="Novo e-mail" FontWeight="SemiBold"/><TextBox x:Name="NewEmailBox" Height="38" Margin="0,6,0,10" MaxLength="254"/><Button Content="Alterar e-mail" Click="ChangeEmail_Click"/><Separator Margin="0,18"/><Button Content="Excluir conta" Foreground="{DynamicResource RedBrush}" Click="DeleteAccount_Click"/></StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="SubmitButton" Content="Entrar" Height="42" Style="{StaticResource PrimaryButtonStyle}" Click="Submit_Click"/><Button x:Name="SwitchButton" Content="Ainda não tem conta? Criar conta" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BlueBrush}" Click="Switch_Click"/><Button x:Name="LogoutButton" Visibility="Collapsed" Content="Sair da conta" Margin="0,10,0,0" Click="Logout_Click"/></StackPanel>
    </Grid>
</ui:FluentWindow>
