<ui:FluentWindow x:Class="FiveMCleaner.App.Views.OptimizationConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FiveMCleaner"
        Icon="/FiveMCleaner;component/Assets/FiveMCleaner.png"
        Width="470"
        Height="265"
        MinWidth="420"
        MinHeight="245"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CanvasBaseBrush}">

    <Border Background="{DynamicResource Surface1Brush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <ui:TitleBar Background="{DynamicResource SurfaceRailBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                   >
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource AccentWashBrush}">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconAlertTriangle}" Stroke="{DynamicResource AccentBrightBrush}" />
                        </Border>
                        <TextBlock Text="{Binding TitleText}"
                                   Margin="11,0,0,0"
                                   Style="{StaticResource BodyStrongText}"
                                   FontSize="15"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <Grid Grid.Row="1" Margin="24,21,24,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SuccessSurfaceBrush}" VerticalAlignment="Top">
                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding MessageText}"
                           Style="{StaticResource SecondaryText}"
                           FontSize="12"
                           LineHeight="18"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceRailBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Content="{Binding KeepWorkingText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            Margin="0,0,9,0"
                            IsCancel="True"
                            Click="Dismiss_Click" />
                    <Button Content="{Binding ConfirmText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38"
                            Padding="17,0"
                            IsDefault="True"
                            Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
