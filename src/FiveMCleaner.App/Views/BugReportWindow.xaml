<ui:FluentWindow x:Class="FiveMCleaner.App.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding [BugReport.WindowTitle], Source={StaticResource LocalizedStrings}}"
        Icon="/FiveMCleaner;component/Assets/FiveMCleaner.png"
        Width="680"
        Height="660"
        MinWidth="560"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CanvasBaseBrush}">

    <Border Background="{DynamicResource CanvasBaseBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <ui:TitleBar Background="{DynamicResource SurfaceRailBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource AccentWashBrush}">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconAlertTriangle}" Stroke="{DynamicResource AccentBrightBrush}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [BugReport.Link], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                            <TextBlock Text="{Binding [BugReport.FormLanguage], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,20">
                    <TextBlock Text="{Binding [BugReport.Heading], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding [BugReport.Intro], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,6,0,18" />

                    <Border Style="{StaticResource AlertRowStyle}" Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" Padding="13" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [BugReport.Privacy], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [BugReport.Category.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                    <WrapPanel x:Name="CategoryPanel" Margin="0,0,0,9">
                        <RadioButton GroupName="BugCategory" Style="{StaticResource SegmentedOptionStyle}" Tag="{Binding [BugReport.Category.Optimization], Source={StaticResource LocalizedStrings}}" Content="{Binding [BugReport.Category.Optimization], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource SegmentedOptionStyle}" Tag="{Binding [BugReport.Category.Games], Source={StaticResource LocalizedStrings}}" Content="{Binding [BugReport.Category.Games], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource SegmentedOptionStyle}" Tag="{Binding [BugReport.Category.Windows], Source={StaticResource LocalizedStrings}}" Content="{Binding [BugReport.Category.Windows], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource SegmentedOptionStyle}" Tag="{Binding [BugReport.Category.Interface], Source={StaticResource LocalizedStrings}}" Content="{Binding [BugReport.Category.Interface], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource SegmentedOptionStyle}" Tag="{Binding [BugReport.Category.Crash], Source={StaticResource LocalizedStrings}}" Content="{Binding [BugReport.Category.Crash], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource SegmentedOptionStyle}" Tag="{Binding [BugReport.Category.Other], Source={StaticResource LocalizedStrings}}" Content="{Binding [BugReport.Category.Other], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                    </WrapPanel>

                    <TextBlock Text="{Binding [BugReport.BugCode.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                    <ComboBox x:Name="BugCodeComboBox" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,0,15" SelectionChanged="BugCode_SelectionChanged" />

                    <TextBlock Text="{Binding [BugReport.Summary.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SummaryTextBox" Style="{StaticResource FormTextBoxStyle}" MaxLength="120" ToolTip="{Binding [BugReport.Summary.Tooltip], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock Text="{Binding [BugReport.Summary.Example], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                    <TextBlock Text="{Binding [BugReport.Description.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="DescriptionTextBox" Style="{StaticResource FormTextBoxStyle}" MinHeight="128" MaxHeight="210" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="{Binding [BugReport.Description.Tooltip], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock Text="{Binding [BugReport.Description.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                    <TextBlock Text="{Binding [BugReport.Log.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="LogTextBox" Style="{StaticResource FormTextBoxStyle}" MinHeight="80" MaxHeight="150" MaxLength="100000" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding [BugReport.Log.Tooltip], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock Text="{Binding [BugReport.Log.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                    <TextBlock Text="{Binding [BugReport.Email.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource FormTextBoxStyle}" MaxLength="254" ToolTip="{Binding [BugReport.Email.Tooltip], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock Text="{Binding [BugReport.Email.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0" Padding="0,0,0,13">
                        <CheckBox x:Name="IncludeTechnicalInfoCheckBox" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="{Binding [BugReport.Technical.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding [BugReport.Technical.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border x:Name="StatusBorder" Background="{DynamicResource CanvasSunkenBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="11" Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceRailBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13">
                <Grid Margin="20,0">
                    <Button x:Name="CopyButton" Content="{Binding [BugReport.Copy], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Click="Copy_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding [BugReport.Cancel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="17,0" Margin="0,0,9,0" Click="Close_Click" />
                        <Button x:Name="SendButton" Content="{Binding [BugReport.Send], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" Click="Send_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
