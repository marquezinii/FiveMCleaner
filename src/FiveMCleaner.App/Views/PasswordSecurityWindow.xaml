<ui:FluentWindow x:Class="FiveMCleaner.App.Views.PasswordSecurityWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:FiveMCleaner.App.Controls"
                 Title="{Binding [PasswordSecurity.WindowTitle], Source={StaticResource LocalizedStrings}}"
                 Icon="/FiveMCleaner;component/Assets/FiveMCleaner.png"
                 Width="520"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="{StaticResource AppFontBody}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Background="{DynamicResource CanvasBaseBrush}">

    <Border Style="{StaticResource FloatingSurface}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <ui:TitleBar Background="{DynamicResource SurfaceRailBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         BorderThickness="0,0,0,1"
                         ShowMaximize="False"
                         ShowMinimize="False">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource AccentWashBrush}">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentBrightBrush}" />
                        </Border>
                        <TextBlock x:Name="TitleBarText" Margin="11,0,0,0" Style="{StaticResource BodyStrongText}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <StackPanel Grid.Row="1" Margin="28,24,28,26">
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionText}" FontSize="20" />
                <TextBlock x:Name="SubtitleText" Margin="0,7,0,22" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />

                <Border x:Name="StatusPanel" Style="{StaticResource AlertRowStyle}" Visibility="Collapsed" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="StatusIcon" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource SecondaryText}" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel x:Name="CurrentPasswordPanel" Margin="0,0,0,18">
                    <TextBlock Text="{Binding [Settings.Account.CurrentPasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <controls:RevealPasswordBox x:Name="CurrentPasswordField"
                                                Placeholder="{Binding [PasswordSecurity.CurrentPasswordPlaceholder], Source={StaticResource LocalizedStrings}}"
                                                AutomationProperties.Name="{Binding [Settings.Account.CurrentPasswordLabel], Source={StaticResource LocalizedStrings}}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{Binding [Settings.Account.NewPasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <controls:RevealPasswordBox x:Name="NewPasswordField"
                                                Placeholder="{Binding [Account.Credentials.PasswordPlaceholderRegister], Source={StaticResource LocalizedStrings}}"
                                                PasswordChanged="Password_Changed"
                                                AutomationProperties.Name="{Binding [Settings.Account.NewPasswordLabel], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock x:Name="PasswordPolicyText" Margin="2,7,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Binding [PasswordSecurity.ConfirmPasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <controls:RevealPasswordBox x:Name="ConfirmPasswordField"
                                                Placeholder="{Binding [Account.Credentials.ConfirmPasswordPlaceholder], Source={StaticResource LocalizedStrings}}"
                                                PasswordChanged="Password_Changed"
                                                AutomationProperties.Name="{Binding [PasswordSecurity.ConfirmPasswordLabel], Source={StaticResource LocalizedStrings}}" />
                </StackPanel>

                <Grid x:Name="GoogleConfirmationPanel" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource GoogleLogoImage}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1"
                               Margin="11,0,0,0"
                               Text="{Binding [PasswordSecurity.GoogleConfirmation], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceRailBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Content="{Binding [PasswordSecurity.Cancel], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            Margin="0,0,9,0"
                            IsCancel="True" />
                    <Button x:Name="SubmitButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38"
                            Padding="17,0"
                            IsDefault="True"
                            Click="Submit_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
