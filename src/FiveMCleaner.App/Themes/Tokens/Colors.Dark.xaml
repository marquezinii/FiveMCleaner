<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema escuro. Uma única fonte de verdade:
        ThemeManager troca este dicionário por Colors.Light.xaml inteiro,
        nunca sobrescreve chave a chave. Nenhuma página deve referenciar um
        valor hexadecimal diretamente; sempre um destes DynamicResource.

        Redesign "Bancada de tuning premium": grafite quase preto + laranja
        de instrumento (mesmo #FF7A18 já usado no glow não-temável do
        CoreVisual, ver Controls/CoreVisual.cs) como único acento de ignição,
        mais uma família de metal escovado (Steel*/MetalEdgeBrush/
        InstrumentBezelBrush) reservada a momentos de destaque — nunca
        espalhada pela interface inteira.
    -->

    <Color x:Key="CanvasBaseColor">#0A0B0D</Color>
    <Color x:Key="CanvasSunkenColor">#060708</Color>
    <Color x:Key="Surface1Color">#121317</Color>
    <Color x:Key="Surface2Color">#181A1F</Color>
    <Color x:Key="Surface3Color">#1F2229</Color>
    <Color x:Key="SurfaceRailColor">#0D0E11</Color>
    <Color x:Key="SurfaceAccentWashColor">#1D140C</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1D2025" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#262A31" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#343941" />

    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.38" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Metal escovado: reservado a bordas de painéis-herói e ao bezel dos
         instrumentos (ArcProgress). Nunca usado como cor de texto ou fundo
         de superfície comum — é o segundo material da marca, não um cinza
         genérico a mais. -->
    <SolidColorBrush x:Key="SteelBrush" Color="#949CA8" />
    <SolidColorBrush x:Key="SteelDeepBrush" Color="#4B515A" />
    <LinearGradientBrush x:Key="MetalEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B2F35" Offset="0" />
        <GradientStop Color="#7C8794" Offset="0.5" />
        <GradientStop Color="#23262B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InstrumentBezelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E323A" Offset="0" />
        <GradientStop Color="#6B7480" Offset="0.5" />
        <GradientStop Color="#262A31" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A2A9B5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7B8391" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#1A0E04" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF7A18" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF7A18" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#FFA24D" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#8A3E08" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#1FFF7A18" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA24D" Offset="0" />
        <GradientStop Color="#FF7A18" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#35C98A" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#0F2419" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#1C4A36" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#E9B23C" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#2A2110" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#55401A" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#F2545B" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#2A1315" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5A2529" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#5AA2FF" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#0F1D2E" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#1E3A5C" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#A98BFF" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#8A93A1" />

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#282C34" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3F49" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#565D68" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FF7A18" />

    <DropShadowEffect x:Key="Elevation2Shadow" Color="#000000" Opacity="0.26" BlurRadius="24" ShadowDepth="6" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#000000" Opacity="0.40" BlurRadius="48" ShadowDepth="14" Direction="270" />
</ResourceDictionary>
