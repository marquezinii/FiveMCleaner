<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema escuro. Uma única fonte de verdade:
        ThemeManager troca este dicionário por Colors.Light.xaml inteiro,
        nunca sobrescreve chave a chave. Nenhuma página deve referenciar um
        valor hexadecimal diretamente; sempre um destes DynamicResource.

        Redesign "prancheta técnica" (2026): a interface é uma prancha de
        desenho técnico, não uma bancada de metal. O fundo é grafite azulado
        frio — nunca preto puro, que cansa a vista e some com as hairlines —
        e a folha de trabalho fica um degrau acima da mesa.

        Estratégia de cor: contida. Neutros cobrem praticamente toda a
        superfície e um único acento — o ciano de tinta técnica — carrega
        interação: foco, seleção, estado ativo, ação primária e leitura de
        progresso. Cor saturada nunca preenche superfície grande.

        O laranja da marca (#FF7A18, do logo) permanece um compromisso de
        marca e continua existindo em BrandInkBrush, mas restrito ao logotipo
        na barra de título. Ele saiu da interface porque laranja saturado
        sobre fundo escuro lê como alerta permanente e era a principal fonte
        do cansaço visual do visual anterior.
    -->

    <!-- Mesa (fora da folha), folha e degraus de elevação sobre a folha. -->
    <Color x:Key="CanvasBaseColor">#0B0E13</Color>
    <Color x:Key="CanvasSunkenColor">#070910</Color>
    <Color x:Key="Surface1Color">#11151C</Color>
    <Color x:Key="Surface2Color">#171C25</Color>
    <Color x:Key="Surface3Color">#1E2531</Color>
    <Color x:Key="SurfaceRailColor">#090C11</Color>
    <Color x:Key="SurfaceAccentWashColor">#0D161C</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <!-- Pesos de traço, na lógica de desenho técnico: fina divide, média
         contorna, grossa delimita o que é operável. -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1A202A" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#232B37" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#333D4C" />

    <!-- Aresta de luz no topo de superfícies elevadas. Substitui a antiga
         borda de metal escovado, que foi removida com o visual anterior. -->
    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.32" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Retícula da prancha: grade de fundo da folha, quase imperceptível.
         É o que impede a área de trabalho de ler como vazio morto. -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#151B24" />
    <SolidColorBrush x:Key="TickMarkBrush" Color="#242C38" />

    <!--
        Retícula da prancha. Papel milimetrado, não "grade gamer": pontos de
        1px a cada 24px, com contraste baixíssimo. Existe para que a área de
        trabalho tenha material em vez de ler como um vazio preto — o defeito
        mais visível do visual anterior. É um DrawingBrush estático e ladrilhado
        (a GPU o cacheia), não uma animação.
        Precisa viver em cada dicionário de tema porque o pincel congela a cor
        no momento em que é criado e o tema é trocado por dicionário inteiro.
    -->
    <DrawingBrush x:Key="SheetGridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#252E3C">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,1,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E5EAF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A4B6" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7B8698" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#05171D" />

    <!-- Tinta técnica: o único acento saturado da interface. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3E9FBA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#58B8D2" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#7CCEE3" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1C4E5D" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#223E9FBA" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3E9FBA" Offset="0" />
        <GradientStop Color="#7CCEE3" Offset="1" />
    </LinearGradientBrush>

    <!-- Cor da marca. Exclusiva do logotipo na barra de título; nenhuma
         página, controle ou estado pode usá-la. Ver DESIGN.md. -->
    <SolidColorBrush x:Key="BrandInkBrush" Color="#FF7A18" />

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#4FB783" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#0D1F17" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#1E4433" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#D9A441" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#211A0C" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4A3A16" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#E0616A" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#221114" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4E2429" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#5B87C4" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#0E1620" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#23364E" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#9A8CD6" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#7E8A9C" />

    <!-- Interruptor no padrão Fluent do Windows 11: trilho vazado com borda
         quando desligado, preenchido com o acento quando ligado. Thumb
         pequeno, nunca a bolinha larga do visual anterior. -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleTrackOffHoverBrush" Color="#141922" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#B9C4D3" />
    <SolidColorBrush x:Key="ToggleThumbOnBrush" Color="#F1F6FB" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2B3441" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#404C5D" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#58B8D2" />

    <DropShadowEffect x:Key="Elevation2Shadow" Color="#000000" Opacity="0.34" BlurRadius="20" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#000000" Opacity="0.50" BlurRadius="40" ShadowDepth="10" Direction="270" />
</ResourceDictionary>
