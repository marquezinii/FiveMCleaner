<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Redesign "prancheta técnica": a escala de raio é de desenho técnico,
        não de app de consumo. Cantos quase retos, nunca oval nem "bolha".
        RadiusPill sobrevive apenas para o trilho/thumb do interruptor e para
        o avatar circular — nenhum card, campo, trilho de progresso ou botão
        pode usá-lo.
    -->
    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusLg">6</CornerRadius>
    <CornerRadius x:Key="RadiusXl">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
</ResourceDictionary>
