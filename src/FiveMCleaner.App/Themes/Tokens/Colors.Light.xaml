<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema claro. Não é a inversão matemática do
        escuro: a elevação sobe em brilho (não desce) e os poços descem em vez
        de subir. Mesmas chaves do Colors.Dark.xaml — só o valor muda.

        Redesign "prancheta técnica": aqui a metáfora fica literal — a folha é
        papel de desenho. Deliberadamente não é branco puro: o papel é um
        cinza-neutro frio de baixo brilho, porque claridade excessiva foi um
        problema real relatado no visual anterior. A tinta técnica ciano
        escurece para manter contraste sobre papel.
    -->

    <Color x:Key="CanvasBaseColor">#E7EAEF</Color>
    <Color x:Key="CanvasSunkenColor">#DCE0E8</Color>
    <Color x:Key="Surface1Color">#F5F7FA</Color>
    <Color x:Key="Surface2Color">#FBFCFD</Color>
    <Color x:Key="Surface3Color">#FFFFFF</Color>
    <Color x:Key="SurfaceRailColor">#EDEFF4</Color>
    <Color x:Key="SurfaceAccentWashColor">#EAF3F7</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#DFE3EA" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#CBD1DB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#A8B1BF" />

    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.15" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GridLineBrush" Color="#E6EAF0" />
    <SolidColorBrush x:Key="TickMarkBrush" Color="#C9D0DA" />

    <!--
        Retícula da prancha. Papel milimetrado, não "grade gamer": pontos de
        1px a cada 24px, com contraste baixíssimo. Existe para que a área de
        trabalho tenha material em vez de ler como um vazio preto — o defeito
        mais visível do visual anterior. É um DrawingBrush estático e ladrilhado
        (a GPU o cacheia), não uma animação.
        Precisa viver em cada dicionário de tema porque o pincel congela a cor
        no momento em que é criado e o tema é trocado por dicionário inteiro.
    -->
    <DrawingBrush x:Key="SheetGridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#C8D0DC">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,1,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#121721" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4C5566" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#576070" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#17708A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#125A6F" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#2A93B0" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#0C4353" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#E4F1F6" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#17708A" Offset="0" />
        <GradientStop Color="#2A93B0" Offset="1" />
    </LinearGradientBrush>

    <!-- Cor da marca: exclusiva do logotipo na barra de título. -->
    <SolidColorBrush x:Key="BrandInkBrush" Color="#D95E00" />

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#0E7A56" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E6F4EE" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B8DECB" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBF1DC" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E4CE96" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#C0353C" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FCEBEC" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EFC3C6" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#2A5FA0" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E9F0FA" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#BCD1EE" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#5B3FC4" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#66707F" />

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleTrackOffHoverBrush" Color="#DFE4EC" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#5F6979" />
    <SolidColorBrush x:Key="ToggleThumbOnBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CAD6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A2ABBA" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#17708A" />

    <DropShadowEffect x:Key="Elevation2Shadow" Color="#000000" Opacity="0.08" BlurRadius="16" ShadowDepth="3" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#000000" Opacity="0.14" BlurRadius="36" ShadowDepth="10" Direction="270" />
</ResourceDictionary>
