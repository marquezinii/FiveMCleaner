<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema claro. Não é a inversão matemática do
        escuro: a elevação sobe em brilho (não desce), os poços descem em vez
        de subir, e o laranja nunca é fundo além do CTA primário. Mesmas
        chaves do Colors.Dark.xaml — só o valor muda.
    -->

    <Color x:Key="CanvasBaseColor">#F1F0ED</Color>
    <Color x:Key="CanvasSunkenColor">#E8E7E3</Color>
    <Color x:Key="Surface1Color">#FBFAF8</Color>
    <Color x:Key="Surface2Color">#FFFFFF</Color>
    <Color x:Key="Surface3Color">#FFFFFF</Color>
    <Color x:Key="SurfaceRailColor">#EAE8E4</Color>
    <Color x:Key="SurfaceAccentWashColor">#FFF6EC</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E4E2DD" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#D5D2CB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B7B3AA" />

    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.15" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17181B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5F68" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A9AEB6" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#C85300" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B24800" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#E87A22" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#8F3A00" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#C85300" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#FFF1E4" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E87A22" Offset="0" />
        <GradientStop Color="#C85300" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#0E7A56" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E6F4EE" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B8DECB" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBF1DC" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E4CE96" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#C0353C" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FCEBEC" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EFC3C6" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#1F62A8" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E9F1FA" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#BCD5EE" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#5B3FC4" />
    <SolidColorBrush x:Key="RevertSurfaceBrush" Color="#EEEAFB" />
    <SolidColorBrush x:Key="RevertBorderBrush" Color="#CFC4F0" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#6E7480" />

    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#C85300" />
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#D5D2CB" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C7C3BA" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A9A49A" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#C85300" />

    <RadialGradientBrush x:Key="CanvasVignetteBrush" GradientOrigin="0.92,0.05" Center="0.92,0.05" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#06000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="Elevation2Shadow" Color="#000000" Opacity="0.08" BlurRadius="16" ShadowDepth="3" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#000000" Opacity="0.14" BlurRadius="36" ShadowDepth="10" Direction="270" />
</ResourceDictionary>
