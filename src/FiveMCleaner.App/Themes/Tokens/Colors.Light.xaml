<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema claro. Mesmas chaves de
        Colors.Dark.xaml; só o valor muda.

        DIREÇÃO "CÂMARA ÂMBAR", de dia
        ==============================
        Não é a inversão matemática do escuro, e deliberadamente não é
        branco: é a mesma câmara com a persiana aberta. A luz continua vindo
        do mesmo canto inferior esquerdo, o chão continua quente, e as
        superfícies sobem em brilho (em vez de descer) conforme se elevam.

        O branco puro foi evitado por um motivo relatado de verdade no visual
        anterior: claridade excessiva cansa. Aqui a superfície de trabalho é
        um bege-areia de brilho baixo; `Surface3Color` é o único branco, e só
        existe para o que realmente flutua.
    -->

    <Color x:Key="CanvasBaseColor">#E7E3DB</Color>
    <Color x:Key="CanvasSunkenColor">#DEDAD1</Color>
    <Color x:Key="Surface1Color">#FBFAF8</Color>
    <Color x:Key="Surface2Color">#F1EFEB</Color>
    <Color x:Key="Surface3Color">#FFFFFF</Color>
    <Color x:Key="SurfaceRailColor">#EFEBE3</Color>
    <Color x:Key="SurfaceAccentWashColor">#FBF0E4</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <!-- A mesma lâmpada, mais discreta: sob luz do dia uma fonte quente
         aparece como calor no chão, não como brilho. -->
    <RadialGradientBrush x:Key="AmbientLightBrush"
                         GradientOrigin="0.10,1.04"
                         Center="0.10,1.04"
                         RadiusX="1.00"
                         RadiusY="1.20">
        <GradientStop Color="#4ED9760F" Offset="0" />
        <GradientStop Color="#28D9760F" Offset="0.30" />
        <GradientStop Color="#10D9760F" Offset="0.58" />
        <GradientStop Color="#00D9760F" Offset="1" />
    </RadialGradientBrush>

    <!-- Preenchimento dos painéis: a mesma queda de luz do tema escuro,
         invertida em brilho. Extremos verificados contra os três níveis de
         texto e contra AccentTextBrush; o mais apertado fica em 5.72:1. -->
    <LinearGradientBrush x:Key="PanelFillBrush" StartPoint="0.85,0" EndPoint="0.15,1">
        <GradientStop Color="#FDFCFB" Offset="0" />
        <GradientStop Color="#F9F7F4" Offset="0.55" />
        <GradientStop Color="#F4F2EE" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E3DFD6" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#CFC9BD" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#ADA69A" />

    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.16" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GridLineBrush" Color="#EBE7DE" />
    <SolidColorBrush x:Key="TickMarkBrush" Color="#C8C1B4" />

    <!-- Queda de luz vertical dentro de uma região grande de conteúdo. -->
    <LinearGradientBrush x:Key="SheetGridBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#0A6B5230" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1913" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E4A44" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#605D57" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- A luz, calibrada para papel: o mesmo laranja escurece o suficiente
         para carregar texto branco em cima (4.5:1) e continuar legível como
         texto sobre a superfície de trabalho. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C3540A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#9E4407" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#D96410" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#8E3A05" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#F7E7D6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBF1E7" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C3540A" Offset="0" />
        <GradientStop Color="#D96410" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrandInkBrush" Color="#C4520A" />

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#0F7A52" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E7F3EC" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B7DCC8" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#8A5B00" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FAF0DA" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E3CD95" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#C23A3F" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FBEAEB" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EDC1C4" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#2E5FB0" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E9EFF9" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#BCCFEC" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#5D3FCB" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#605D57" />

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleTrackOffHoverBrush" Color="#E5E0D6" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#615D55" />
    <SolidColorBrush x:Key="ToggleThumbOnBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C6BFB2" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A29A8C" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#A94A08" />

    <DropShadowEffect x:Key="Elevation1Shadow" Color="#3A2A18" Opacity="0.08" BlurRadius="12" ShadowDepth="2" Direction="270" />
    <DropShadowEffect x:Key="Elevation2Shadow" Color="#3A2A18" Opacity="0.13" BlurRadius="24" ShadowDepth="5" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#3A2A18" Opacity="0.20" BlurRadius="46" ShadowDepth="14" Direction="270" />
</ResourceDictionary>
