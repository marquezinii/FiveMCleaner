<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Um dicionário mesclado não enxerga os recursos de quem o mescla
             nem de dicionários irmãos — por isso Radii precisa ser mesclado
             aqui de novo, mesmo já estando em App.xaml. -->
        <ResourceDictionary Source="Tokens/Radii.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--
        Vocabulário de superfícies do redesign "prancheta técnica".

        A hierarquia agora é de prancha, não de pilha de cartões:

          Mesa      — CanvasBaseBrush, o fundo da janela.
          Folha     — SheetSurface, ocupa TODA a área de conteúdo da página.
                      É o que elimina espaço morto: a folha sempre preenche
                      a janela inteira, e o conteúdo se organiza dentro dela.
          Campo     — FieldSurface, uma região delimitada dentro da folha,
                      separada por traço fino, sem sombra e sem cartão
                      aninhado.
          Poço      — InsetSurface, conteúdo denso rebaixado (gráfico, log).
          Flutuante — FloatingSurface, só o que realmente flutua (popup).

        Regra: dentro da folha, separação é por TRAÇO, não por cartão. Cartão
        dentro de cartão foi o defeito estrutural do visual anterior.
    -->

    <!-- A folha de trabalho. Uma por página, sempre esticada. -->
    <Style x:Key="SheetSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <!-- Região delimitada dentro da folha. Sem sombra: é uma área da mesma
         prancha, não um objeto sobre ela. -->
    <Style x:Key="FieldSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Compatibilidade de nome com as páginas: painel padrão == campo. -->
    <Style x:Key="PanelSurface" TargetType="Border" BasedOn="{StaticResource FieldSurface}" />

    <Style x:Key="PanelSurfaceElevated" TargetType="Border" BasedOn="{StaticResource FieldSurface}">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>

    <Style x:Key="FloatingSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource Elevation3Shadow}" />
    </Style>

    <Style x:Key="InsetSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <!-- O bloco de destaque de uma página. Herdou o nome do visual anterior,
         mas mudou de natureza: não é mais um cartão com bezel de metal e sim
         a região principal da folha, marcada por um filete de acento na borda
         esquerda — a mesma convenção de "vista principal" de uma prancha. -->
    <Style x:Key="HeroSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <!-- Filete de acento na borda esquerda da vista principal: a marcação de
         "vista principal" de uma prancha. Usado com HeroSurface. -->
    <Style x:Key="HeroAccentRule" TargetType="Rectangle">
        <Setter Property="Width" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <Style x:Key="HairlineDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <Style x:Key="VerticalHairlineDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>

    <!--
        Bloco de legenda (title block). Convenção de desenho técnico trazida
        para a interface: cada folha tem um cabeçalho fixo com identificação,
        escala e revisão. Aqui ele carrega título da página, contexto e a ação
        primária, e por ser sempre do tamanho da folha, resolve a faixa vazia
        que sobrava no topo de todas as páginas do visual anterior.
    -->
    <Style x:Key="TitleBlockSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,16" />
    </Style>

    <!-- Coluna de notas/legenda à direita da folha. Existe para receber
         conteúdo real (chave de risco, especificação do PC, o que é
         registrado) em vez de deixar a lateral da página vazia. -->
    <Style x:Key="NotesColumnSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Padding" Value="20,18" />
    </Style>
</ResourceDictionary>
