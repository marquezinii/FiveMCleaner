<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Um dicionário mesclado não enxerga os recursos de quem o mescla
             nem de dicionários irmãos — por isso Radii precisa ser mesclado
             aqui de novo, mesmo já estando em App.xaml. -->
        <ResourceDictionary Source="Tokens/Radii.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--
        Vocabulário de superfícies. Cinco níveis: canvas (sem Border), elev.0
        (linha de lista, sem preenchimento), PanelSurface (elev.1), Panel
        SurfaceElevated (elev.2), FloatingSurface (elev.3). Cada um soma
        degrau de valor + aresta de luz + sombra conforme a camada.
    -->

    <Style x:Key="PanelSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="PanelSurfaceElevated" TargetType="Border" BasedOn="{StaticResource PanelSurface}">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="Effect" Value="{DynamicResource Elevation2Shadow}" />
    </Style>

    <Style x:Key="FloatingSurface" TargetType="Border" BasedOn="{StaticResource PanelSurface}">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Effect" Value="{DynamicResource Elevation3Shadow}" />
    </Style>

    <Style x:Key="InsetSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <Style x:Key="HeroSurface" TargetType="Border" BasedOn="{StaticResource PanelSurface}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAccentWashBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="32" />
    </Style>

    <Style x:Key="HairlineDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <Style x:Key="VerticalHairlineDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
</ResourceDictionary>
