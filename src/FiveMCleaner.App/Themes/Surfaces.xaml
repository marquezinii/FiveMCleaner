<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Um dicionário mesclado não enxerga os recursos de quem o mescla
             nem de dicionários irmãos — por isso Radii precisa ser mesclado
             aqui de novo, mesmo já estando em App.xaml. -->
        <ResourceDictionary Source="Tokens/Radii.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--
        VOCABULÁRIO DE SUPERFÍCIES — DIREÇÃO "CÂMARA ÂMBAR"
        ===================================================
        A hierarquia agora tem TRÊS níveis, e o primeiro deles não é um
        objeto:

          Chão     — a janela sob `AmbientLightBrush`. O conteúdo respira
                     diretamente sobre ele; não existe mais uma moldura
                     envolvendo a página inteira.
          Painel   — `PanelSurface`, um bloco de conteúdo que se ergue do
                     chão com sombra suave e canto de 14px. Um painel por
                     assunto.
          Poço     — `InsetSurface`, conteúdo rebaixado dentro de um painel
                     (gráfico, log, tabela densa).

        O defeito estrutural que isto corrige: no visual anterior cada página
        era uma moldura ("folha") que continha um cabeçalho emoldurado que
        continha cartões emoldurados. Três bordas aninhadas antes do primeiro
        dado. Aqui a página não tem moldura — o cabeçalho fica direto sobre o
        chão e só o conteúdo que precisa de agrupamento vira painel.

        Dentro de um painel, separação é ESPAÇO primeiro e traço fino depois;
        nunca um painel aninhado.
    -->

    <!--
        Painel de conteúdo. Ergue-se do chão por sombra e tom, não por borda
        grossa: a hairline existe só para segurar a quina quando o painel cai
        sobre uma região clara do chão.
    -->
    <Style x:Key="PanelSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Effect" Value="{DynamicResource Elevation1Shadow}" />
    </Style>

    <!-- Nome herdado das páginas. Mesma coisa que um painel: existe para que
         superfícies ainda não migradas continuem coerentes. -->
    <Style x:Key="SheetSurface" TargetType="Border" BasedOn="{StaticResource PanelSurface}" />

    <!-- Região delimitada DENTRO de um painel. Sem sombra e sem borda: é uma
         área do mesmo painel, não um objeto sobre ele. Só o tom a separa. -->
    <Style x:Key="FieldSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PanelSurfaceElevated" TargetType="Border" BasedOn="{StaticResource FieldSurface}">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>

    <!-- O que realmente flutua: popup, diálogo, menu. -->
    <Style x:Key="FloatingSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{DynamicResource Elevation3Shadow}" />
    </Style>

    <!-- Poço: conteúdo denso rebaixado (gráfico ao vivo, registro). -->
    <Style x:Key="InsetSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CanvasSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <!--
        O bloco principal de uma página — onde mora a conclusão do
        diagnóstico. Recebe a luz da câmara: um degrau de tom acima do
        painel, com a aresta de luz no topo.
    -->
    <Style x:Key="HeroSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <!--
        A LINHA DE LUZ. Filete curto de âmbar que marca de onde a atenção
        parte: fica sob o título de cada página e à esquerda do bloco
        principal. É o mesmo gesto do foco da lâmpada, reduzido a 3px, e é
        a única marcação decorativa permitida na interface.
    -->
    <Style x:Key="HeroAccentRule" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Versão horizontal, usada sob o título de uma página. -->
    <Style x:Key="TitleAccentRule" TargetType="Rectangle">
        <Setter Property="Height" Value="3" />
        <Setter Property="Width" Value="34" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="HairlineDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <Style x:Key="VerticalHairlineDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <!--
        Cabeçalho de página. Fica direto sobre o chão da câmara: sem
        preenchimento e sem borda, porque uma faixa emoldurada acima do
        conteúdo era a primeira das três molduras aninhadas do visual
        anterior. A separação vem do espaço abaixo dele e da linha de luz.
    -->
    <Style x:Key="TitleBlockSurface" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0,4,20" />
    </Style>

    <!--
        Coluna lateral de apoio. É um PAINEL IRMÃO do conteúdo principal, com
        o mesmo tom e a mesma altura: o que a torna secundária é a largura e
        o que ela carrega, não um tom rebaixado. Um "aside" pintado num tom
        diferente lê como um segundo tipo de superfície, e a interface passa
        a ter dois materiais onde precisa de um.
    -->
    <Style x:Key="NotesColumnSurface" TargetType="Border" BasedOn="{StaticResource PanelSurface}">
        <Setter Property="Padding" Value="24,22" />
    </Style>
</ResourceDictionary>
