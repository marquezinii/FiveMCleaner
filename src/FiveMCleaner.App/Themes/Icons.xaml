    <Style x:Key="VectorIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Ícone dentro de uma pastilha colorida (cabeçalhos de linha e KPIs). -->
    <Style x:Key="VectorIconSmallStyle" TargetType="Path" BasedOn="{StaticResource VectorIconStyle}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="StrokeThickness" Value="1.7" />
    </Style>

    <Style x:Key="VectorIconLargeStyle" TargetType="Path" BasedOn="{StaticResource VectorIconStyle}">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <!-- Ícone que acompanha um CaptionStyle (rótulo maiúsculo de 8.5px). -->
    <Style x:Key="VectorIconCaptionStyle" TargetType="Path" BasedOn="{StaticResource VectorIconStyle}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
</ResourceDictionary>
