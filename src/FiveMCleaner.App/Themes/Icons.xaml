    <!--
        Marca oficial do Google, usada no botão "Continuar com o Google". As
        diretrizes de marca proíbem recolorir o "G": por isso ele é um
        DrawingImage com as quatro cores fixas, e não um Path que herdaria o
        Stroke do tema como os demais ícones deste dicionário.
    -->
    <DrawingImage x:Key="GoogleLogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#4285F4" Geometry="M22.56,12.25 C22.56,11.47 22.49,10.72 22.36,10 L12,10 L12,14.26 L17.92,14.26 C17.66,15.63 16.88,16.79 15.71,17.57 L15.71,20.34 L19.28,20.34 C21.36,18.42 22.56,15.6 22.56,12.25 Z" />
