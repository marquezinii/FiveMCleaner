<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A bandeja permanece escura nos dois temas: é uma superfície curta,
         flutuante sobre o shell do Windows e usa diretamente a paleta da marca. -->
    <SolidColorBrush x:Key="TrayMenuSurfaceBrush" Color="{DynamicResource RalvenGraphiteColor}" />
    <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="{DynamicResource RalvenDarkGrayColor}" />
    <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="{DynamicResource RalvenGrayColor}" />
    <SolidColorBrush x:Key="TrayMenuTextBrush" Color="{DynamicResource RalvenWhiteColor}" />
    <SolidColorBrush x:Key="TrayMenuMutedTextBrush" Color="{DynamicResource RalvenLightGrayColor}" />

    <Style x:Key="TrayContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="MinWidth" Value="324" />
        <Setter Property="Background" Value="{StaticResource TrayMenuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TrayMenuTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TrayMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontBody}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="12">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusXl}"
                                Padding="6"
                                Effect="{DynamicResource Elevation3Shadow}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FocusVisualStyle is presented by WPF for keyboard navigation, unlike
         IsKeyboardFocusWithin, which also becomes true after a mouse click. -->
    <Style x:Key="TrayMenuItemFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="2,1"
                            BorderBrush="{StaticResource TrayMenuTextBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            SnapsToDevicePixels="True">
                        <AdornedElementPlaceholder />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TrayMenuTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TrayMenuItemFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Margin="2,1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <AccessText Grid.Column="1"
                                        Margin="10,0,12,0"
                                        Text="{TemplateBinding Header}"
                                        FontFamily="{StaticResource AppFontBody}"
                                        FontWeight="SemiBold"
                                        Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       MaxWidth="112"
                                       Text="{TemplateBinding InputGestureText}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TrayMenuMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TrayMenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TrayMenuMutedTextBrush}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.46" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Danger">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBaseBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                                <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuHeaderStyle" TargetType="MenuItem">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <ContentPresenter ContentSource="Header" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="10,5"
                            Background="{StaticResource TrayMenuBorderBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
