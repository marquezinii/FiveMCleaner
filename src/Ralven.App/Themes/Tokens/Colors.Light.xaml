<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema claro. Mesmas chaves de
        Colors.Dark.xaml; só o valor muda.

        DIREÇÃO RALVEN — tema claro
        ============================
        O tema claro é a inversão funcional do mesmo sistema monocromático.
        Tintas derivadas do carvão separam planos sem introduzir outra cor.
    -->

    <Color x:Key="RalvenCharcoalColor">#0A0A0B</Color>
    <Color x:Key="RalvenGraphiteColor">#111214</Color>
    <Color x:Key="RalvenDarkGrayColor">#1D1E21</Color>
    <Color x:Key="RalvenGrayColor">#2D2E33</Color>
    <Color x:Key="RalvenLightGrayColor">#A6A7AC</Color>
    <Color x:Key="RalvenWhiteColor">#FFFFFF</Color>

    <Color x:Key="CanvasBaseColor">#FFFFFF</Color>
    <Color x:Key="CanvasSunkenColor">#F3F3F3</Color>
    <Color x:Key="Surface1Color">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#F3F3F3</Color>
    <Color x:Key="Surface3Color">#E8E8E9</Color>
    <Color x:Key="SurfaceRailColor">#F3F3F3</Color>
    <Color x:Key="SurfaceAccentWashColor">#E8E8E9</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <!-- Luz ambiente sutil da marca, sem reduzir o contraste do conteúdo. -->
    <RadialGradientBrush x:Key="AmbientLightBrush"
                         GradientOrigin="0.10,1.04"
                         Center="0.10,1.04"
                         RadiusX="1.00"
                         RadiusY="1.20">
        <GradientStop Color="#160A0A0B" Offset="0" />
        <GradientStop Color="#0AA6A7AC" Offset="0.32" />
        <GradientStop Color="#042D2E33" Offset="0.62" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <!-- Preenchimento dos painéis entre as superfícies oficiais claras. -->
    <LinearGradientBrush x:Key="PanelFillBrush" StartPoint="0.85,0" EndPoint="0.15,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8F8F8" Offset="0.55" />
        <GradientStop Color="#F3F3F3" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#DEDEE0" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#C5C5C8" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#A6A7AC" />

    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.16" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GridLineBrush" Color="#DEDEE0" />
    <SolidColorBrush x:Key="TickMarkBrush" Color="#A6A7AC" />

    <!-- Queda de luz vertical dentro de uma região grande de conteúdo. -->
    <LinearGradientBrush x:Key="SheetGridBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#0A0A0A0B" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#2D2E33" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#2D2E33" />
    <SolidColorBrush x:Key="AppTextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#2D2E33" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#111214" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#E8E8E9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F3F3F3" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A0A0B" Offset="0" />
        <GradientStop Color="#2D2E33" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FiveMGameTileBrush" StartPoint="0.92,0" EndPoint="0.08,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#D9E8E8E9" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="FiveMGameTileArtworkBrush"
                         GradientOrigin="0.5,0.2"
                         Center="0.5,0.2"
                         RadiusX="0.82"
                         RadiusY="0.78">
        <GradientStop Color="#1FFF7100" Offset="0" />
        <GradientStop Color="#0AFF7100" Offset="0.52" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="FiveMGameTileBorderBrush" Color="#330A0A0B" />
    <SolidColorBrush x:Key="FiveMGameTileLabelBrush" Color="#0C0A0A0B" />

    <SolidColorBrush x:Key="BrandInkBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="GamingAccentBrush" Color="#2D2E33" />

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#08784F" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E8F7F0" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#AEDFC9" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#865500" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF5DE" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E8CF91" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#C4322B" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0BBB7" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#006B8F" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E6F6FB" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#ADD9E7" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#6447C6" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#2D2E33" />

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleTrackOffHoverBrush" Color="#E8E8E9" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#2D2E33" />
    <SolidColorBrush x:Key="ToggleThumbOnBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A6A7AC" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#2D2E33" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#0A0A0B" />

    <DropShadowEffect x:Key="Elevation1Shadow" Color="#0A0A0B" Opacity="0.10" BlurRadius="12" ShadowDepth="2" Direction="270" />
    <DropShadowEffect x:Key="Elevation2Shadow" Color="#0A0A0B" Opacity="0.16" BlurRadius="24" ShadowDepth="5" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#0A0A0B" Opacity="0.24" BlurRadius="46" ShadowDepth="14" Direction="270" />
    <SolidColorBrush x:Key="ProAccentBrush" Color="#6842A0" />
    <LinearGradientBrush x:Key="ProAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6842A0" Offset="0" />
        <GradientStop Color="#9C3FD1" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
