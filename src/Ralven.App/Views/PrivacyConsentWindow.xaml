<ui:FluentWindow x:Class="Ralven.App.Views.PrivacyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:Ralven.App.Services"
        Title="{Binding [PrivacyConsent.WindowTitle], Source={StaticResource LocalizedStrings}}"
        Icon="/Ralven;component/Assets/Ralven.png"
        Width="540"
        Height="560"
        MinWidth="460"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="{x:Static services:WindowBackdropPolicy.Current}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Background="{DynamicResource CanvasBaseBrush}">

    <Border Background="{DynamicResource CanvasBaseBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceRailBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SuccessSurfaceBrush}">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" />
                        </Border>
                        <TextBlock Text="{Binding [PrivacyConsent.WindowTitle], Source={StaticResource LocalizedStrings}}" Margin="10,0,0,0" Style="{StaticResource BodyStrongText}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,22,28,20">
                    <TextBlock Text="{Binding HeadingText}"
                               Style="{StaticResource PageTitleText}"
                               FontSize="20" />
                    <TextBlock Text="{Binding IntroText}"
                               Style="{StaticResource SecondaryText}"
                               Margin="0,8,0,20"
                               TextWrapping="Wrap"
                               LineHeight="17" />

                    <Border Style="{StaticResource PanelSurface}" Padding="14" Margin="0,0,0,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="{Binding [PrivacyConsent.Essential.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding [PrivacyConsent.Essential.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [PrivacyConsent.Essential.Status], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource OverlineText}"
                                       Foreground="{DynamicResource SuccessBaseBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelSurface}" Padding="14" Margin="0,0,0,14">
                        <CheckBox x:Name="OptionalReportsCheckBox"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="{Binding [PrivacyConsent.Telemetry.Title], Source={StaticResource LocalizedStrings}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [PrivacyConsent.Telemetry.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding [PrivacyConsent.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource AlertRowStyle}" Padding="13">
                        <TextBlock Text="{Binding [PrivacyConsent.PrivacyNote], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceRailBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <Grid Margin="20,0">
                    <Button x:Name="ContinueButton"
                            Content="{Binding [PrivacyConsent.Continue], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Height="40"
                            Padding="24,0"
                            IsDefault="True"
                            Click="Continue_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
