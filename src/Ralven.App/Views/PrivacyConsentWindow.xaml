<controls:DialogWindow x:Class="Ralven.App.Views.PrivacyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:Ralven.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding [PrivacyConsent.WindowTitle], Source={StaticResource LocalizedStrings}}"
        Icon="/Ralven;component/Assets/Ralven.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Background="{DynamicResource Surface1Brush}"
        Width="680" Height="660" MinWidth="460" MinHeight="400" ResizeMode="NoResize" CanDismiss="False">

    <Border Background="{DynamicResource Surface1Brush}" BorderThickness="0" CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,8,32,24">
                    <TextBlock Text="{Binding HeadingText}"
                               Style="{StaticResource PageTitleText}"
                               FontSize="26" />
                    <TextBlock Text="{Binding IntroText}"
                               Style="{StaticResource SecondaryText}"
                               Margin="0,8,0,20"
                               TextWrapping="Wrap"
                               LineHeight="21" />

                    <Border Style="{StaticResource PanelSurface}" Padding="14" Margin="0,0,0,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="{Binding [PrivacyConsent.Essential.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding [PrivacyConsent.Essential.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [PrivacyConsent.Essential.Status], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource OverlineText}"
                                       Foreground="{DynamicResource SuccessBaseBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelSurface}" Padding="14" Margin="0,0,0,14">
                        <CheckBox x:Name="OptionalReportsCheckBox"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  AutomationProperties.Name="{Binding [PrivacyConsent.Telemetry.Title], Source={StaticResource LocalizedStrings}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [PrivacyConsent.Telemetry.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding [PrivacyConsent.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource AlertRowStyle}" Padding="13">
                        <TextBlock Text="{Binding [PrivacyConsent.PrivacyNote], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
                <Grid Margin="0">
                    <Button x:Name="ContinueButton"
                            Content="{Binding [PrivacyConsent.Continue], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Height="40"
                            Padding="24,0"
                            IsDefault="True"
                            Click="Continue_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</controls:DialogWindow>
