<controls:DialogWindow x:Class="Ralven.App.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:Ralven.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [BugReport.WindowTitle], Source={StaticResource LocalizedStrings}}"
        Icon="/Ralven;component/Assets/Ralven.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource Surface1Brush}"
        Width="820" Height="820" MinWidth="520" MinHeight="400" ResizeMode="CanResize">

    <Border Background="{DynamicResource Surface1Brush}" BorderThickness="0" CornerRadius="{StaticResource RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,8,32,24">
                    <TextBlock Text="{Binding [BugReport.Heading], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{Binding [BugReport.Intro], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,6,0,18" />

                    <Border Style="{StaticResource AlertRowStyle}" Background="{DynamicResource SuccessSurfaceBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" Padding="13" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}" Stroke="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [BugReport.Privacy], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [BugReport.Category.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                    <WrapPanel x:Name="CategoryPanel" Margin="0,0,0,9">
                        <RadioButton GroupName="BugCategory" Style="{StaticResource DialogOptionStyle}" Tag="optimization" Content="{Binding [BugReport.Category.Optimization], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource DialogOptionStyle}" Tag="games" Content="{Binding [BugReport.Category.Games], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource DialogOptionStyle}" Tag="windows" Content="{Binding [BugReport.Category.Windows], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource DialogOptionStyle}" Tag="interface" Content="{Binding [BugReport.Category.Interface], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource DialogOptionStyle}" Tag="crash" Content="{Binding [BugReport.Category.Crash], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                        <RadioButton GroupName="BugCategory" Style="{StaticResource DialogOptionStyle}" Tag="other" Content="{Binding [BugReport.Category.Other], Source={StaticResource LocalizedStrings}}" Checked="Category_Checked" />
                    </WrapPanel>

                    <TextBlock Text="{Binding [BugReport.BugCode.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                    <ComboBox x:Name="BugCodeComboBox" AutomationProperties.Name="{Binding [BugReport.BugCode.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DialogSelectorStyle}" Margin="0,0,0,15" SelectionChanged="BugCode_SelectionChanged" ToolTip="{Binding [BugReport.BugCode.Tooltip], Source={StaticResource LocalizedStrings}}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding [BugReport.Summary.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SummaryTextBox" AutomationProperties.Name="{Binding [BugReport.Summary.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DialogFieldStyle}" MaxLength="120" ToolTip="{Binding [BugReport.Summary.Tooltip], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock Text="{Binding [BugReport.Summary.Example], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                    <TextBlock Text="{Binding [BugReport.Description.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="DescriptionTextBox" AutomationProperties.Name="{Binding [BugReport.Description.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DialogFieldStyle}" MinHeight="128" MaxHeight="210" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="{Binding [BugReport.Description.Tooltip], Source={StaticResource LocalizedStrings}}" />
                    <TextBlock Text="{Binding [BugReport.Description.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                    <Expander Header="{Binding [Dialog.OptionalDetails], Source={StaticResource LocalizedStrings}}" Margin="0,8,0,20">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{Binding [BugReport.Log.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="LogTextBox" AutomationProperties.Name="{Binding [BugReport.Log.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DialogFieldStyle}" MinHeight="80" MaxHeight="150" MaxLength="100000" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding [BugReport.Log.Tooltip], Source={StaticResource LocalizedStrings}}" />
                            <TextBlock Text="{Binding [BugReport.Log.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                            <TextBlock Text="{Binding [BugReport.Email.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="EmailTextBox" AutomationProperties.Name="{Binding [BugReport.Email.Label], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DialogFieldStyle}" MaxLength="254" ToolTip="{Binding [BugReport.Email.Tooltip], Source={StaticResource LocalizedStrings}}" />
                            <TextBlock Text="{Binding [BugReport.Email.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="2,5,0,15" />

                        </StackPanel>
                    </Expander>

                    <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0" Padding="0,0,0,13">
                        <CheckBox x:Name="IncludeTechnicalInfoCheckBox" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="{Binding [BugReport.Technical.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding [BugReport.Technical.Help], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border x:Name="StatusBorder" Background="{DynamicResource CanvasSunkenBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="11" Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource SecondaryText}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
                <Grid Margin="0">
                    <Button x:Name="CopyButton" Content="{Binding [BugReport.Copy], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Click="Copy_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding [BugReport.Cancel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DialogSecondaryButtonStyle}" Height="40" Padding="17,0" Margin="0,0,9,0" Click="Close_Click" />
                        <Button x:Name="SendButton" Content="{Binding [BugReport.Send], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" Click="Send_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</controls:DialogWindow>
