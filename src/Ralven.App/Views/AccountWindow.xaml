<controls:DialogWindow x:Class="Ralven.App.Views.AccountWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Ralven.App.Controls"
                 Title="{Binding [Account.WindowTitle], Source={StaticResource LocalizedStrings}}"
                 Icon="/Ralven;component/Assets/Ralven.png"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 FontFamily="{StaticResource AppFontBody}"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Background="{DynamicResource Surface1Brush}"
                 Width="600" Height="620" MinWidth="440" MinHeight="420" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,4,32,0">
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource AppFontDisplay}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Text="{Binding [Account.Welcome.Title], Source={StaticResource LocalizedStrings}}" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,7,0,0"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding [Account.Welcome.Subtitle], Source={StaticResource LocalizedStrings}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="32,0,32,16">

                <StackPanel x:Name="ProviderPanel">
                    <Button x:Name="GoogleButton"
                            Style="{StaticResource DialogProviderButtonStyle}"
                            Click="GoogleSignIn_Click"
                            AutomationProperties.Name="{Binding [Account.Provider.ContinueWithGoogle], Source={StaticResource LocalizedStrings}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource GoogleLogoImage}" Width="18" Height="18" />
                            <TextBlock x:Name="GoogleButtonText"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding [Account.Provider.ContinueWithGoogle], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderSubtleBrush}" />
                        <TextBlock x:Name="ProviderDividerText"
                                   Grid.Column="1"
                                   Margin="12,0"
                                   Style="{StaticResource OverlineText}"
                                   Text="{Binding [Account.Provider.DividerSignIn], Source={StaticResource LocalizedStrings}}" />
                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderSubtleBrush}" />
                    </Grid>
                </StackPanel>

        <StackPanel x:Name="AuthenticationPanel">

                    <StackPanel x:Name="ProfileFieldsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OverlineText}" Margin="0,0,0,10" Text="{Binding [Account.Profile.SectionLabel], Source={StaticResource LocalizedStrings}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding [Account.Profile.FirstNameLabel], Source={StaticResource LocalizedStrings}}" />
                                <TextBox x:Name="FirstNameBox"
                                         Style="{StaticResource DialogFieldStyle}"
                                         MaxLength="60"
                                         AutomationProperties.Name="{Binding [Account.Profile.FirstNameLabel], Source={StaticResource LocalizedStrings}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding [Account.Profile.LastNameLabel], Source={StaticResource LocalizedStrings}}" />
                                <TextBox x:Name="LastNameBox"
                                         Style="{StaticResource DialogFieldStyle}"
                                         MaxLength="60"
                                         AutomationProperties.Name="{Binding [Account.Profile.LastNameLabel], Source={StaticResource LocalizedStrings}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" Text="{Binding [Account.Profile.UsernameLabel], Source={StaticResource LocalizedStrings}}" />
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource DialogFieldStyle}"
                                 MaxLength="24"
                                 TextChanged="Username_TextChanged"
                                 AutomationProperties.Name="{Binding [Account.Profile.UsernameLabel], Source={StaticResource LocalizedStrings}}" />
                        <TextBlock x:Name="UsernameHintText"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding [Account.Profile.UsernameHint], Source={StaticResource LocalizedStrings}}" />
                        <StackPanel x:Name="UsernameStatusPanel"
                                    Orientation="Horizontal"
                                    Margin="1,6,0,0"
                                    Visibility="Collapsed">
                            <Path x:Name="UsernameStatusIcon"
                                  Style="{StaticResource VectorIconStyle}"
                                  Width="12"
                                  Height="12"
                                  StrokeThickness="2" />
                            <TextBlock x:Name="UsernameStatusText"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="10.5"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <Border Height="1" Margin="0,20,0,20" Background="{DynamicResource BorderSubtleBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="CredentialFieldsPanel">
                        <TextBlock x:Name="CredentialsSectionLabel"
                                   Style="{StaticResource OverlineText}"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"
                                   Text="{Binding [Account.Credentials.SectionLabel], Source={StaticResource LocalizedStrings}}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding [Account.Credentials.EmailLabel], Source={StaticResource LocalizedStrings}}" />
                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource DialogFieldStyle}"
                                 MaxLength="254"
                                 AutomationProperties.Name="{Binding [Account.Credentials.EmailLabel], Source={StaticResource LocalizedStrings}}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" Text="{Binding [Account.Credentials.PasswordLabel], Source={StaticResource LocalizedStrings}}" />
                        <controls:RevealPasswordBox BorderBrush="{DynamicResource BorderDefaultBrush}" x:Name="PasswordField"
                                                    MaxLength="128"
                                                    Placeholder="{Binding [Account.Credentials.PasswordPlaceholder], Source={StaticResource LocalizedStrings}}"
                                                    PasswordChanged="Password_Changed"
                                                    AutomationProperties.Name="{Binding [Account.Credentials.PasswordLabel], Source={StaticResource LocalizedStrings}}" />
                        <StackPanel x:Name="PasswordPolicyPanel" Visibility="Collapsed" Margin="1,7,0,0">
                            <ProgressBar x:Name="PasswordStrengthBar"
                                         Height="4"
                                         Minimum="0"
                                         Maximum="12"
                                         Value="0"
                                         Foreground="{DynamicResource DangerBaseBrush}" />
                            <TextBlock x:Name="PasswordPolicyText"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,6" Text="{Binding [Account.Credentials.ConfirmPasswordLabel], Source={StaticResource LocalizedStrings}}" />
                            <controls:RevealPasswordBox BorderBrush="{DynamicResource BorderDefaultBrush}" x:Name="ConfirmPasswordField"
                                                        MaxLength="128"
                                                        Placeholder="{Binding [Account.Credentials.ConfirmPasswordPlaceholder], Source={StaticResource LocalizedStrings}}"
                                                        PasswordChanged="Password_Changed"
                                                        AutomationProperties.Name="{Binding [Account.Credentials.ConfirmPasswordLabel], Source={StaticResource LocalizedStrings}}" />
                            <StackPanel x:Name="ConfirmStatusPanel"
                                        Orientation="Horizontal"
                                        Margin="1,6,0,0"
                                        Visibility="Collapsed">
                                <Path x:Name="ConfirmStatusIcon"
                                      Style="{StaticResource VectorIconStyle}"
                                      Width="12"
                                      Height="12"
                                      StrokeThickness="2" />
                                <TextBlock x:Name="ConfirmStatusText"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="KeepSignedInBox"
                                      Style="{StaticResource FormCheckBoxStyle}"
                                      Content="{Binding [Account.Options.KeepSignedIn], Source={StaticResource LocalizedStrings}}"
                                      IsChecked="True" />
                    <Button x:Name="ResetPasswordButton"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    Style="{StaticResource LinkButtonStyle}"
                                    FontSize="11.5"
                                    Content="{Binding [Account.Actions.ForgotPassword], Source={StaticResource LocalizedStrings}}"
                                    Click="ResetPassword_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="TermsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <CheckBox x:Name="TermsCheckBox" Style="{StaticResource FormCheckBoxStyle}">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                <Run Text="{Binding [Account.Terms.AgreementPrefix], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /> <Run Text="{Binding [Account.Terms.TermsOfUseLink], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </CheckBox>
                        <Button Margin="28,4,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource LinkButtonStyle}"
                                FontSize="11"
                                Content="{Binding [Account.Terms.ReadLink], Source={StaticResource LocalizedStrings}}"
                                Click="Terms_Click" />
                    </StackPanel>
                </StackPanel>

        <StackPanel x:Name="VerificationPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource PanelSurface}">
                        <StackPanel>
                            <TextBlock x:Name="VerificationDetailText"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button x:Name="ResendVerificationButton"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Content="{Binding [Account.Verification.Resend], Source={StaticResource LocalizedStrings}}"
                                    Click="ResendVerification_Click" />
                            <Button x:Name="RefreshVerificationButton"
                                    Margin="0,9,0,0"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Content="{Binding [Account.Verification.Refresh], Source={StaticResource LocalizedStrings}}"
                                    Click="RefreshVerification_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

        <Border x:Name="StatusPanel"
                        Visibility="Collapsed"
                        Margin="0,18,0,0"
                        Padding="13,11"
                        CornerRadius="{StaticResource RadiusMd}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="StatusIcon"
                              Style="{StaticResource VectorIconStyle}"
                              Width="14"
                              Height="14"
                              VerticalAlignment="Top"
                              Margin="0,1,0,0"
                              StrokeThickness="1.8" />
                        <TextBlock x:Name="StatusText"
                                   Margin="9,0,0,0"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

<Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <StackPanel>
                <Button x:Name="SubmitButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{Binding [Account.Actions.SignIn], Source={StaticResource LocalizedStrings}}"
                        Click="Submit_Click"
                        IsDefault="True" />
                <Button x:Name="SwitchButton"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource LinkButtonStyle}"
                        FontSize="14"
                        Content="{Binding [Account.Switch.ToRegister], Source={StaticResource LocalizedStrings}}"
                        Click="Switch_Click" />
                <Button x:Name="LogoutButton"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Content="{Binding [Account.Actions.SignOut], Source={StaticResource LocalizedStrings}}"
                        Click="Logout_Click" />
            </StackPanel>
        </Border>
    </Grid>
</controls:DialogWindow>
