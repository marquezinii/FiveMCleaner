<controls:DialogWindow x:Class="Ralven.App.Views.OptimizationConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ralven.App.Controls"
    Title="{Binding TitleText}" Width="620" Height="320" MinWidth="420" MinHeight="300"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
    FontFamily="{StaticResource AppFontBody}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="32,8,32,24">
                <TextBlock Text="{Binding TitleText}" Style="{StaticResource PageTitleText}" FontSize="26" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MessageText}" Style="{StaticResource SecondaryText}" FontSize="14" LineHeight="22" Margin="0,16,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="DismissButton" Content="{Binding KeepWorkingText}" Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinHeight="42" Padding="20,10" Margin="0,4,12,0" IsCancel="True" Click="Dismiss_Click" />
                <Button x:Name="ConfirmAction" Content="{Binding ConfirmText}" Style="{StaticResource PrimaryButtonStyle}"
                        MinHeight="42" Padding="20,10" Margin="0,4,0,0" IsDefault="True" Click="Confirm_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</controls:DialogWindow>
