<controls:DialogWindow x:Class="Ralven.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:Ralven.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Ralven;component/Assets/Ralven.png"
        Width="600"
        Height="560"
        MinWidth="440"
        MinHeight="440"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFontBody}">
    <Border Background="{DynamicResource Surface1Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,18,34,22">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource DangerSurfaceBrush}" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Path Data="{StaticResource IconMarkFailed}" Stroke="{DynamicResource DangerBaseBrush}" StrokeThickness="1.8" Width="25" Height="25" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HeadlineText" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Border x:Name="GuidanceBorder" Background="{DynamicResource CanvasSunkenBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14" Margin="0,22,0,0">
                        <TextBlock x:Name="GuidanceText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </Border>
                    <Expander x:Name="DetailsExpander" Margin="0,22,0,0">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock x:Name="DetailsTitleText" Style="{StaticResource BodyStrongText}" />
                                <TextBlock x:Name="DetailsHelpText" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBox x:Name="DetailsTextBox" Margin="0,12,0,0" Style="{StaticResource DialogFieldStyle}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="130" MaxHeight="230" />
                    </Expander>
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource DangerBaseBrush}" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ReportButton" Style="{StaticResource LinkButtonStyle}" Click="Report_Click" />
                        <Button x:Name="CopyButton" Style="{StaticResource LinkButtonStyle}" Click="Copy_Click" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RestartButton" Style="{StaticResource DialogSecondaryButtonStyle}" Height="40" Padding="17,0" Margin="0,0,9,0" Click="Restart_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</controls:DialogWindow>
