<UserControl x:Class="Ralven.App.Views.Pages.ApplicationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="820"
             Loaded="ApplicationsPage_Loaded">
    <UserControl.Resources>
        <Style x:Key="ApplicationAreaOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                MinHeight="94"
                                Padding="16,14"
                                Background="{DynamicResource CanvasSunkenBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScrollViewer}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
            <StackPanel>
                <TextBlock Text="{Binding [Applications.Title], Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource PageTitleText}" />
                <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding [Applications.Subtitle], Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelSurface}" Padding="24" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{Binding [Applications.Navigation.Title], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding [Applications.Navigation.Description], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding [Applications.Navigation.RefreshAll], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanRefreshApplications}"
                            Click="RefreshInventory_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="{Binding [Applications.Navigation.Manage], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource OverlineText}"
                                   Margin="2,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="DiscoverTab"
                                         Grid.Column="0"
                                         GroupName="ApplicationInventoryTab"
                                         Style="{StaticResource ApplicationAreaOptionStyle}"
                                         Checked="InventoryTab_Checked"
                                         automation:AutomationProperties.Name="{Binding [Applications.Discover.Tab], Source={StaticResource LocalizedStrings}}"
                                         automation:AutomationProperties.HelpText="{Binding [Applications.Discover.Description], Source={StaticResource LocalizedStrings}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Applications.Discover.Tab], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                    <TextBlock Text="{Binding [Applications.Discover.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="UpdatesTab"
                                         Grid.Column="1"
                                         GroupName="ApplicationInventoryTab"
                                         Style="{StaticResource ApplicationAreaOptionStyle}"
                                         Checked="InventoryTab_Checked"
                                         automation:AutomationProperties.Name="{Binding [Applications.Updates.Tab], Source={StaticResource LocalizedStrings}}"
                                         automation:AutomationProperties.HelpText="{Binding [Applications.Updates.Description], Source={StaticResource LocalizedStrings}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Applications.Updates.Tab], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                        <TextBlock Text="{Binding [Applications.Updates.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,8,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ApplicationUpdateCount}" Style="{StaticResource MetricSmallText}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ManagedTab"
                                         Grid.Column="2"
                                         GroupName="ApplicationInventoryTab"
                                         Style="{StaticResource ApplicationAreaOptionStyle}"
                                         Margin="0"
                                         Checked="InventoryTab_Checked"
                                         automation:AutomationProperties.Name="{Binding [Applications.Packages.Tab], Source={StaticResource LocalizedStrings}}"
                                         automation:AutomationProperties.HelpText="{Binding [Applications.Packages.Description], Source={StaticResource LocalizedStrings}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Applications.Packages.Tab], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                        <TextBlock Text="{Binding [Applications.Packages.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,8,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ManagedPackageCount}" Style="{StaticResource MetricSmallText}" />
                                </Grid>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource VerticalHairlineDivider}" />

                    <StackPanel Grid.Column="2" Margin="24,0,0,0">
                        <TextBlock Text="{Binding [Applications.Navigation.Review], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource OverlineText}"
                                   Margin="2,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="InstalledTab"
                                         Grid.Column="0"
                                         GroupName="ApplicationInventoryTab"
                                         Style="{StaticResource ApplicationAreaOptionStyle}"
                                         Checked="InventoryTab_Checked"
                                         automation:AutomationProperties.Name="{Binding [Applications.Inventory.InstalledTab], Source={StaticResource LocalizedStrings}}"
                                         automation:AutomationProperties.HelpText="{Binding [Applications.Installed.Description], Source={StaticResource LocalizedStrings}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Applications.Inventory.InstalledTab], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                        <TextBlock Text="{Binding [Applications.Installed.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,8,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledApplicationCount}" Style="{StaticResource MetricSmallText}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="StartupTab"
                                         Grid.Column="1"
                                         GroupName="ApplicationInventoryTab"
                                         Style="{StaticResource ApplicationAreaOptionStyle}"
                                         Margin="0"
                                         Checked="InventoryTab_Checked"
                                         automation:AutomationProperties.Name="{Binding [Applications.Inventory.StartupTab], Source={StaticResource LocalizedStrings}}"
                                         automation:AutomationProperties.HelpText="{Binding [Applications.Startup.Description], Source={StaticResource LocalizedStrings}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Applications.Inventory.StartupTab], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                        <TextBlock Text="{Binding [Applications.Startup.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,8,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StartupItemCount}" Style="{StaticResource MetricSmallText}" />
                                </Grid>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelSurface}" Padding="24" MinHeight="260">
            <Grid>
                <Grid x:Name="DiscoverPackagesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="{Binding [Applications.Discover.Title], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding [Applications.Discover.Description], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding DiscoverQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MinWidth="300"
                                 KeyDown="DiscoverQuery_KeyDown"
                                 automation:AutomationProperties.Name="{Binding [Applications.Discover.Search], Source={StaticResource LocalizedStrings}}" />
                        <Button Grid.Column="1"
                                Content="{Binding [Applications.Discover.SearchAction], Source={StaticResource LocalizedStrings}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="12,0,0,0"
                                IsEnabled="{Binding CanSearchPackages}"
                                Click="SearchPackages_Click" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding DiscoverStatusMessage}"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               automation:AutomationProperties.LiveSetting="Polite" />

                    <Border Grid.Row="3" Style="{StaticResource TableHeaderRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Applications.Inventory.Column.Application], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Applications.Updates.Column.Id], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding [Applications.Inventory.Column.Version], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding [Applications.Inventory.Column.Source], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DiscoveredPackages}"
                                          Visibility="{Binding HasDiscoveredPackages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowStyle}" automation:AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.7*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding PackageId}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageId}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding Source}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <Button Grid.Column="4"
                                                        Content="{Binding [Applications.Packages.Install.Action], Source={StaticResource LocalizedStrings}}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        IsEnabled="{Binding DataContext.CanRunPackageOperation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        automation:AutomationProperties.Name="{Binding ActionAutomationName}"
                                                        Tag="{Binding}"
                                                        Click="InstallPackage_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{Binding DiscoveredPackagesEmptyMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   Visibility="{Binding ShowDiscoveredPackagesEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <Grid x:Name="ManagedPackagesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding [Applications.Packages.Title], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Packages.Description], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="2,0,0,5" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     automation:AutomationProperties.Name="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ManagedPackagesStatusMessage}"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               automation:AutomationProperties.LiveSetting="Polite" />

                    <Border Grid.Row="2" Style="{StaticResource TableHeaderRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="Auto" MinWidth="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Applications.Inventory.Column.Application], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Applications.Updates.Column.Id], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding [Applications.Inventory.Column.Version], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding [Applications.Inventory.Column.Source], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ManagedPackages}"
                                          Visibility="{Binding HasManagedPackages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowStyle}" automation:AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.7*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding PackageId}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageId}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding Source}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <Button Grid.Column="4"
                                                        Content="{Binding [Applications.Packages.Uninstall.Action], Source={StaticResource LocalizedStrings}}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        IsEnabled="{Binding DataContext.CanRunPackageOperation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        automation:AutomationProperties.Name="{Binding ActionAutomationName}"
                                                        Tag="{Binding}"
                                                        Click="UninstallPackage_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{Binding ManagedPackagesEmptyMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   Visibility="{Binding ShowManagedPackagesEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <Grid x:Name="InstalledApplicationsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding [Applications.Installed.Title], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Installed.Description], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="2,0,0,5" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     automation:AutomationProperties.Name="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="{Binding [Applications.Inventory.ReadOnly], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InventoryStatusMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding InventoryObservedAtLabel}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding InventoryObservedAtLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource TableHeaderRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Applications.Inventory.Column.Application], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Applications.Inventory.Column.Publisher], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding [Applications.Inventory.Column.Version], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding [Applications.Inventory.Column.Size], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="4" Text="{Binding [Applications.Inventory.Column.Scope], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding InstalledApplications}"
                                          Visibility="{Binding HasInstalledApplications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowStyle}"
                                                automation:AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Publisher}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding EstimatedSize}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding Scope}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{Binding InstalledEmptyMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"
                                   Visibility="{Binding ShowInstalledEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <Grid x:Name="StartupApplicationsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding [Applications.Startup.Title], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Startup.Description], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="2,0,0,5" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     automation:AutomationProperties.Name="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="{Binding [Applications.Inventory.ReadOnly], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InventoryStatusMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding InventoryObservedAtLabel}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding InventoryObservedAtLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource TableHeaderRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [Applications.Inventory.Column.Application], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Applications.Inventory.Column.Source], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding [Applications.Inventory.Column.Scope], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding StartupItems}"
                                          Visibility="{Binding HasStartupItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowStyle}"
                                                automation:AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Scope}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{Binding StartupEmptyMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"
                                   Visibility="{Binding ShowStartupEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <Grid x:Name="ApplicationUpdatesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding [Applications.Updates.Title], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Updates.Description], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="2,0,0,5" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     automation:AutomationProperties.Name="{Binding [Applications.Filter.Current], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="{Binding [Applications.Updates.SelectAll], Source={StaticResource LocalizedStrings}}"
                                      IsChecked="{Binding IsAllVisibleUpdatesSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{Binding [Applications.Updates.UpdateSelected], Source={StaticResource LocalizedStrings}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="12,0,0,0"
                                    IsEnabled="{Binding CanUpdateSelected}"
                                    Click="UpdateSelectedApplications_Click" />
                            <CheckBox Grid.Column="3"
                                      Content="{Binding [Applications.Updates.ShowIgnored], Source={StaticResource LocalizedStrings}}"
                                      IsChecked="{Binding ShowIgnoredUpdates, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{Binding ApplicationUpdateStatusMessage}"
                                       Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ApplicationUpdatesObservedAtLabel}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ApplicationUpdatesObservedAtLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource TableHeaderRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.75*" />
                                <ColumnDefinition Width="0.75*" />
                                <ColumnDefinition Width="0.6*" />
                                <ColumnDefinition Width="Auto" MinWidth="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding [Applications.Inventory.Column.Application], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding [Applications.Updates.Column.Id], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding [Applications.Updates.Column.Installed], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="4" Text="{Binding [Applications.Updates.Column.Available], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                            <TextBlock Grid.Column="5" Text="{Binding [Applications.Inventory.Column.Source], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TableHeaderCellText}" Margin="12,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ApplicationUpdates}"
                                          Visibility="{Binding HasApplicationUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowStyle}"
                                                automation:AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="0.75*" />
                                                    <ColumnDefinition Width="0.75*" />
                                                    <ColumnDefinition Width="0.6*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="220" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanSelect}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding PackageId}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageId}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding InstalledVersion}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding AvailableVersion}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="5" Text="{Binding Source}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="{Binding [Applications.Updates.Action], Source={StaticResource LocalizedStrings}}"
                                                            IsEnabled="{Binding DataContext.CanRunPackageOperation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            automation:AutomationProperties.Name="{Binding UpdateAutomationName}"
                                                            Tag="{Binding}"
                                                            Click="UpdateApplication_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="{Binding IgnoreActionLabel}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Margin="8,0,0,0"
                                                            IsEnabled="{Binding DataContext.CanRunPackageOperation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            automation:AutomationProperties.Name="{Binding IgnoreAutomationName}"
                                                            Tag="{Binding}"
                                                            Click="ToggleIgnoredUpdate_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{Binding ApplicationUpdatesEmptyMessage}"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   Visibility="{Binding ShowApplicationUpdatesEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource NotesColumnSurface}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{Binding [Applications.Platform.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" />
                <TextBlock Text="{Binding [Applications.Platform.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding [Applications.Installed.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                            <TextBlock Text="{Binding [Applications.Installed.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [Applications.Installed.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenInstalledApps_Click" />
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="2" Margin="24,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding [Applications.Startup.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                            <TextBlock Text="{Binding [Applications.Startup.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [Applications.Startup.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenStartupApps_Click" />
                    </Grid>

                    <Border Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource VerticalHairlineDivider}" />
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HairlineDivider}" />
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HairlineDivider}" />

                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,18,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding [Applications.StoreUpdates.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                            <TextBlock Text="{Binding [Applications.StoreUpdates.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [Applications.StoreUpdates.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenStoreUpdates_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="2" Margin="24,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding [Applications.Defaults.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                            <TextBlock Text="{Binding [Applications.Defaults.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [Applications.Defaults.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenDefaultApps_Click" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
