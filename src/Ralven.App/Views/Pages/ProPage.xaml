<UserControl x:Class="Ralven.App.Views.Pages.ProPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             SizeChanged="Page_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="RecommendedProBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ProAccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ProAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Effect" Value="{DynamicResource Elevation1Shadow}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" MaxWidth="1280" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding [Pro.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}"
                       AutomationProperties.HeadingLevel="Level1" />
            <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,20" />
            <TextBlock Text="{Binding [Pro.Headline], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DisplayText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding [Pro.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       MaxWidth="790" HorizontalAlignment="Left" Margin="0,10,0,24" />

            <Border Style="{StaticResource AlertRowStyle}" Margin="0,0,0,16" Visibility="{Binding IsDemo, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding [Pro.Demo.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource AlertRowStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="LockClosed24" Margin="0,2,14,0" Foreground="{DynamicResource WarningBaseBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding [Pro.Development.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                        <TextBlock Text="{Binding [Pro.Development.Detail], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="OfferLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="OfferColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="BenefitsPanel" Style="{StaticResource PanelSurface}" Padding="28" Margin="0,0,20,0"
                        AutomationProperties.Name="{Binding [Pro.FreeName], Source={StaticResource LocalizedStrings}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Pro.FreeName], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{Binding [Pro.Free.Tagline], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding [Pro.Free.Price], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DisplayText}" Margin="0,22,0,0" />
                        <TextBlock Text="{Binding [Pro.Free.PerMonth], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding [Pro.Free.Status], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}"
                                   TextWrapping="Wrap" Margin="0,18,0,0" />
                        <Button Content="{Binding [Pro.Free.Continue], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,14,0,0" Click="Free_Click" />

                        <Border Style="{StaticResource HairlineDivider}" Margin="0,24,0,20" />
                        <TextBlock Text="{Binding [Pro.Comparison.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Pro.Comparison.Diagnostics], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Pro.Comparison.Profiles], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Pro.Comparison.FiveM], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding [Pro.Comparison.Safety], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="SubscriptionPanel" Grid.Column="1" Style="{StaticResource PanelSurface}" BorderBrush="{DynamicResource ProAccentBrush}"
                        BorderThickness="1.5" Padding="28" AutomationProperties.Name="{Binding [Pro.ProName], Source={StaticResource LocalizedStrings}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Pro.ProName], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}"
                                       Foreground="{DynamicResource ProAccentGradientBrush}" AutomationProperties.HeadingLevel="Level2" />
                            <Border Grid.Column="1" Style="{StaticResource RecommendedProBadge}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Pro.Badge], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}"
                                           FontWeight="Bold" Foreground="{DynamicResource AppTextOnAccentBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding [Pro.Pro.Tagline], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Price}" Style="{StaticResource DisplayText}" Margin="0,22,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource BodyStrongText}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding AccessDetail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding RenewalDetail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.Name="{Binding [Pro.Loading], Source={StaticResource LocalizedStrings}}" />
                        <Button Content="{Binding [Pro.SignIn], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0" Click="SignIn_Click"
                                Visibility="{Binding CanSignIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Visibility="{Binding ShowCheckout, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,18,0,0">
                            <CheckBox IsChecked="{Binding Consent}" IsEnabled="{Binding CanRefresh}" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding ConsentText}">
                                <TextBlock Text="{Binding ConsentText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </CheckBox>
                            <Button Content="{Binding [Pro.Checkout], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"
                                    IsEnabled="{Binding CanCheckout}" Click="Checkout_Click" />
                            <TextBlock Text="{Binding [Pro.Checkout.Privacy], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding [Pro.Checkout.Security], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button Content="{Binding [Pro.Refresh], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0"
                                IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"
                                Visibility="{Binding CanRefresh, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="{Binding [Pro.Cancel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" Margin="0,14,0,0"
                                IsEnabled="{Binding CanCancel}" Click="Cancel_Click" Visibility="{Binding ShowCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,16,0,0"
                                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Style="{StaticResource HairlineDivider}" Margin="0,24,0,20" />
                        <TextBlock Text="{Binding [Pro.Benefits.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource ProAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [Pro.Ai.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [Pro.Ai.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource ProAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [Pro.Routines.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [Pro.Routines.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource ProAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [Pro.Tracking.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [Pro.Tracking.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon16}" Stroke="{DynamicResource ProAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [Pro.Measurements.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding [Pro.Measurements.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Button Content="{Binding [Pro.Development.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,22,0,0" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource PanelSurface}" Padding="24" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Pro.Trust.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding [Pro.Honesty], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button Content="{Binding [Pro.Support], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="Support_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
