<UserControl x:Class="Ralven.App.Views.Pages.RalvenAiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Ralven.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="820"
             FontFamily="{StaticResource RalvenAiFont}">
    <UserControl.Resources>
        <Style x:Key="PromptSuggestionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontFamily" Value="{StaticResource RalvenAiFont}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="RalvenAiPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource RalvenAiFont}" />
        </Style>

        <Style x:Key="ChatComposerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource RalvenAiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{DynamicResource RalvenAiLogoImage}"
                       Width="28"
                       Height="28"
                       Stretch="Uniform"
                       Focusable="False"
                       IsHitTestVisible="False" />
                <TextBlock Text="{Binding [RalvenAi.Title], Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource BodyStrongText}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRalvenAiAccess}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer x:Name="ConversationScrollViewer"
                          Padding="0,8,0,20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820" HorizontalAlignment="Center">
                    <ItemsControl x:Name="ConversationItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MaxWidth="760" Margin="0,0,0,18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="0,3,80,3" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Padding" Value="16,12" />
                                                    <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource RalvenAiLogoImage}"
                                                   Width="20"
                                                   Height="20"
                                                   Stretch="Uniform"
                                                   Focusable="False"
                                                   IsHitTestVisible="False"
                                                   Margin="0,0,8,0">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Author}"
                                                       Style="{StaticResource OverlineText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="RecommendationPanel"
                            Visibility="Collapsed"
                            Style="{StaticResource FieldSurface}"
                            Margin="0,0,0,18"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding [RalvenAi.Recommendation.Title], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource OverlineText}" />
                            <TextBlock x:Name="RecommendationProfileText"
                                       Style="{StaticResource SectionText}"
                                       FontFamily="{StaticResource RalvenAiFont}"
                                       Margin="0,7,0,0" />
                            <Button Content="{Binding [RalvenAi.ReviewPlan], Source={StaticResource LocalizedStrings}}"
                                    Style="{StaticResource RalvenAiPrimaryButtonStyle}"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Click="ReviewPlan_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="720"
                        Margin="0,0,0,42">
                <controls:AnimatedRalvenLogo
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />
                <TextBlock x:Name="WelcomeText"
                           Style="{StaticResource DisplayText}"
                           FontFamily="{StaticResource RalvenAiFont}"
                           TextAlignment="Center" />
                <TextBlock Text="{Binding [RalvenAi.Empty.Detail], Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0" ItemWidth="220" ItemHeight="Auto">
                    <Button Style="{StaticResource PromptSuggestionButtonStyle}"
                            Margin="4"
                            Tag="RalvenAi.Suggestion.Bottleneck"
                            Click="Suggestion_Click"
                            AutomationProperties.Name="{Binding [RalvenAi.Suggestion.Bottleneck], Source={StaticResource LocalizedStrings}}">
                        <TextBlock Text="{Binding [RalvenAi.Suggestion.Bottleneck], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" />
                    </Button>
                    <Button Style="{StaticResource PromptSuggestionButtonStyle}"
                            Margin="4"
                            Tag="RalvenAi.Suggestion.Profiles"
                            Click="Suggestion_Click"
                            AutomationProperties.Name="{Binding [RalvenAi.Suggestion.Profiles], Source={StaticResource LocalizedStrings}}">
                        <TextBlock Text="{Binding [RalvenAi.Suggestion.Profiles], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" />
                    </Button>
                    <Button Style="{StaticResource PromptSuggestionButtonStyle}"
                            Margin="4"
                            Tag="RalvenAi.Suggestion.Start"
                            Click="Suggestion_Click"
                            AutomationProperties.Name="{Binding [RalvenAi.Suggestion.Start], Source={StaticResource LocalizedStrings}}">
                        <TextBlock Text="{Binding [RalvenAi.Suggestion.Start], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Width="820"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRalvenAiAccess}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border x:Name="MessageComposer"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="16,12,10,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox x:Name="MessageTextBox"
                                 Style="{StaticResource ChatComposerTextBoxStyle}"
                                 MinHeight="26"
                                 MaxHeight="112"
                                 MaxLength="1000"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 KeyDown="MessageTextBox_KeyDown"
                                 ToolTip="{Binding [RalvenAi.InputPlaceholder], Source={StaticResource LocalizedStrings}}"
                                 AutomationProperties.Name="{Binding [RalvenAi.InputPlaceholder], Source={StaticResource LocalizedStrings}}" />
                        <TextBlock Text="{Binding [RalvenAi.InputPlaceholder], Source={StaticResource LocalizedStrings}}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MessageTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="{Binding [RalvenAi.Send], Source={StaticResource LocalizedStrings}}"
                            Style="{StaticResource RalvenAiPrimaryButtonStyle}"
                            MinWidth="92"
                            Click="Send_Click" />
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource CaptionText}"
                       Margin="4,7,4,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding [RalvenAi.Privacy.Detail], Source={StaticResource LocalizedStrings}}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="820"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRalvenAiAccess}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="1"
                Grid.RowSpan="3"
                Padding="28">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PanelSurface}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRalvenAiAccess}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{DynamicResource RalvenAiLogoImage}"
                       Width="68"
                       Height="68"
                       Stretch="Uniform"
                       Focusable="False"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFreePlan}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding [RalvenAi.AccessRequired.Title], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource SectionText}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding [RalvenAi.AccessRequired.Detail], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFreePlan}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource ProAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXs}"
                            Padding="10,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding [RalvenAi.AccessRequired.Free.Plan], Source={StaticResource LocalizedStrings}}"
                                   Style="{StaticResource OverlineText}"
                                   Foreground="{DynamicResource ProAccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding [RalvenAi.AccessRequired.Free.Title], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource SectionText}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding [RalvenAi.AccessRequired.Free.Detail], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding [RalvenAi.AccessRequired.Free.Safety], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>

                <Button Content="{Binding [RalvenAi.AccessRequired.ViewPro], Source={StaticResource LocalizedStrings}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,22,0,0"
                        Click="ViewPro_Click"
                        AutomationProperties.Name="{Binding [RalvenAi.AccessRequired.ViewPro], Source={StaticResource LocalizedStrings}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
