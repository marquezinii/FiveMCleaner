<UserControl x:Class="Ralven.App.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Ralven.App.Controls"
             xmlns:viewModels="clr-namespace:Ralven.App.ViewModels"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <UserControl.Resources>
        <DataTemplate x:Key="StreamingRowTemplate">
            <Border Style="{StaticResource LedgerRowStyle}" Padding="0,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon16}" Data="{Binding IconKey, Converter={StaticResource GeometryKeyConverter}}"
                          Stroke="{Binding ToneBrushKey, Converter={StaticResource BrushKeyConverter}}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="LiveMetricOptionStyle" TargetType="RadioButton" BasedOn="{StaticResource SegmentedOptionStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Cabeçalho ===================== -->
        <!-- Direto sobre o plano da interface: sem faixa, borda ou moldura. -->
        <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Dashboard.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Grid.Column="1" Text="{Binding GreetingTitle}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,0,4" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CaptionText, não TickLabel: "Última varredura às
                         21:48" é uma frase, e mono numa frase quebra o ritmo
                         da linha sem medir nada. -->
                    <TextBlock Text="{Binding LastScanLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastScanLabel}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="8,0" Click="RefreshDiagnostic_Click" IsEnabled="{Binding CanRefresh}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding [Dashboard.Refresh], Source={StaticResource LocalizedStrings}}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Slot de alerta condicional: só existe quando há algo real a dizer. -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" Margin="0,0,0,18" Effect="{DynamicResource Elevation1Shadow}" Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="4" Background="{Binding UpdateBannerToneBrushKey, Converter={StaticResource BrushKeyConverter}}" CornerRadius="{StaticResource RadiusXs}" />
                <Border Width="40" Height="40" Margin="20,16,0,16" Background="{DynamicResource Surface2Brush}" CornerRadius="{StaticResource RadiusMd}" VerticalAlignment="Top">
                    <Path Style="{StaticResource Icon20}" Data="{Binding UpdateBannerIconKey, Converter={StaticResource GeometryKeyConverter}}" Stroke="{Binding UpdateBannerToneBrushKey, Converter={StaticResource BrushKeyConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,16,24,16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UpdateBannerDetail}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <ProgressBar Height="4" Margin="0,10,0,0" Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                                 Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,16,52,16" Visibility="{Binding IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="{Binding UpdateActionLabel}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="156" Height="40" Padding="16,0"
                            IsEnabled="{Binding CanDownloadUpdate}" Click="DownloadUpdate_Click" />
                    <Button Content="{Binding UpdateReleaseNotesLabel}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Center" Margin="0,7,0,0"
                            IsEnabled="{Binding CanOpenReleaseNotes}" Click="OpenReleaseNotes_Click" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" Margin="0,10,12,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                        ToolTip="{Binding [Update.Dismiss], Source={StaticResource LocalizedStrings}}"
                        AutomationProperties.Name="{Binding [Update.Dismiss], Source={StaticResource LocalizedStrings}}"
                        Click="DismissUpdate_Click">
                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ===================== Corpo ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="308" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" MinHeight="240" />
                </Grid.RowDefinitions>

                <!-- ============ Painel de diagnóstico ============ -->
                <Border Grid.Row="0"
                        Style="{StaticResource HeroSurface}"
                        Padding="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXl}"
                        Effect="{DynamicResource Elevation1Shadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="28,26,28,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- A linha de luz: marca de onde a leitura começa. -->
                            <Rectangle Style="{StaticResource HeroAccentRule}" />

                            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecommendationTitle}" Style="{StaticResource DisplayText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="660" HorizontalAlignment="Left" />

                                <WrapPanel Margin="0,24,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,8" Click="OpenOptimizer_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconBolt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding [Dashboard.OpenOptimizer], Source={StaticResource LocalizedStrings}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="OpenHistory_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Escala de prontidão: leitura tabular grande +
                                 régua graduada. A explicação da nota vive aqui,
                                 como tooltip da própria escala, e em nenhum
                                 outro lugar da página. -->
                            <!--
                                A explicação vive como TEXTO VISÍVEL
                                (CaptionText abaixo), não só como ToolTip: um
                                StackPanel sem foco não expõe hover a teclado,
                                toque ou leitor de tela, e o WPF não abre
                                ToolTip por foco de teclado como o WinUI abre.
                                O ToolTip continua aqui só como atalho extra
                                para quem usa mouse.
                            -->
                            <StackPanel Grid.Column="2" Width="220" Margin="18,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ReadinessScoreExplanation}">
                                <TextBlock Text="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <!-- Mantém espaço para 100, mas ancora números menores junto ao sufixo. -->
                                    <TextBlock Width="100" TextAlignment="Right" Text="{Binding ReadinessScore, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" FontSize="52" FontWeight="SemiBold" LineHeight="58" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="/100" Style="{StaticResource TickLabelText}" VerticalAlignment="Bottom" Margin="4,0,0,11" />
                                </StackPanel>
                                <TextBlock Text="{Binding ReadinessLevelLabel}" Style="{StaticResource BodyStrongText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,14" />
                                <ProgressBar Style="{StaticResource ProgressRailStyle}" Height="8" Value="{Binding ReadinessScore, Mode=OneWay}"
                                             AutomationProperties.Name="{Binding [Dashboard.Readiness], Source={StaticResource LocalizedStrings}}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="0" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="1" Text="25" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="2" Text="50" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="3" Text="75" Style="{StaticResource TickLabelText}" />
                                    <TextBlock Grid.Column="4" Text="100" Style="{StaticResource TickLabelText}" />
                                </Grid>
                                <TextBlock Text="{Binding ReadinessScoreExplanation}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Faixa de instrumentos: os três fatos da varredura
                             que sustentam a recomendação acima. Fica DENTRO do
                             mesmo painel e usa respiro, não divisórias nem um
                             segundo cartão. -->
                        <Border Grid.Row="1" Padding="28,0,28,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,18,24,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Pressure.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PerformancePressureLabel}" Style="{StaticResource MetricSmallText}" Margin="0,6,0,0"
                                               Foreground="{Binding PerformancePressureBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Cores.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LogicalProcessorLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LogicalProcessorDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="24,18,0,18" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Dashboard.Kpi.Memory.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AvailableMemoryLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding AvailableMemoryDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ Desempenho ao vivo ============ -->
                <!-- A seção aberta evita outra moldura grande e mantém o
                     gráfico em uma altura útil, sem criar um poço vazio. -->
                <Border Grid.Row="2" Background="Transparent">
                    <Grid Margin="4,8,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{Binding [Dashboard.LivePerformance.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding LiveMetricsTargetDescription}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource SegmentedHostStyle}" Margin="0,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="LiveMetricsTarget"
                                                 Style="{StaticResource SegmentedOptionStyle}"
                                                 Content="{Binding [Dashboard.LivePerformance.Target.System], Source={StaticResource LocalizedStrings}}"
                                                 IsChecked="{Binding IsSystemLiveMetricsTarget, Mode=OneWay}"
                                                 Tag="{x:Static viewModels:LiveMetricsTarget.System}"
                                                 Checked="LiveMetricsTarget_Checked" />
                                    <RadioButton GroupName="LiveMetricsTarget"
                                                 Style="{StaticResource SegmentedOptionStyle}"
                                                 Content="{Binding [Dashboard.LivePerformance.Target.FiveM], Source={StaticResource LocalizedStrings}}"
                                                 IsChecked="{Binding IsFiveMLiveMetricsTarget, Mode=OneWay}"
                                                 IsEnabled="{Binding IsFiveMLiveMetricsTargetAvailable}"
                                                 ToolTip="{Binding [Dashboard.LivePerformance.Target.FiveMHelp], Source={StaticResource LocalizedStrings}}"
                                                 ToolTipService.ShowOnDisabled="True"
                                                 Tag="{x:Static viewModels:LiveMetricsTarget.FiveM}"
                                                 Checked="LiveMetricsTarget_Checked" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="10,4" VerticalAlignment="Center" ToolTip="{Binding LiveMetricsUpdatedExactLabel}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TagChipStyle}">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLivePerformancePaused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LiveDot" Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                 <Setter Property="Fill" Value="{DynamicResource SuccessBaseBrush}" />
                                                 <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLivePerformancePaused}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource DangerBaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource OverlineText}">
                                                 <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Live], Source={StaticResource LocalizedStrings}}" />
                                                 <Setter Property="Foreground" Value="{DynamicResource SuccessBaseBrush}" />
                                                 <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLivePerformancePaused}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Paused], Source={StaticResource LocalizedStrings}}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceWaiting}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLivePerformanceUnavailable}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Dashboard.LivePerformance.Unavailable], Source={StaticResource LocalizedStrings}}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBaseBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Cada leitura é um seletor nativo: mouse, Tab, setas e leitor de tela. -->
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="LiveMetric" Style="{StaticResource LiveMetricOptionStyle}"
                                         IsChecked="{Binding IsCpuLiveMetricSelected, Mode=OneWay}"
                                         Tag="{x:Static viewModels:LiveMetricKind.Cpu}" Checked="LiveMetric_Checked"
                                         AutomationProperties.HelpText="{Binding CpuTrendLabel}">
                                <Grid MinHeight="86">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Cpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Grid.Row="1" Text="{Binding CpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                    <controls:LivePerformanceChart Grid.Row="2" Height="26" Margin="0,5,0,4" Capacity="60" CpuValues="{Binding CpuUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}" MaximumValue="100" ShowGrid="False" ShowArea="False" ShowTooltip="False"
                                                                   Focusable="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Row="3" Text="{Binding CpuTrendLabel}" Style="{StaticResource TickLabelText}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Grid.Column="1" GroupName="LiveMetric" Style="{StaticResource LiveMetricOptionStyle}"
                                         IsChecked="{Binding IsGpuLiveMetricSelected, Mode=OneWay}" IsEnabled="{Binding IsGpuLiveMetricAvailable}"
                                         Tag="{x:Static viewModels:LiveMetricKind.Gpu}" Checked="LiveMetric_Checked"
                                         AutomationProperties.HelpText="{Binding GpuTrendLabel}">
                                <Grid MinHeight="86">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Gpu], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Grid.Row="1" Text="{Binding GpuUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                    <controls:LivePerformanceChart Grid.Row="2" Height="26" Margin="0,5,0,4" Capacity="60" CpuValues="{Binding GpuUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}" MaximumValue="100" ShowGrid="False" ShowArea="False" ShowTooltip="False"
                                                                   Focusable="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Row="3" Text="{Binding GpuTrendLabel}" Style="{StaticResource TickLabelText}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Grid.Column="2" GroupName="LiveMetric" Style="{StaticResource LiveMetricOptionStyle}"
                                         IsChecked="{Binding IsMemoryLiveMetricSelected, Mode=OneWay}"
                                         Tag="{x:Static viewModels:LiveMetricKind.Memory}" Checked="LiveMetric_Checked"
                                         ToolTip="{Binding MemoryUsageDetailLabel}" AutomationProperties.HelpText="{Binding MemoryUsageDetailLabel}">
                                <Grid MinHeight="86">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Grid.Row="1" Text="{Binding MemoryUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                    <controls:LivePerformanceChart Grid.Row="2" Height="26" Margin="0,5,0,4" Capacity="60" CpuValues="{Binding MemoryUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}" MaximumValue="{Binding MemoryChartMaximum}" ShowGrid="False" ShowArea="False" ShowTooltip="False"
                                                                   Focusable="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Row="3" Text="{Binding MemoryTrendLabel}" Style="{StaticResource TickLabelText}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Grid.Column="3" GroupName="LiveMetric" Style="{StaticResource LiveMetricOptionStyle}"
                                         IsChecked="{Binding IsDiskLiveMetricSelected, Mode=OneWay}" IsEnabled="{Binding IsDiskLiveMetricAvailable}"
                                         Tag="{x:Static viewModels:LiveMetricKind.Disk}" Checked="LiveMetric_Checked"
                                         AutomationProperties.HelpText="{Binding DiskTrendLabel}">
                                <Grid MinHeight="86">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Disk], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Grid.Row="1" Text="{Binding DiskUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                    <controls:LivePerformanceChart Grid.Row="2" Height="26" Margin="0,5,0,4" Capacity="60" CpuValues="{Binding DiskUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}" MaximumValue="100" ShowGrid="False" ShowArea="False" ShowTooltip="False"
                                                                   Focusable="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Row="3" Text="{Binding DiskTrendLabel}" Style="{StaticResource TickLabelText}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton Grid.Column="4" GroupName="LiveMetric" Style="{StaticResource LiveMetricOptionStyle}" Margin="0"
                                         IsChecked="{Binding IsNetworkLiveMetricSelected, Mode=OneWay}" IsEnabled="{Binding IsNetworkLiveMetricAvailable}"
                                         Tag="{x:Static viewModels:LiveMetricKind.Network}" Checked="LiveMetric_Checked"
                                         AutomationProperties.HelpText="{Binding NetworkTrendLabel}">
                                <Grid MinHeight="86">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Network], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Grid.Row="1" Text="{Binding NetworkUsageLabel}" Style="{StaticResource ReadoutSmallText}" Margin="0,4,0,0" />
                                    <controls:LivePerformanceChart Grid.Row="2" Height="26" Margin="0,5,0,4" Capacity="60" CpuValues="{Binding NetworkUsageSeries}"
                                                                   CpuBrush="{DynamicResource AccentBrush}" MaximumValue="{Binding NetworkChartMaximum}" ShowGrid="False" ShowArea="False" ShowTooltip="False"
                                                                   Focusable="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Row="3" Text="{Binding NetworkTrendLabel}" Style="{StaticResource TickLabelText}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                        </Grid>

                        <Border Grid.Row="2" Height="270" Style="{StaticResource InsetSurface}" Margin="0,18,0,0" ClipToBounds="True">
                            <Grid>
                                <Rectangle Fill="{DynamicResource SheetGridBrush}" />
                                <Grid Margin="16,12,16,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedLiveMetricName}" Style="{StaticResource BodyStrongText}" />
                                            <TextBlock Text="{Binding [Dashboard.LivePerformance.Window], Source={StaticResource LocalizedStrings}}" Style="{StaticResource TickLabelText}" Margin="10,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LiveMetricsUpdatedLabel}" ToolTip="{Binding LiveMetricsUpdatedExactLabel}"
                                                   Style="{StaticResource TickLabelText}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <controls:LivePerformanceChart Capacity="60"
                                                                       SampleIntervalSeconds="1"
                                                                       CpuValues="{Binding SelectedLiveMetricSeries}"
                                                                       CpuBrush="{DynamicResource AccentBrush}"
                                                                       MaximumValue="{Binding SelectedLiveMetricMaximum}"
                                                                       ValueFormat="{Binding SelectedLiveMetricValueFormat}"
                                                                       ValueSuffix="{Binding SelectedLiveMetricValueSuffix}"
                                                                       GridBrush="{DynamicResource BorderSubtleBrush}"
                                                                       LabelBrush="{DynamicResource TextTertiaryBrush}"
                                                                       TooltipBackground="{DynamicResource Surface3Brush}"
                                                                       TooltipBorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                       CpuLabel="{Binding SelectedLiveMetricName}"
                                                                       WindowLabel="{Binding [Dashboard.LivePerformance.Ago60Seconds], Source={StaticResource LocalizedStrings}}"
                                                                       NowLabel="{Binding [Dashboard.LivePerformance.Now], Source={StaticResource LocalizedStrings}}"
                                                                       Visibility="{Binding HasSelectedLiveMetricSamples, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       AutomationProperties.Name="{Binding SelectedLiveMetricAutomationLabel}"
                                                                       AutomationProperties.HelpText="{Binding LiveMetricsTargetDescription}" />

                                        <TextBlock Text="{Binding SelectedLiveMetricEmptyLabel}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasLiveMetricsSample}" Value="True" />
                                                                <Condition Binding="{Binding HasSelectedLiveMetricSamples}" Value="False" />
                                                                <Condition Binding="{Binding IsLivePerformanceUnavailable}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding [Dashboard.LivePerformance.Waiting], Source={StaticResource LocalizedStrings}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLivePerformanceWaiting}" Value="True" />
                                                                <Condition Binding="{Binding HasLiveMetricsSample}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding [Dashboard.LivePerformance.Unavailable], Source={StaticResource LocalizedStrings}}"
                                                   Style="{StaticResource SecondaryText}" Foreground="{DynamicResource DangerBaseBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsLivePerformanceUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   automation:AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedLiveMetricStatusLabel}"
                                       Foreground="{Binding SelectedLiveMetricStatusBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,24,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel MinWidth="74">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Current], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding SelectedLiveMetricCurrentLabel}" Style="{StaticResource TickLabelText}" Margin="0,3,0,0" FontFamily="{StaticResource AppFontMono}" />
                                </StackPanel>
                                <StackPanel MinWidth="74" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Average], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding SelectedLiveMetricAverageLabel}" Style="{StaticResource TickLabelText}" Margin="0,3,0,0" FontFamily="{StaticResource AppFontMono}" />
                                </StackPanel>
                                <StackPanel MinWidth="74" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding [Dashboard.LivePerformance.Peak], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                                    <TextBlock Text="{Binding SelectedLiveMetricPeakLabel}" Style="{StaticResource TickLabelText}" Margin="0,3,0,0" FontFamily="{StaticResource AppFontMono}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Painel de notas ============ -->
            <Border Grid.Column="2" Style="{StaticResource NotesColumnSurface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding [Dashboard.SystemOverview], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Dashboard.Processor], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" ToolTip="{Binding CpuName}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Dashboard.GraphicsCard], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuDetail}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" ToolTip="{Binding GpuDetail}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Dashboard.Memory], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Dashboard.Storage], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiskLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Dashboard.Windows], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Margin="0,2,14,0" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WindowsLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" ToolTip="{Binding WindowsLabel}" />
                        </Grid>

                        <Border Style="{StaticResource HairlineDivider}" Margin="0,22" />

                        <!-- Última otimização registrada. -->
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Dashboard.LastRun.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding LastOptimizationDateLabel}" Style="{StaticResource TickLabelText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding LastOptimizationDateLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Text="{Binding LastOptimizationTitle}" Style="{StaticResource BodyStrongText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastOptimizationSummary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="-6,10,0,0"
                                    Visibility="{Binding HasLastOptimization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OpenHistory_Click"
                                    Content="{Binding [Dashboard.OpenHistory], Source={StaticResource LocalizedStrings}}" />
                        </StackPanel>

                        <Border Style="{StaticResource HairlineDivider}" Margin="0,22" />

                        <!-- Espaço seguro para criadores. -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconStream}" Stroke="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StreamingReadinessTitle}" Style="{StaticResource SubsectionText}" Margin="11,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StreamingReadinessDetail}" Style="{StaticResource CaptionText}" Margin="0,6,0,2" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding StreamingReadinessItems}" ItemTemplate="{StaticResource StreamingRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
