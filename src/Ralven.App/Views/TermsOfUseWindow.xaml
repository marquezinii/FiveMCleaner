<controls:DialogWindow x:Class="Ralven.App.Views.TermsOfUseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Ralven.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding [Terms.WindowTitle], Source={StaticResource LocalizedStrings}}"
    Icon="/Ralven;component/Assets/Ralven.png"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    FontFamily="{StaticResource AppFontBody}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Background="{DynamicResource Surface1Brush}"
        Width="820" Height="800" MinWidth="460" MinHeight="360" ResizeMode="CanResize">

    <Grid Margin="32,8,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{Binding [Terms.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DisplayText}" FontSize="27" />
            <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0" CornerRadius="{StaticResource RadiusXl}" Padding="4">
            <FlowDocumentScrollViewer VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Zoom="100">
                <FlowDocument TextAlignment="Left" PagePadding="0,8,16,8" FontFamily="{StaticResource AppFontBody}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22">
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Intro], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section1.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Service.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section2.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Section2.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section3.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Section3.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section4.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,8"><Run Text="{Binding [Terms.Section4.AccountData], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,8"><Run Text="{Binding [Terms.Section4.Infrastructure], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Privacy.Contact], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section5.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.PermittedUse.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section6.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Section6.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section7.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Section7.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section8.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Warranty.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section9.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Section9.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section10.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,14"><Run Text="{Binding [Terms.Section10.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>

                    <Paragraph FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6"><Run Text="{Binding [Terms.Section11.Title], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                    <Paragraph Margin="0,0,0,0"><Run Text="{Binding [Terms.LawContact.Body], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /></Paragraph>
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="{Binding [Terms.Close], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="28,0" Margin="0,18,0,0" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </Grid>
</controls:DialogWindow>
