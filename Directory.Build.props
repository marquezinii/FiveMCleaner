<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <FiveMCleanerTargetFramework>net10.0</FiveMCleanerTargetFramework>
    <FiveMCleanerWindowsTargetFramework>net10.0-windows10.0.19041.0</FiveMCleanerWindowsTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Felipe Marquezini</Authors>
    <Company>Felipe Marquezini</Company>
    <Copyright>Copyright (c) 2026 Felipe Marquezini. All rights reserved.</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/marquezinii/FiveMCleaner</RepositoryUrl>
    <Product>FiveMCleaner</Product>
    <Version>1.4.1</Version>
  </PropertyGroup>
</Project>
