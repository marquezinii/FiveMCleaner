<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FiveMCleanerWindowsTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Testhost precisa carregar PresentationCore para validar o sanitizador WPF. -->
    <NoWarn>$(NoWarn);NETSDK1086</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveMCleaner.UpdateRuntime\FiveMCleaner.UpdateRuntime.csproj" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="coverlet.MTP">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FiveMCleaner.App/FiveMCleaner.App.csproj" />
    <ProjectReference Include="../../src/FiveMCleaner.Contracts/FiveMCleaner.Contracts.csproj" />
    <ProjectReference Include="../../src/FiveMCleaner.Core/FiveMCleaner.Core.csproj" />
    <ProjectReference Include="../../src/FiveMCleaner.Windows/FiveMCleaner.Windows.csproj" />
    <ProjectReference Include="../../src/FiveMCleaner.Updater/FiveMCleaner.Updater.csproj" />
  </ItemGroup>
</Project>
